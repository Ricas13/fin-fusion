# Steam Fusion Environment Variables
# Copy this file to .env and replace every placeholder before production use.

# Runtime
NODE_ENV=production
PORT=3030

# Jellyfin Server
JELLYFIN_URL=http://your-jellyfin-server:8096
JELLYFIN_API_KEY=replace-with-your-jellyfin-api-key

# Session security
# Generate at least 32 random characters, for example:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=steamfusion.sid

# Set true when the application is served over HTTPS (recommended/required in production).
COOKIE_SECURE=true

# Initial admin bootstrap
# These are used only when no secure admin exists, or to replace the legacy admin/admin123 account.
ADMIN_USERNAME=replace-with-your-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters

# Telegram Bot (optional)
# Telegram document backups are redacted by secure-start.js before being sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
