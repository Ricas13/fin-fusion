# Steam Fusion / CAPTAiNFiN Environment Variables
# Copy this file to .env and replace every placeholder before production use.

# Runtime
NODE_ENV=production
PORT=3030
SITE_NAME=CAPTAiNFiN
PUBLIC_REGISTRATION=true
# Leave false until an email delivery provider is configured in the notifications phase.
REQUIRE_EMAIL_VERIFICATION=false
ENTITLEMENT_JOB_INTERVAL_MS=300000
SERVER_HEALTH_INTERVAL_MS=120000

# PostgreSQL
DATABASE_URL=postgres://steamfusion:replace-me@postgres:5432/steamfusion
DB_POOL_SIZE=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Encryption key used for Jellyfin API keys, network endpoint activity data,
# TOTP secrets and other sensitive provider secrets.
# 32 bytes, e.g. `openssl rand -hex 32`.
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters

# Legacy Jellyfin values are used only for compatibility / first migration.
JELLYFIN_URL=http://your-jellyfin-server:8096
JELLYFIN_PUBLIC_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=replace-with-your-jellyfin-api-key
LEGACY_SERVER_NAME=Primary Jellyfin
LEGACY_SERVER_SLUG=primary
LEGACY_SERVER_CLASS=premium

# Playback activity and concurrent-stream policy.
# SECURITY: observe is the default. Keep it there until you have reviewed real activity.
STREAM_POLICY_MODE=observe
STREAM_POLICY_POLL_SECONDS=30
STREAM_POLICY_ACTIVE_WINDOW_SECONDS=120
STREAM_POLICY_GRACE_SECONDS=45
# Minimum accepted by the code is 2, so one anomalous poll cannot trigger an action.
STREAM_POLICY_CONFIRMATIONS=2
# Paused playbacks are recorded but are not counted toward the limit by default.
STREAM_POLICY_COUNT_PAUSED=false
# Required in addition to STREAM_POLICY_MODE=enforce. Leave blank during observation/shadow testing.
STREAM_POLICY_ENFORCEMENT_ACK=
ACTIVITY_RETENTION_DAYS=90
POLICY_EVENT_RETENTION_DAYS=365

# Session security
# Generate at least 32 random characters, for example:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=steamfusion.sid
COOKIE_SECURE=true

# Initial admin bootstrap
ADMIN_USERNAME=replace-with-your-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters

# Stripe
# Prefer a restricted key (rk_) scoped to the required Billing/Checkout resources.
STRIPE_RESTRICTED_KEY=
# STRIPE_API_KEY is supported as a fallback for development/migration only.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_URL=
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
