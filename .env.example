# CAPTAiNFiN / Steam Fusion example configuration
NODE_ENV=production
PORT=3030
SITE_NAME=CAPTaINFiN
PUBLIC_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false
ENTITLEMENT_JOB_INTERVAL_MS=300000
SERVER_HEALTH_INTERVAL_MS=300000

DATABASE_URL=postgres://steamfusion:change-me@postgres:5432/steamfusion
DB_POOL_SIZE=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Activity worker uses a different PostgreSQL login.
ACTIVITY_DB_PASSWORD=change-me-too
ACTIVITY_DATABASE_URL=postgres://steamfusion_activity:change-me-too@postgres:5432/steamfusion
ACTIVITY_DB_POOL_SIZE=3

# Generate these independently. Never reuse one key for another purpose.
DATA_ENCRYPTION_KEY=
JELLYFIN_ENCRYPTION_KEY=
ACTIVITY_ENCRYPTION_KEY=
AUTH_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=/backups
# Optional restore staging path. Prefer a tmpfs/encrypted filesystem for restore operations.
BACKUP_RESTORE_TMPDIR=/tmp
ALLOW_LEGACY_DATA_KEY_FOR_JELLYFIN=false

# Staff authentication policy.
REQUIRE_ADMIN_2FA=true
REQUIRE_RESELLER_2FA=false
AUTH_FAILURE_LIMIT=5
AUTH_LOCK_MINUTES=15
STAFF_SESSION_HOURS=12
# Independent approval required when an administrator enrolls TOTP for the first time.
# Generate a separate random value (minimum 32 characters), e.g. `openssl rand -hex 32`.
# Do not reuse SESSION_SECRET or AUTH_ENCRYPTION_KEY.
ADMIN_2FA_ENROLLMENT_TOKEN=

JELLYFIN_URL=http://your-jellyfin-server:8096
JELLYFIN_PUBLIC_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=
LEGACY_SERVER_NAME=Primary Jellyfin
LEGACY_SERVER_SLUG=primary
LEGACY_SERVER_CLASS=premium

STREAM_POLICY_MODE=observe
STREAM_POLICY_POLL_SECONDS=30
STREAM_POLICY_ACTIVE_WINDOW_SECONDS=120
STREAM_POLICY_GRACE_SECONDS=45
STREAM_POLICY_CONFIRMATIONS=2
STREAM_POLICY_COUNT_PAUSED=false
STREAM_POLICY_ENFORCEMENT_ACK=
ACTIVITY_RETENTION_DAYS=90
POLICY_EVENT_RETENTION_DAYS=365

SESSION_SECRET=
SESSION_COOKIE_NAME=steamfusion.sid
COOKIE_SECURE=true
# These remain the secure legacy bootstrap values until all old admin data paths are removed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

STRIPE_RESTRICTED_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_URL=
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
