# CAPTAiNFiN / Steam Fusion example configuration
# Recommended fresh install: run `bash install.sh`. It creates .env from this
# template with independent high-entropy secrets and never overwrites an
# existing .env. If configuring manually, replace the owner placeholders below
# before deployment; the production preflight rejects example credentials.
NODE_ENV=production
PORT=3030
# Trust only reverse proxies on these networks when interpreting X-Forwarded-*.
# The default is suitable for local/Docker Traefik deployments. Use explicit
# addresses/CIDRs for non-private proxies; blanket true/hop counts are rejected.
TRUST_PROXY=loopback, linklocal, uniquelocal
# Optional compatibility fallback. A fresh install can set its site name in /setup.
SITE_NAME=
# Admin-only update checks compare the embedded build commit with public GitHub main.
# Set false to keep version/build visibility while making no outbound update checks.
CAPTAINFIN_UPDATE_CHECK_ENABLED=true

# Customer-facing features are disabled on a genuinely fresh database and can
# be enabled from Administration -> Settings. These env values remain optional
# compatibility fallbacks for older deployments.
STOREFRONT_ENABLED=false
PUBLIC_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
ENTITLEMENT_JOB_INTERVAL_MS=300000
SERVER_HEALTH_INTERVAL_MS=300000
# Maximum customer reconciliations running concurrently in the web process.
# Each active reconcile may hold a dedicated PostgreSQL advisory-lock connection
# while external services converge. The cross-process advisory lock remains the
# correctness lock; this value is web-process capacity/backpressure only.
RECONCILIATION_MAX_CONCURRENCY=4
# Stremio runtime enable/disable is browser-managed under Servers -> Stremio Sources.
# This flag is retained only so an older deployment that already had it enabled
# does not switch off before the browser-managed setting is saved.
STREMIO_RUNTIME_ENABLED=false
# Legacy managed-Jellyfin Stremio delivery only: dedicated purpose key for the
# hidden per-customer Jellyfin access token (32 bytes / 64 hex chars or base64).
# Normal external Stremio Sources use the existing JELLYFIN_ENCRYPTION_KEY below
# and do not require this Stremio-specific key.
STREMIO_JELLYFIN_TOKEN_KEY=
# Optional raw-media replay protection. Enable only after the Jellyfin Traefik
# router is configured as documented in docs/STREMIO_EDGE_AUTH.md. When enabled,
# raw Stremio URLs carry an opaque network-bound grant instead of api_key.
STREMIO_EDGE_AUTH_ENABLED=false
STREMIO_EDGE_AUTH_SECRET=
# 30 minutes minimum, 12 hours maximum; six hours protects long/range playback.
STREMIO_EDGE_GRANT_TTL_SECONDS=21600

# PostgreSQL owner credential. Only the one-shot migrate service and explicit
# recovery-tools profile receive this URL. Long-running services must use the
# dedicated logins below. `bash install.sh` replaces both values automatically.
POSTGRES_PASSWORD=replace-with-unique-owner-secret
DATABASE_URL=postgres://steamfusion:replace-with-unique-owner-secret@postgres:5432/steamfusion
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Long-running runtime identities. Leave these blank on a new Compose install;
# scripts/deploy-production.sh creates independent >=24-character passwords for
# each role and saves a protected copy of the previous .env before mutation.
APP_DATABASE_URL=
APP_DB_POOL_SIZE=10
AUTOMATION_DATABASE_URL=
AUTOMATION_DB_POOL_SIZE=6
ACTIVITY_DATABASE_URL=
ACTIVITY_DB_POOL_SIZE=3
BACKUP_DATABASE_URL=
BACKUP_DB_POOL_SIZE=3
# Separate CREATEDB-only identity for temporary restore verification. It is not
# granted production schema/table access.
BACKUP_VERIFY_DATABASE_URL=
# Backwards-compatible input for older deployment scripts. New installs can
# leave this empty because ACTIVITY_DATABASE_URL supplies the role password.
ACTIVITY_DB_PASSWORD=

# Generate these independently. Never reuse one key for another purpose.
# `bash install.sh` fills every required key on a fresh installation.
DATA_ENCRYPTION_KEY=
JELLYFIN_ENCRYPTION_KEY=
ACTIVITY_ENCRYPTION_KEY=
AUTH_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=/backups
# Bind-mounted backups must be written as the host account that owns ./backups.
# The installer/deployment helpers fill these automatically when appropriate.
BACKUP_PUID=
BACKUP_PGID=
# Optional restore staging path. Prefer a tmpfs/encrypted filesystem for restore operations.
BACKUP_RESTORE_TMPDIR=/tmp

# Optional encrypted off-host copies. CAPTAiNFiN uploads only the completed
# authenticated .pgdump.enc file; plaintext database data is never sent.
# S3-compatible endpoints include AWS S3, Cloudflare R2, Backblaze B2 S3,
# MinIO and compatible providers. HTTPS is mandatory.
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_PROVIDER=s3
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Optional temporary-credential token. Leave blank for normal access keys.
BACKUP_S3_SESSION_TOKEN=
BACKUP_S3_PREFIX=captainfin/
# Path-style is the broadest S3-compatible default. Set false only when your
# provider explicitly requires virtual-hosted bucket addressing.
BACKUP_S3_FORCE_PATH_STYLE=true
# Bounded upload/list/download retries; accepted range 1-5.
BACKUP_S3_MAX_ATTEMPTS=3

ALLOW_LEGACY_DATA_KEY_FOR_JELLYFIN=false

# Staff authentication policy. Administrator 2FA can also be managed in the
# browser; this remains an unattended-install compatibility fallback.
REQUIRE_ADMIN_2FA=false
AUTH_FAILURE_LIMIT=5
AUTH_LOCK_MINUTES=15
STAFF_SESSION_HOURS=12
# Customer password creation/change/reset is checked against known breach data
# using the k-anonymous Pwned Passwords range API. Only a five-character SHA-1
# prefix leaves CAPTAiNFiN; the password and complete hash never do. `required`
# fails closed if the safety service is unavailable. `best_effort` is available
# for isolated deployments; `off` disables the breach check.
PASSWORD_BREACH_CHECK_MODE=required
PASSWORD_BREACH_CHECK_TIMEOUT_MS=5000
# Retained only for backwards compatibility; normal TOTP enrollment no longer requires it.
ADMIN_2FA_ENROLLMENT_TOKEN=

# Jellyfin servers are normally added from Administration -> Servers.
# These are optional legacy compatibility variables and are NOT required for a
# clean installation to start.
JELLYFIN_URL=
JELLYFIN_PUBLIC_URL=
JELLYFIN_API_KEY=
LEGACY_SERVER_NAME=
LEGACY_SERVER_SLUG=
LEGACY_SERVER_CLASS=

STREAM_POLICY_MODE=observe
# Playback polling remains the safety net. Compose uses 30s by default; 15s is the supported minimum.
STREAM_POLICY_POLL_SECONDS=30
# Worker liveness is independent of the playback poll cadence so long poll intervals do not make a healthy worker stale.
ACTIVITY_WORKER_HEARTBEAT_MS=15000
# A server sample is trusted for poll interval + this slack. 60s tolerates a slow cycle without coupling safety to scheduler jitter.
STREAM_POLICY_POLL_SLACK_SECONDS=60
STREAM_POLICY_ACTIVE_WINDOW_SECONDS=120
STREAM_POLICY_GRACE_SECONDS=45
STREAM_POLICY_CONFIRMATIONS=2
STREAM_POLICY_COUNT_PAUSED=false
STREAM_POLICY_ENFORCEMENT_ACK=
ACTIVITY_RETENTION_DAYS=90
POLICY_EVENT_RETENTION_DAYS=365
FLEET_METRICS_POLL_SECONDS=60
# Optional Jellyfin Webhook plugin ingest. Generate a long random shared secret and
# configure the same value as X-Fin-Fusion-Webhook-Secret on each Generic Destination.
JELLYFIN_WEBHOOK_SECRET=

SESSION_SECRET=
SESSION_COOKIE_NAME=steamfusion.sid
COOKIE_SECURE=true

# First administrator:
# - Recommended for interactive installs: leave BOTH variables empty. The app
#   redirects /login to /setup and `bash install.sh` prints a fresh one-time
#   claim code after the deployment succeeds.
# - Unattended installs: set BOTH ADMIN_USERNAME and ADMIN_PASSWORD and the
#   migration bootstrap creates the native administrator idempotently.
# If only one is supplied startup/migration bootstrap fails rather than guessing.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payment credentials are normally configured in Administration -> Commerce -> Payments.
# Browser-managed values are encrypted with DATA_ENCRYPTION_KEY and take precedence.
# The variables below remain optional compatibility/unattended-install fallbacks.
STRIPE_RESTRICTED_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PLISIO_ENABLED=true
PLISIO_SECRET_KEY=

# Implemented notification channels. SMTP is normally configured in the browser;
# SMTP_URL and Telegram remain compatibility/unattended-install fallbacks.
# SMTP credentials require STARTTLS/TLS. A URL with ?secure=plain is accepted
# only when it contains no username/password (for a trusted unauthenticated relay).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_URL=

# Optional central request-service user sync. Configure URL/API key in the
# browser for normal deployments; these remain compatibility fallbacks.
SEERR_URL=
OVERSEERR_URL=
SEERR_API_KEY=
OVERSEERR_API_KEY=
REQUEST_USER_SYNC_INTERVAL_MS=900000

# Dedicated automation worker poll loop. Individual job intervals/enabled state
# are browser-managed in Administration -> Automation. The PostgreSQL automation
# role is limited to 12 connections. Defaults reserve 6 primary-pool connections,
# 4 maintenance-lock connections, 1 reconciliation connection and 1 healthcheck
# connection. Unsafe combinations fail fast at worker startup.
AUTOMATION_WORKER_POLL_MS=15000
AUTOMATION_WORKER_CONCURRENCY=3
AUTOMATION_WORKER_HEARTBEAT_MS=15000
AUTOMATION_RECONCILIATION_MAX_CONCURRENCY=1
AUTOMATION_MAINTENANCE_LOCK_POOL_MAX=4

# Backup worker poll loop.
BACKUP_WORKER_POLL_MS=60000
