{
  "name": "steam-fusion",
  "version": "1.3.0",
  "description": "CAPTaINFiN: Jellyfin customer, reseller, subscription and fleet management platform",
  "main": "src/application.js",
  "scripts": {
    "start": "node src/application.js",
    "dev": "NODE_ENV=development node src/application.js",
    "db:migrate": "node scripts/migrate-db.js",
    "db:import-json": "node scripts/migrate-json-to-postgres.js",
    "db:activity-role": "node scripts/configure-activity-db-role.js",
    "db:backup": "node scripts/backup-db.js",
    "db:restore": "node scripts/restore-db.js",
    "db:backup-smoke": "node scripts/backup-crypto-smoke.js",
    "auth:bootstrap": "node scripts/bootstrap-admin.js",
    "auth:migrate-legacy": "node scripts/migrate-staff-auth.js",
    "auth:smoke": "node scripts/auth-smoke.js",
    "setup:claim": "node scripts/rotate-first-run-claim.js",
    "server:add": "node scripts/add-jellyfin-server.js",
    "payments:map": "node scripts/map-provider-price.js",
    "activity:worker": "node scripts/activity-worker.js",
    "automation:worker": "node scripts/automation-worker.js",
    "secrets:rotate-jellyfin": "node scripts/rotate-jellyfin-keys.js",
    "syntax": "node scripts/check-js-syntax.js",
    "check": "npm run syntax && node scripts/reschedule-timer-smoke.js && node scripts/policy-engine-smoke.js && node scripts/jellyfin-registry-smoke.js && node scripts/customer-filters-smoke.js && node scripts/server-form-validation-smoke.js && node scripts/server-status-timestamp-smoke.js && node scripts/server-placement-smoke.js && node scripts/invitations-smoke.js && node scripts/provisioning-control-smoke.js && npm run db:backup-smoke"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.16.3",
    "stripe": "22.5.0"
  }
}
