<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Recovery codes · <%= siteName %></title><link rel="stylesheet" href="/css/platform-shell.css"></head>
<body><main class="authShell"><section class="authCard"><div class="authBrand"><%= siteName %></div><h1 class="authTitle">Recovery codes</h1><div class="notice">These codes are shown once. Store them somewhere secure and separate from your password.</div><div class="recoveryGrid"><% recoveryCodes.forEach(function(code){ %><div class="recoveryCode"><%= code %></div><% }) %></div><div class="buttonRow"><a class="button" href="<%= continueUrl %>">Continue</a></div></section></main></body></html>
