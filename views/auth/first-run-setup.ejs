<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Create administrator · <%= siteName %></title>
  <link rel="stylesheet" href="/css/platform-shell.css">
  <style>.setupSteps{display:flex;gap:8px;margin:14px 0 22px;flex-wrap:wrap}.setupStep{font-size:12px;padding:6px 9px;border:1px solid #334155;border-radius:999px;color:#94a3b8}.setupStep.active{color:#fff;border-color:#64748b}.fieldError{color:#fca5a5;font-size:12px;margin-top:6px}.setupGrid{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}@media(max-width:620px){.setupGrid{grid-template-columns:1fr}}.helper{font-size:12px;color:#94a3b8;margin-top:6px;line-height:1.45}</style>
</head>
<body>
<main class="authShell">
  <section class="authCard" style="width:min(620px,calc(100% - 32px))">
    <div class="authBrand"><%= siteName %></div>
    <div class="muted">Secure first-run installer</div>
    <div class="setupSteps"><span class="setupStep">1 · Claimed</span><span class="setupStep active">2 · Create admin</span><span class="setupStep">3 · Dashboard</span></div>
    <h1 class="authTitle">Create the first administrator</h1>
    <p class="muted">These settings establish the local platform identity and the first native administrator. Jellyfin, plans, payments and customer-facing features remain optional after this step.</p>
    <% if (error) { %><div class="notice error"><%= error %></div><% } %>
    <form method="post" action="/setup/complete" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="formGroup">
        <label for="siteName">Site name</label>
        <input class="input" id="siteName" name="siteName" minlength="2" maxlength="80" value="<%= values.siteName %>" required <%= field === 'siteName' ? 'aria-invalid="true"' : '' %>>
        <div class="helper">Shown in the administration interface, storefront and sign-in screens.</div>
        <% if (field === 'siteName') { %><div class="fieldError"><%= error %></div><% } %>
      </div>
      <div class="setupGrid">
        <div class="formGroup">
          <label for="username">Administrator username</label>
          <input class="input" id="username" name="username" minlength="3" maxlength="40" pattern="[A-Za-z0-9._-]{3,40}" value="<%= values.username %>" autocomplete="username" required <%= field === 'username' ? 'aria-invalid="true"' : '' %>>
          <% if (field === 'username') { %><div class="fieldError"><%= error %></div><% } %>
        </div>
        <div class="formGroup">
          <label for="email">Administrator email <span class="muted">(optional)</span></label>
          <input class="input" id="email" name="email" type="email" maxlength="254" value="<%= values.email %>" autocomplete="email" <%= field === 'email' ? 'aria-invalid="true"' : '' %>>
          <% if (field === 'email') { %><div class="fieldError"><%= error %></div><% } %>
        </div>
      </div>
      <div class="setupGrid">
        <div class="formGroup">
          <label for="password">Password</label>
          <input class="input" id="password" name="password" type="password" minlength="12" maxlength="200" autocomplete="new-password" required <%= field === 'password' ? 'aria-invalid="true"' : '' %>>
          <div class="helper">Minimum 12 characters.</div>
          <% if (field === 'password') { %><div class="fieldError"><%= error %></div><% } %>
        </div>
        <div class="formGroup">
          <label for="passwordConfirm">Confirm password</label>
          <input class="input" id="passwordConfirm" name="passwordConfirm" type="password" minlength="12" maxlength="200" autocomplete="new-password" required <%= field === 'passwordConfirm' ? 'aria-invalid="true"' : '' %>>
          <% if (field === 'passwordConfirm') { %><div class="fieldError"><%= error %></div><% } %>
        </div>
      </div>
      <div class="buttonRow"><button class="button" type="submit">Create administrator & finish</button></div>
    </form>
    <p class="securityNote">Two-factor authentication is optional by default and can be enabled immediately afterwards under Settings → Security.</p>
  </section>
</main>
</body>
</html>
