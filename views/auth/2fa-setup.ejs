<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Set up 2FA · <%= siteName %></title><link rel="stylesheet" href="/css/platform-shell.css"></head>
<body><main class="authShell"><section class="authCard"><div class="authBrand"><%= siteName %></div><div class="muted">Administration</div><h1 class="authTitle">Set up 2FA</h1><p class="muted">Add this account to your authenticator app, then confirm with the six-digit code.</p><div class="formGroup"><label>Account</label><div class="codeBox"><%= username %></div></div><div class="formGroup"><label>Setup code</label><div class="codeBox"><%= secret %></div></div><div class="formGroup"><label>App link</label><div class="codeBox"><%= uri %></div></div><% if (error) { %><div class="notice error"><%= error %></div><% } %><form method="post" action="/auth/2fa/setup"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="formGroup"><label for="code">Six-digit code</label><input class="input" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required autofocus></div><% if (requiresApproval) { %><div class="formGroup"><label for="enrollmentToken">Administrator enrollment approval</label><input class="input" id="enrollmentToken" name="enrollmentToken" type="password" autocomplete="off" required><div class="subText">Use the independent enrollment token configured on the server. This prevents a password-only compromise from claiming first-time administrator 2FA.</div></div><% } %><div class="buttonRow"><button class="button" type="submit">Enable 2FA</button><a class="button secondary" href="/logout">Cancel</a></div></form></section></main></body></html>
