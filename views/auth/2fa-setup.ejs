<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Set up 2FA · <%= siteName %></title><link rel="stylesheet" href="/css/platform-shell.css"></head>
<body><main class="authShell"><section class="authCard"><div class="authBrand"><%= siteName %></div><div class="muted">Administration</div><h1 class="authTitle">Set up 2FA</h1><p class="muted">Scan the QR code with your authenticator app, then enter the six-digit code it generates.</p><div class="formGroup"><label>Account</label><div class="codeBox"><%= username %></div></div><% if (qrDataUri) { %><div class="formGroup"><label>Scan with your authenticator</label><div style="background:#fff;border-radius:14px;padding:14px;display:inline-block;max-width:100%"><img src="<%= qrDataUri %>" alt="Two-factor authentication setup QR code" width="240" height="240" style="display:block;max-width:100%;height:auto"></div><div class="subText">Google Authenticator, Microsoft Authenticator, Authy, 1Password and other standard TOTP apps are supported.</div></div><% } else { %><div class="notice error">The QR image could not be generated. You can still use the manual setup key below.</div><% } %><details class="formGroup"><summary>Can't scan it? Use the manual setup key</summary><div class="formGroup" style="margin-top:12px"><label>Setup key</label><div class="codeBox"><%= secret %></div></div></details><% if (error) { %><div class="notice error"><%= error %></div><% } %><form method="post" action="/auth/2fa/setup"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="formGroup"><label for="code">Six-digit code</label><input class="input" id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" maxlength="6" required autofocus></div><% if (requiresApproval) { %><div class="formGroup"><label for="enrollmentToken">Administrator enrollment approval</label><input class="input" id="enrollmentToken" name="enrollmentToken" type="password" autocomplete="off" required><div class="subText">Use the independent enrollment token configured on the server. This prevents a password-only compromise from claiming first-time administrator 2FA.</div></div><% } %><div class="buttonRow"><button class="button" type="submit">Verify &amp; enable 2FA</button><a class="button secondary" href="/logout">Cancel</a></div></form></section></main></body></html>
