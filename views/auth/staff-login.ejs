<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Staff sign in · <%= siteName %></title><link rel="stylesheet" href="/css/platform-shell.css"></head>
<body><main class="authShell"><section class="authCard"><div class="authBrand"><%= siteName %></div><div class="muted">Administration</div><h1 class="authTitle">Staff sign in</h1><p class="muted">Use your administrator account.</p><% if (message) { %><div class="notice"><%= message %></div><% } %><% if (error) { %><div class="notice error"><%= error %></div><% } %><form method="post" action="/login" autocomplete="on"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="formGroup"><label for="username">Username or email</label><input class="input" id="username" name="username" autocomplete="username" required autofocus></div><div class="formGroup"><label for="password">Password</label><input class="input" id="password" name="password" type="password" autocomplete="current-password" required></div><div class="buttonRow"><button class="button" type="submit">Sign in</button></div></form><p class="securityNote">Protected by PostgreSQL-backed sessions, account lockout and two-factor authentication policy.</p></section></main></body></html>
