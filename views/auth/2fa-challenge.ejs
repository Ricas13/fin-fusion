<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Two-factor verification · <%= siteName %></title><link rel="stylesheet" href="/css/platform-shell.css"></head>
<body><main class="authShell"><section class="authCard"><div class="authBrand"><%= siteName %></div><div class="muted">Administration</div><h1 class="authTitle">Two-factor verification</h1><p class="muted">Enter the six-digit code for <strong><%= username %></strong>, or use one unused recovery code.</p><% if (error) { %><div class="notice error"><%= error %></div><% } %><form method="post" action="/auth/2fa"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="formGroup"><label for="code">Authenticator or recovery code</label><input class="input" id="code" name="code" autocomplete="one-time-code" inputmode="text" required autofocus></div><div class="buttonRow"><button class="button" type="submit">Verify</button><a class="button secondary" href="/logout">Cancel</a></div></form><p class="securityNote">Repeated failures temporarily lock the staff account.</p></section></main></body></html>
