<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Administration · <%= siteName %></title>
  <link rel="stylesheet" href="/css/platform-shell.css">
</head>
<body>
<div class="appShell">
  <aside class="sideNav">
    <div class="brand"><%= siteName %></div>
    <div class="navSection">Server</div>
    <a class="navItem active" href="/admin">Dashboard</a>
    <a class="navItem" href="/admin/activity">Activity</a>
    <a class="navItem" href="/admin/users">Users</a>
    <a class="navItem" href="/admin/servers">Servers</a>
    <span class="navItem disabled">Libraries</span>
    <div class="navSection">Business</div>
    <span class="navItem disabled">Plans</span><span class="navItem disabled">Payments</span><span class="navItem disabled">Resellers</span><span class="navItem disabled">Requests</span>
    <div class="navSection">System</div>
    <span class="navItem disabled">Notifications</span><a class="navItem" href="/admin/security">Security</a><span class="navItem disabled">Settings</span>
  </aside>
  <main class="mainPane">
    <header class="topBar"><div>Administration</div><a class="muted" href="/logout">Sign out</a></header>
    <div class="content">
      <div class="pageHeader"><h1>Dashboard</h1><div class="muted">CAPTAiNFiN platform overview</div></div>

      <div class="metrics">
        <div class="metric"><div class="metricLabel">Managed customers</div><div class="metricValue"><%= stats.customers %></div></div>
        <div class="metric"><div class="metricLabel">Active subscriptions</div><div class="metricValue"><%= stats.activeSubscriptions %></div></div>
        <div class="metric"><div class="metricLabel">Active streams</div><div class="metricValue"><%= stats.activeStreams %></div></div>
        <div class="metric"><div class="metricLabel">Transcodes</div><div class="metricValue"><%= stats.transcodes %></div></div>
        <div class="metric"><div class="metricLabel">Healthy servers</div><div class="metricValue"><%= stats.healthyServers %>/<%= stats.servers %></div></div>
        <div class="metric"><div class="metricLabel">Would stop · 24h</div><div class="metricValue"><%= stats.wouldStop24h %></div></div>
      </div>

      <div class="statusBanner <%= stats.offlineServers ? 'warn' : '' %>">
        <strong>Stream policy:</strong> <%= streamPolicyMode %> · <strong>Administrator 2FA:</strong> <%= admin2faRequired ? 'required' : 'optional' %><% if (stats.offlineServers) { %> · <strong><%= stats.offlineServers %> server(s) offline</strong><% } %>
      </div>

      <section class="section">
        <div class="sectionHead"><h2>Management</h2><span class="muted">Available now</span></div>
        <div class="serverGrid">
          <a class="serverCard" href="/admin/users"><div class="serverTop"><strong>Users</strong><span class="pill accent"><%= stats.customers %></span></div><p class="muted">Customers, subscriptions, Jellyfin accounts and provisioning state.</p><div class="cardActions"><span class="button">Open Users</span></div></a>
          <a class="serverCard" href="/admin/activity"><div class="serverTop"><strong>Activity</strong><span class="pill good"><%= stats.activeStreams %> streams</span></div><p class="muted">Live playback, transcodes, stream limits and policy observations.</p><div class="cardActions"><span class="button">Open Activity</span></div></a>
          <a class="serverCard" href="/admin/servers"><div class="serverTop"><strong>Servers</strong><span class="pill <%= stats.offlineServers ? 'bad' : 'good' %>"><%= stats.healthyServers %>/<%= stats.servers %> healthy</span></div><p class="muted">Jellyfin health, capacity, placement and server configuration.</p><div class="cardActions"><span class="button">Open Servers</span></div></a>
          <a class="serverCard" href="/admin/security"><div class="serverTop"><strong>Security</strong><span class="pill <%= admin2faRequired ? 'good' : 'warn' %>"><%= admin2faRequired ? '2FA required' : '2FA optional' %></span></div><p class="muted">Password, sessions and authentication events.</p><div class="cardActions"><span class="button">Open Security</span></div></a>
        </div>
      </section>

      <section class="section"><div class="sectionHead"><h2>Coming next</h2><span class="muted">Not active yet</span></div><div class="formPanel"><div class="flagRow"><span class="pill">Plans</span><span class="pill">Payments</span><span class="pill">Resellers</span><span class="pill">Requests</span><span class="pill">Libraries</span><span class="pill">Notifications</span><span class="pill">Settings</span></div><p class="muted">These remain disabled until their native PostgreSQL-backed screens are implemented.</p></div></section>

      <% if (stats.safetySkips24h) { %><div class="securityNote standalone">Policy safety skips in the last 24 hours: <%= stats.safetySkips24h %>. Review Activity before enabling enforcement.</div><% } %>
    </div>
  </main>
</div>
</body>
</html>
