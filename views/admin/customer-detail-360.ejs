<!doctype html><html lang="en"><head><title>Customer · <%= siteName %></title><%- include('_head') %><link rel="stylesheet" href="/css/customer-360.css"></head><body><div class="appShell"><%- include('_nav',{siteName,activeNav:'users'}) %><main class="mainPane"><header class="topBar"><div>Customer</div><a class="button secondary" href="/admin/users">Back to Customers</a></header><div class="content"><% const current=subscriptions.find(s=>['active','trialing','past_due'].includes(s.status)&&new Date(s.current_period_end)>new Date())||subscriptions[0]||null; const name=customer.display_name||customer.login_username||customer.login_email||customer.email||'Managed customer'; const fmt=v=>v?new Date(v).toLocaleString():'—'; const bytes=n=>{n=Number(n||0);if(n<1024)return n+' B';if(n<1024**2)return (n/1024).toFixed(1)+' KB';if(n<1024**3)return (n/1024**2).toFixed(1)+' MB';return (n/1024**3).toFixed(2)+' GB'}; const hours=s=>(Number(s||0)/3600).toFixed(1)+' h'; const tabs=[['overview','Overview'],['subscription','Subscription'],['access','Server Access'],['payments','Payments'],['activity','Activity'],['downloads','Downloads'],['requests','Requests'],['security','Security'],['timeline','Timeline']]; %><div class="profileHero"><div class="profileIdentity"><h1><%= name %></h1><div class="profileMeta"><span><%= customer.login_email||customer.email||'No email' %></span><span>·</span><span><%= customer.reseller_username?'Reseller: '+customer.reseller_username:'Direct customer' %></span><span>·</span><span><%= customer.registration_source||'Source unknown' %></span></div></div><div class="profileActions"><% if(customer.discord_username){ %><span class="pill accent">Discord <%= customer.discord_username %></span><% } %><span class="pill <%= customer.login_active===false?'bad':'good' %>"><%= customer.login_active===false?'Portal disabled':'Portal active' %></span></div></div><% if(message){ %><div class="notice success"><%= message %></div><% } %><% if(error){ %><div class="notice error"><%= error %></div><% } %><div class="summaryGrid"><div class="summaryCard"><div class="summaryLabel">Current plan</div><div class="summaryValue"><%= current?current.plan_name:'None' %></div><div class="summarySub"><%= current?current.status+' · '+current.streams+' streams':'No active subscription' %></div></div><div class="summaryCard"><div class="summaryLabel">Server access</div><div class="summaryValue"><%= accounts.filter(a=>!a.disabled).length %></div><div class="summarySub"><%= accounts.length %> Jellyfin account<%= accounts.length===1?'':'s' %></div></div><div class="summaryCard"><div class="summaryLabel">Active now</div><div class="summaryValue"><%= activeStreams.length %></div><div class="summarySub"><%= activitySummary.last_playback_at?'Last '+fmt(activitySummary.last_playback_at):'No playback yet' %></div></div><div class="summaryCard"><div class="summaryLabel">30-day usage</div><div class="summaryValue"><%= hours(activitySummary.watch_seconds_30d) %></div><div class="summarySub"><%= activitySummary.sessions_30d||0 %> sessions · <%= downloadSummary.downloads_30d||0 %> downloads</div></div></div><nav class="detailTabs"><% tabs.forEach(([key,label])=>{ %><a class="detailTab <%= activeTab===key?'active':'' %>" href="/admin/users/<%= customer.id %>?tab=<%= key %>"><%= label %></a><% }) %></nav><% if(activeTab==='overview'){ %><%- include('customer-tabs/overview',{customer,current,accounts,activitySummary,downloadSummary,csrfToken,fmt,bytes,hours}) %><% } else if(activeTab==='subscription'){ %><%- include('customer-tabs/subscription',{subscriptions,fmt}) %><% } else if(activeTab==='access'){ %><%- include('customer-tabs/access',{customer,accounts,runs,current,csrfToken,fmt}) %><% } else if(activeTab==='payments'){ %><%- include('customer-tabs/payments',{paymentCustomers,subscriptions,fmt}) %><% } else if(activeTab==='activity'){ %><%- include('customer-tabs/activity',{activeStreams,activitySummary,playback,policyEvents,fmt,hours}) %><% } else if(activeTab==='downloads'){ %><%- include('customer-tabs/downloads',{downloadSummary,downloads,fmt,bytes}) %><% } else if(activeTab==='requests'){ %><%- include('customer-tabs/requests',{requests,fmt}) %><% } else if(activeTab==='security'){ %><%- include('customer-tabs/security',{customer,authSessions,authEvents,fmt}) %><% } else { %><%- include('customer-tabs/timeline',{timeline,fmt}) %><% } %></div></main></div></body></html>