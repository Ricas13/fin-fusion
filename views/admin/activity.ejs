<!doctype html>
<html lang="en">
<head>
  <title>Playback Operations · <%= siteName %></title>
  <%- include('_head') %>
</head>
<body class="page-playback">
<div class="appShell">
  <%- include('_nav',{siteName,activeNav:'activity'}) %>
  <main class="mainPane">
    <header class="topBar"><div>Jellyfin</div><div class="muted">Playback operations</div></header>
    <div class="content page-playback">
      <div class="pageHeader">
        <h1>Playback Operations</h1>
        <div class="muted">See live playback and concurrency exceptions first; policy controls and historical detail stay secondary.</div>
      </div>

      <% if(message){ %><div class="notice success"><%= message %></div><% } %>
      <% if(error){ %><div class="notice error"><%= error %></div><% } %>

      <%- heroHtml %>

      <% if(issueHtml){ %>
      <section class="section" id="playback-issues">
        <div class="uiSectionHeader">
          <div>
            <span class="uiEyebrow">Current exceptions</span>
            <h2>Fix these playback issues first</h2>
            <p>These items come from the same live sessions, server health and policy-event state used by the playback worker.</p>
          </div>
        </div>
        <div style="display:grid;gap:12px"><%- issueHtml %></div>
      </section>
      <% } %>

      <section class="section" id="active-streams">
        <div class="sectionHead">
          <div>
            <h2>Active streams</h2>
            <div class="muted">Live managed sessions · <%= summary.active_streams %> active · <%= summary.transcodes %> transcoding</div>
          </div>
          <% if(state.overLimitCustomers.length){ %><span class="pill bad"><%= state.overLimitCustomers.length %> over limit</span><% } else { %><span class="pill good">Within limits</span><% } %>
        </div>
        <% if(!streams.length){ %>
          <div class="empty">No managed playback is currently active.</div>
        <% } else { %>
          <div class="tableWrap">
            <table class="dataTable responsiveTable">
              <thead><tr><th>Customer</th><th>Media</th><th>Server</th><th>Device</th><th>Method</th><th>Streams</th><th>State</th></tr></thead>
              <tbody>
              <% streams.forEach(function(s){ const streamLimit=Number(s.stream_limit||0),streamCount=Number(s.customer_stream_count||0),overLimit=streamLimit>0&&streamCount>streamLimit; %>
                <tr>
                  <td data-label="Customer"><div class="mediaTitle"><%= s.customer_name %></div><div class="subText"><%= s.jellyfin_username||'' %></div></td>
                  <td data-label="Media"><%= s.item_name||'Unknown item' %></td>
                  <td data-label="Server"><%= s.server_name %></td>
                  <td data-label="Device"><%= s.device_name||s.client_name||'Unknown' %></td>
                  <td data-label="Method"><span class="pill <%= s.playback_method==='transcode'?'warn':'accent' %>"><%= s.playback_method %></span></td>
                  <td data-label="Streams"><span class="pill <%= overLimit?'bad':'good' %>"><%= streamCount %> / <%= streamLimit||'?' %></span></td>
                  <td data-label="State"><%= s.is_paused?'Paused':'Playing' %></td>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
        <div class="securityNote">Network endpoints and raw Jellyfin device identifiers are intentionally not exposed.</div>
      </section>

      <% if(recentDecisions.length){ %>
      <section class="section" id="policy-decisions">
        <div class="sectionHead">
          <div>
            <h2>Recent policy decisions &amp; safety checks</h2>
            <div class="muted">Significant concurrency decisions from the last 24 hours. Pending grace/confirmation noise stays in the full event history below.</div>
          </div>
          <span class="pill <%= state.stopFailures.length?'bad':state.safetyIssues.length||state.violations.length?'warn':'good' %>"><%= recentDecisions.length %> event<%= recentDecisions.length===1?'':'s' %></span>
        </div>
        <div class="tableWrap">
          <table class="dataTable responsiveTable">
            <thead><tr><th>Time</th><th>Customer</th><th>Decision</th><th>Server</th><th>Streams</th><th>Reason</th></tr></thead>
            <tbody>
            <% recentDecisions.forEach(function(e){ %>
              <tr>
                <td data-label="Time"><%= new Date(e.created_at).toLocaleString() %></td>
                <td data-label="Customer"><%= e.customer_name %></td>
                <td data-label="Decision"><span class="pill <%= e.tone %>"><%= e.decision_label %></span></td>
                <td data-label="Server"><%= e.server_name||'—' %></td>
                <td data-label="Streams"><%= e.stream_count==null?'—':e.stream_count %> / <%= e.stream_limit==null?'—':e.stream_limit %></td>
                <td data-label="Reason"><%= e.reason_label %><% if(e.safety_issue){ %><div class="subText">Safety guard prevented an unsafe stop.</div><% } %></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      </section>
      <% } %>

      <details class="operatorDetails" id="playback-policy">
        <summary>
          <span>Stream policy &amp; enforcement settings</span>
          <small><%= policy.mode==='enforce'?'Enforce':policy.mode==='warn'?'Warn':'Observe' %> mode · open only when intentionally changing concurrency behaviour</small>
        </summary>
        <div class="operatorDetailsBody">
          <div class="statusBanner <%= policy.mode==='enforce'?'bad':policy.mode==='warn'?'warn':'' %>">
            <strong><%= policy.mode==='enforce'?'Enforcement':policy.mode==='warn'?'Warn':'Observe' %> mode.</strong>
            <%= policy.mode==='enforce'?'Confirmed excess playback may be stopped only after grace, confirmation and live safety revalidation.':policy.mode==='warn'?'Violations are recorded for operator action; playback is never stopped.':'Playback is observed and policy decisions are recorded; playback is never stopped.' %>
          </div>
          <section class="section">
            <div class="sectionHead"><div><h2>Stream policy</h2><div class="muted">The dedicated activity worker reads this canonical policy. Enforcement always requires the explicit acknowledgement below.</div></div></div>
            <form class="formPanel" method="post" action="/admin/activity/policy">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="formGrid">
                <div class="formGroup"><label for="stream-policy-mode">Mode</label><select class="input" id="stream-policy-mode" name="mode"><option value="observe" <%= policy.mode==='observe'?'selected':'' %>>Observe only</option><option value="warn" <%= policy.mode==='warn'?'selected':'' %>>Warn / record violations</option><option value="enforce" <%= policy.mode==='enforce'?'selected':'' %>>Enforce after safety checks</option></select></div>
                <div class="formGroup"><label for="stream-policy-active-window">Active window (seconds)</label><input class="input" id="stream-policy-active-window" type="number" min="30" max="600" name="activeWindowSeconds" value="<%= policy.activeWindowSeconds %>"></div>
                <div class="formGroup"><label for="stream-policy-grace">Grace period (seconds)</label><input class="input" id="stream-policy-grace" type="number" min="10" max="900" name="graceSeconds" value="<%= policy.graceSeconds %>"></div>
                <div class="formGroup"><label for="stream-policy-confirmations">Confirmations required</label><input class="input" id="stream-policy-confirmations" type="number" min="2" max="10" name="confirmationsRequired" value="<%= policy.confirmationsRequired %>"></div>
                <div class="formGroup"><label for="stream-policy-history-retention">Playback history retention (days)</label><input class="input" id="stream-policy-history-retention" type="number" min="7" max="3650" name="historyRetentionDays" value="<%= policy.historyRetentionDays %>"></div>
                <div class="formGroup"><label for="stream-policy-event-retention">Policy event retention (days)</label><input class="input" id="stream-policy-event-retention" type="number" min="30" max="3650" name="eventRetentionDays" value="<%= policy.eventRetentionDays %>"></div>
              </div>
              <label class="toggleRow"><input type="checkbox" name="countPaused" <%= policy.countPaused?'checked':'' %>><span>Count paused sessions against concurrency limit</span></label>
              <div class="formGroup"><label for="stream-policy-enforcement-ack">Enforcement acknowledgement</label><input class="input" id="stream-policy-enforcement-ack" name="enforcementAck" autocomplete="off" placeholder="Required only when selecting Enforce"><div class="inlineHelp">Type <code>I_UNDERSTAND_THIS_STOPS_PLAYBACK</code> when enabling enforcement.</div></div>
              <button class="button">Save stream policy</button>
            </form>
          </section>
        </div>
      </details>

      <details class="operatorDetails">
        <summary><span>Fleet context</span><small><%= servers.length %> configured servers · routine capacity and health detail</small></summary>
        <div class="operatorDetailsBody">
          <div class="serverGrid">
          <% servers.forEach(function(s){ const healthDate=s.last_health_check?new Date(s.last_health_check):null; %>
            <div class="serverCard">
              <div class="serverTop"><strong><%= s.name %></strong><span class="pill <%= s.health_status==='healthy'?'good':(s.health_status==='offline'?'bad':'warn') %>"><%= s.health_status %></span></div>
              <p class="muted"><%= s.server_class %> · <%= s.placement_mode||'active' %> · <%= s.active_streams %> active streams</p>
              <p><%= s.assigned_users||0 %><%= s.max_users?' / '+s.max_users:'' %> managed users</p>
              <div class="subText">Last health check: <%= healthDate&&!Number.isNaN(healthDate.getTime())?healthDate.toLocaleString():'never' %></div>
            </div>
          <% }) %>
          </div>
        </div>
      </details>

      <details class="operatorDetails">
        <summary><span>Full policy event history</span><small><%= events.length %> recent events including grace periods and confirmation steps</small></summary>
        <div class="operatorDetailsBody">
          <% if(!events.length){ %><div class="empty">No stream-policy events recorded.</div><% } else { %>
          <div class="tableWrap">
            <table class="dataTable responsiveTable">
              <thead><tr><th>Time</th><th>Customer</th><th>Decision</th><th>Server</th><th>Streams</th><th>Reason</th></tr></thead>
              <tbody>
              <% events.forEach(function(e){ %>
                <tr>
                  <td data-label="Time"><%= new Date(e.created_at).toLocaleString() %></td>
                  <td data-label="Customer"><%= e.customer_name %></td>
                  <td data-label="Decision"><span class="pill <%= e.tone %>"><%= e.decision_label %></span></td>
                  <td data-label="Server"><%= e.server_name||'—' %></td>
                  <td data-label="Streams"><%= e.stream_count==null?'—':e.stream_count %> / <%= e.stream_limit==null?'—':e.stream_limit %></td>
                  <td data-label="Reason"><%= e.reason_label %></td>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </details>

      <details class="operatorDetails">
        <summary><span>Routine playback history</span><small><%= history.length %> recent playback records · open when tracing historical behaviour</small></summary>
        <div class="operatorDetailsBody">
          <% if(!history.length){ %><div class="empty">No playback history recorded yet.</div><% } else { %>
          <div class="tableWrap">
            <table class="dataTable responsiveTable">
              <thead><tr><th>Started</th><th>Customer</th><th>Media</th><th>Server</th><th>Method</th><th>Ended</th></tr></thead>
              <tbody>
              <% history.forEach(function(h){ %>
                <tr>
                  <td data-label="Started"><%= new Date(h.started_at).toLocaleString() %></td>
                  <td data-label="Customer"><%= h.customer_name %></td>
                  <td data-label="Media"><%= h.item_name||'Unknown item' %></td>
                  <td data-label="Server"><%= h.server_name %></td>
                  <td data-label="Method"><%= h.playback_method %></td>
                  <td data-label="Ended"><%= h.ended_at?new Date(h.ended_at).toLocaleString():'Active / recent' %></td>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </details>
    </div>
  </main>
</div>
</body>
</html>
