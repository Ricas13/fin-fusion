<!doctype html><html lang="en"><head><title>Activity · <%= siteName %></title><%- include('_head') %></head><body><div class="appShell"><%- include('_nav',{siteName,activeNav:'activity'}) %><main class="mainPane"><header class="topBar"><div>Administration</div><div class="muted">Playback operations</div></header><div class="content"><div class="pageHeader"><h1>Playback activity</h1><div class="muted">Jellyfin activity, policy observation and controlled stream enforcement</div></div><% if(message){ %><div class="notice success"><%= message %></div><% } %><% if(error){ %><div class="notice error"><%= error %></div><% } %><div class="statusBanner <%= policy.mode==='enforce'?'bad':policy.mode==='warn'?'warn':'' %>"><strong><%= policy.mode==='enforce'?'Enforcement':policy.mode==='warn'?'Warn':'Observe' %> mode.</strong> <%= policy.mode==='enforce'?'Confirmed excess playback may be stopped after safety revalidation.':policy.mode==='warn'?'Violations are recorded for operator action; playback is never stopped.':'Playback is observed and policy decisions are recorded; playback is never stopped.' %></div><section class="section"><div class="sectionHead"><div><h2>Stream policy</h2><div class="muted">Browser-managed policy is read by the dedicated activity worker. Enforcement requires an explicit safety acknowledgement.</div></div></div><form class="formPanel" method="post" action="/admin/activity/policy"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="formGrid"><div class="formGroup"><label>Mode</label><select class="input" name="mode"><option value="observe" <%= policy.mode==='observe'?'selected':'' %>>Observe only</option><option value="warn" <%= policy.mode==='warn'?'selected':'' %>>Warn / record violations</option><option value="enforce" <%= policy.mode==='enforce'?'selected':'' %>>Enforce after safety checks</option></select></div><div class="formGroup"><label>Active window (seconds)</label><input class="input" type="number" min="30" max="600" name="activeWindowSeconds" value="<%= policy.activeWindowSeconds %>"></div><div class="formGroup"><label>Grace period (seconds)</label><input class="input" type="number" min="10" max="900" name="graceSeconds" value="<%= policy.graceSeconds %>"></div><div class="formGroup"><label>Confirmations required</label><input class="input" type="number" min="2" max="10" name="confirmationsRequired" value="<%= policy.confirmationsRequired %>"></div><div class="formGroup"><label>Playback history retention (days)</label><input class="input" type="number" min="7" max="3650" name="historyRetentionDays" value="<%= policy.historyRetentionDays %>"></div><div class="formGroup"><label>Policy event retention (days)</label><input class="input" type="number" min="30" max="3650" name="eventRetentionDays" value="<%= policy.eventRetentionDays %>"></div></div><label class="toggleRow"><input type="checkbox" name="countPaused" <%= policy.countPaused?'checked':'' %>><span>Count paused sessions against concurrency limit</span></label><div class="formGroup"><label>Enforcement acknowledgement</label><input class="input" name="enforcementAck" autocomplete="off" placeholder="Required only when selecting Enforce"><div class="inlineHelp">Type <code>I_UNDERSTAND_THIS_STOPS_PLAYBACK</code> when enabling enforcement.</div></div><button class="button">Save stream policy</button></form></section><div class="metrics"><div class="metric"><div class="metricLabel">Active streams</div><div class="metricValue"><%= summary.active_streams %></div></div><div class="metric"><div class="metricLabel">Transcodes</div><div class="metricValue"><%= summary.transcodes %></div></div><div class="metric"><div class="metricLabel">Potential violations</div><div class="metricValue"><%= summary.violations_24h %></div></div><div class="metric"><div class="metricLabel">Safety skips</div><div class="metricValue"><%= summary.safety_skips_24h %></div></div><div class="metric"><div class="metricLabel">Subscriptions</div><div class="metricValue"><%= summary.active_subscriptions %></div></div><div class="metric"><div class="metricLabel">Offline servers</div><div class="metricValue"><%= summary.offline_servers %>/<%= summary.enabled_servers %></div></div></div><section class="section"><div class="sectionHead"><h2>Active streams</h2><span class="muted"><%= streams.length %> observed</span></div><% if(!streams.length){ %><div class="empty">No managed playback is currently active.</div><% } else { %><div class="tableWrap"><table class="dataTable responsiveTable"><thead><tr><th>User</th><th>Media</th><th>Server</th><th>Device</th><th>Method</th><th>Streams</th><th>State</th></tr></thead><tbody><% streams.forEach(function(s){ %><tr><td data-label="User"><div class="mediaTitle"><%= s.customer_name %></div><div class="subText"><%= s.jellyfin_username||'' %></div></td><td data-label="Media"><%= s.item_name||'Unknown item' %></td><td data-label="Server"><%= s.server_name %></td><td data-label="Device"><%= s.device_name||s.client_name||'Unknown' %></td><td data-label="Method"><span class="pill <%= s.playback_method==='transcode'?'warn':'accent' %>"><%= s.playback_method %></span></td><td data-label="Streams"><%= s.customer_stream_count %> / <%= s.stream_limit||'?' %></td><td data-label="State"><%= s.is_paused?'Paused':'Playing' %></td></tr><% }) %></tbody></table></div><% } %><div class="securityNote">Network endpoints and raw Jellyfin device identifiers are intentionally not exposed.</div></section><section class="section"><div class="sectionHead"><h2>Servers</h2></div><div class="serverGrid"><% servers.forEach(function(s){const healthDate=s.last_health_check?new Date(s.last_health_check):null; %><div class="serverCard"><div class="serverTop"><strong><%= s.name %></strong><span class="pill <%= s.health_status==='healthy'?'good':(s.health_status==='offline'?'bad':'warn') %>"><%= s.health_status %></span></div><p class="muted"><%= s.server_class %> · <%= s.placement_mode||'active' %> · <%= s.active_streams %> active streams</p><p><%= s.assigned_users||0 %><%= s.max_users?' / '+s.max_users:'' %> managed users</p><div class="subText">Last health check: <%= healthDate&&!Number.isNaN(healthDate.getTime())?healthDate.toLocaleString():'never' %></div></div><% }) %></div></section><section class="section"><div class="sectionHead"><h2>Stream policy events</h2><span class="muted">most recent 60</span></div><% if(!events.length){ %><div class="empty">No stream-policy events recorded.</div><% } else { %><div class="tableWrap"><table class="dataTable responsiveTable"><thead><tr><th>Time</th><th>User</th><th>Decision</th><th>Server</th><th>Reason</th></tr></thead><tbody><% events.forEach(function(e){ %><tr><td data-label="Time"><%= new Date(e.created_at).toLocaleString() %></td><td data-label="User"><%= e.customer_name %></td><td data-label="Decision"><span class="pill"><%= e.decision %></span></td><td data-label="Server"><%= e.server_name||'—' %></td><td data-label="Reason"><%= e.reason %></td></tr><% }) %></tbody></table></div><% } %></section><section class="section"><div class="sectionHead"><h2>Recent playback</h2></div><% if(!history.length){ %><div class="empty">No playback history recorded yet.</div><% } else { %><div class="tableWrap"><table class="dataTable responsiveTable"><thead><tr><th>Started</th><th>User</th><th>Media</th><th>Server</th><th>Method</th><th>Ended</th></tr></thead><tbody><% history.forEach(function(h){ %><tr><td data-label="Started"><%= new Date(h.started_at).toLocaleString() %></td><td data-label="User"><%= h.customer_name %></td><td data-label="Media"><%= h.item_name||'Unknown item' %></td><td data-label="Server"><%= h.server_name %></td><td data-label="Method"><%= h.playback_method %></td><td data-label="Ended"><%= h.ended_at?new Date(h.ended_at).toLocaleString():'Active / recent' %></td></tr><% }) %></tbody></table></div><% } %></section></div></main></div></body></html>