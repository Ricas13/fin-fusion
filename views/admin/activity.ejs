<!doctype html><html lang="en"><head><title>Activity · <%= siteName %></title><%- include('_head') %></head><body><div class="appShell"><%- include('_nav',{siteName,activeNav:'activity'}) %><main class="mainPane"><header class="topBar"><div>Administration</div><div class="muted">Read-only monitoring</div></header><div class="content"><div class="pageHeader"><h1>Playback activity</h1><div class="muted">Jellyfin activity and stream-policy observation</div></div><div class="statusBanner <%= cfg.effectiveMode==='enforce'?'bad':'' %>"><strong><%= cfg.effectiveMode==='enforce'?'Enforcement mode':'Observation mode' %>.</strong> <%= cfg.effectiveMode==='enforce'?'Playback actions can occur.':'No playback is stopped.' %></div><div class="metrics"><div class="metric"><div class="metricLabel">Active streams</div><div class="metricValue"><%= summary.active_streams %></div></div><div class="metric"><div class="metricLabel">Transcodes</div><div class="metricValue"><%= summary.transcodes %></div></div><div class="metric"><div class="metricLabel">Potential violations</div><div class="metricValue"><%= summary.violations_24h %></div></div><div class="metric"><div class="metricLabel">Safety skips</div><div class="metricValue"><%= summary.safety_skips_24h %></div></div><div class="metric"><div class="metricLabel">Subscriptions</div><div class="metricValue"><%= summary.active_subscriptions %></div></div><div class="metric"><div class="metricLabel">Offline servers</div><div class="metricValue"><%= summary.offline_servers %>/<%= summary.enabled_servers %></div></div></div><section class="section"><div class="sectionHead"><h2>Active streams</h2><span class="muted"><%= streams.length %> observed</span></div><% if(!streams.length){ %><div class="empty">No managed playback is currently active.</div><% } else { %><div class="tableWrap"><table class="dataTable"><thead><tr><th>User</th><th>Media</th><th>Server</th><th>Device</th><th>Method</th><th>Streams</th><th>State</th></tr></thead><tbody><% streams.forEach(function(s){ %><tr><td><div class="mediaTitle"><%= s.customer_name %></div><div class="subText"><%= s.jellyfin_username||'' %></div></td><td><%= s.item_name||'Unknown item' %></td><td><%= s.server_name %></td><td><%= s.device_name||s.client_name||'Unknown' %></td><td><span class="pill <%= s.playback_method==='transcode'?'warn':'accent' %>"><%= s.playback_method %></span></td><td><%= s.customer_stream_count %> / <%= s.stream_limit||'?' %></td><td><%= s.is_paused?'Paused':'Playing' %></td></tr><% }) %></tbody></table></div><% } %><div class="securityNote">Network endpoints and raw Jellyfin device identifiers are intentionally not exposed.</div></section><section class="section"><div class="sectionHead"><h2>Servers</h2></div><div class="serverGrid"><% servers.forEach(function(s){ const healthDate=s.last_health_check?new Date(s.last_health_check):null; %><div class="serverCard"><div class="serverTop"><strong><%= s.name %></strong><span class="pill <%= s.health_status==='healthy'?'good':(s.health_status==='offline'?'bad':'warn') %>"><%= s.health_status %></span></div><p class="muted"><%= s.server_class %> · <%= s.active_streams %> active streams</p><p><%= s.assigned_users||0 %><%= s.max_users?' / '+s.max_users:'' %> managed users</p><div class="subText">Last health check: <%= healthDate&&!Number.isNaN(healthDate.getTime())?healthDate.toLocaleString():'never' %></div></div><% }) %></div></section><section class="section"><div class="sectionHead"><h2>Stream policy events</h2><span class="muted">most recent 60</span></div><% if(!events.length){ %><div class="empty">No stream-policy events recorded.</div><% } else { %><div class="tableWrap"><table class="dataTable"><thead><tr><th>Time</th><th>User</th><th>Decision</th><th>Server</th><th>Reason</th></tr></thead><tbody><% events.forEach(function(e){ %><tr><td><%= new Date(e.created_at).toLocaleString() %></td><td><%= e.customer_name %></td><td><span class="pill"><%= e.decision %></span></td><td><%= e.server_name||'—' %></td><td><%= e.reason %></td></tr><% }) %></tbody></table></div><% } %></section><section class="section"><div class="sectionHead"><h2>Recent playback</h2></div><% if(!history.length){ %><div class="empty">No playback history recorded yet.</div><% } else { %><div class="tableWrap"><table class="dataTable"><thead><tr><th>Started</th><th>User</th><th>Media</th><th>Server</th><th>Method</th><th>Ended</th></tr></thead><tbody><% history.forEach(function(h){ %><tr><td><%= new Date(h.started_at).toLocaleString() %></td><td><%= h.customer_name %></td><td><%= h.item_name||'Unknown item' %></td><td><%= h.server_name %></td><td><%= h.playback_method %></td><td><%= h.ended_at?new Date(h.ended_at).toLocaleString():'Active / recent' %></td></tr><% }) %></tbody></table></div><% } %></section></div></main></div></body></html>