<!doctype html><html lang="en"><head><title>Servers · <%= siteName %></title><%- include('_head') %></head><body><div class="appShell"><%- include('_nav',{siteName,activeNav:'servers'}) %><main class="mainPane"><header class="topBar"><div>Administration</div><a class="button" href="/admin/servers/new">Add server</a></header><div class="content"><div class="pageHeader"><h1>Servers</h1><div class="muted">Managed Jellyfin servers, capacity, placement and health</div></div><% if(message){ %><div class="notice success"><%= message %></div><% } %><% if(error){ %><div class="notice error"><%= error %></div><% } %><% if(!allowedHosts.length){ %><div class="statusBanner warn"><strong>Production write protection:</strong> configure <code>JELLYFIN_ALLOWED_HOSTS</code> before changing Jellyfin base URLs.</div><% } else { %><div class="statusBanner"><strong>Server URL allowlist:</strong> <%= allowedHosts.join(', ') %></div><% } %><section class="section"><div class="sectionHead"><h2>Configured servers</h2><span class="muted"><%= servers.length %> total</span></div><% if(!servers.length){ %><div class="empty">No Jellyfin servers are configured.</div><% } else { %><div class="serverGrid"><% servers.forEach(function(s){ const max=Number(s.max_users||0),used=Number(s.assigned_users||0); const healthDate=s.last_health_check?new Date(s.last_health_check):null; %><div class="serverCard"><div class="serverTop"><div><strong><%= s.name %></strong><div class="subText"><%= s.slug %> · <%= s.server_class %><%= s.location?' · '+s.location:'' %></div></div><span class="pill <%= s.health_status==='healthy'?'good':(s.health_status==='offline'?'bad':'warn') %>"><%= s.health_status %></span></div><div class="serverStats"><div><span class="metricMini"><%= used %><%= max?' / '+max:'' %></span><span class="subText">managed users</span></div><div><span class="metricMini"><%= s.active_streams %></span><span class="subText">active streams</span></div></div><div class="flagRow"><span class="pill <%= s.allow_new_users?'good':'warn' %>"><%= s.allow_new_users?'Placement on':'Draining' %></span><span class="pill <%= s.trial_enabled?'accent':'' %>">Trials <%= s.trial_enabled?'on':'off' %></span><span class="pill <%= s.paid_enabled?'accent':'' %>">Paid <%= s.paid_enabled?'on':'off' %></span></div><div class="subText">Priority <%= s.priority %> · Last health check <%= healthDate&&!Number.isNaN(healthDate.getTime())?healthDate.toLocaleString():'never' %></div><div class="buttonRow cardActions"><a class="button secondary" href="/admin/servers/<%= s.id %>/edit">Manage</a></div></div><% }) %></div><% } %><div class="securityNote">API keys are write-only and never rendered back to the browser.</div></section></div></main></div></body></html>