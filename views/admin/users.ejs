<!doctype html><html lang="en"><head><title>Users · <%= siteName %></title><%- include('_head') %></head><body><div class="appShell"><%- include('_nav',{siteName,activeNav:'users'}) %><main class="mainPane"><header class="topBar"><div>Administration</div><a class="button" href="/admin/users/new">Add customer</a></header><div class="content"><div class="pageHeader"><h1>Users</h1><div class="muted">PostgreSQL customer, subscription and Jellyfin account state</div></div><% if(message){ %><div class="notice success"><%= message %></div><% } %><% if(error){ %><div class="notice error"><%= error %></div><% } %><section class="section"><div class="sectionHead"><h2>Managed users</h2><form method="get" action="/admin/users" class="searchForm"><input class="input compact" name="q" value="<%= search %>" placeholder="Search user, email or Jellyfin name" maxlength="80"><button class="button secondary">Search</button><% if(search){ %><a class="button secondary" href="/admin/users">Clear</a><% } %></form></div><% if(!users.length){ %><div class="empty">No users match this view.</div><% } else { %><div class="tableWrap"><table class="dataTable"><thead><tr><th>User</th><th>Subscription</th><th>Jellyfin</th><th>Last activity</th><th>Portal</th><th></th></tr></thead><tbody><% users.forEach(function(u){ const active=['active','trialing','past_due'].includes(u.subscription_status)&&u.current_period_end&&new Date(u.current_period_end)>new Date(); %><tr><td><div class="mediaTitle"><%= u.display_name||u.login_username||u.email||'Managed customer' %></div><div class="subText"><%= u.email||u.login_username||'No portal identity' %></div></td><td><span class="pill <%= active?'good':(u.subscription_status?'warn':'') %>"><%= u.plan_name||'No plan' %></span><div class="subText"><%= u.subscription_status||'none' %><%= u.current_period_end?' · until '+new Date(u.current_period_end).toLocaleDateString():'' %></div></td><td><%= u.jellyfin_accounts %> account<%= Number(u.jellyfin_accounts)===1?'':'s' %><div class="subText"><%= u.streams?u.streams+' stream plan':'' %></div></td><td><%= u.last_activity_at?new Date(u.last_activity_at).toLocaleString():'—' %></td><td><span class="pill <%= u.login_active===false?'bad':'accent' %>"><%= u.login_username?(u.login_active===false?'Disabled':'Enabled'):'Reseller-managed' %></span></td><td><a class="button secondary" href="/admin/users/<%= u.id %>">Details</a></td></tr><% }) %></tbody></table></div><% } %><div class="securityNote">Passwords, payment payloads, network endpoints and raw session identifiers are never shown here.</div></section></div></main></div></body></html>