<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Users · <%= siteName %></title>
  <link rel="stylesheet" href="/css/platform-shell.css">
</head>
<body>
<div class="appShell">
  <aside class="sideNav">
    <div class="brand"><%= siteName %></div>
    <div class="navSection">Server</div>
    <a class="navItem" href="/admin">Dashboard</a>
    <a class="navItem" href="/admin/activity">Activity</a>
    <a class="navItem active" href="/admin/users">Users</a>
    <a class="navItem" href="/admin/servers">Servers</a>
    <span class="navItem disabled">Libraries</span>
    <div class="navSection">Business</div>
    <span class="navItem disabled">Plans</span>
    <span class="navItem disabled">Payments</span>
    <span class="navItem disabled">Resellers</span>
    <span class="navItem disabled">Requests</span>
    <div class="navSection">System</div>
    <span class="navItem disabled">Notifications</span>
    <a class="navItem" href="/admin/security">Security</a>
    <span class="navItem disabled">Settings</span>
  </aside>
  <main class="mainPane">
    <header class="topBar"><div>Administration</div><div class="muted"><%= users.length %> managed users shown</div></header>
    <div class="content">
      <div class="pageHeader"><h1>Users</h1><div class="muted">PostgreSQL customer, subscription and Jellyfin account state</div></div>
      <% if (message) { %><div class="notice success"><%= message %></div><% } %>
      <% if (error) { %><div class="notice error"><%= error %></div><% } %>
      <section class="section">
        <div class="sectionHead"><h2>Managed users</h2><form method="get" action="/admin/users" class="searchForm"><input class="input compact" name="q" value="<%= search %>" placeholder="Search user, email or Jellyfin name" maxlength="80"><button class="button secondary" type="submit">Search</button><% if (search) { %><a class="button secondary" href="/admin/users">Clear</a><% } %></form></div>
        <% if (!users.length) { %><div class="empty">No users match this view.</div><% } else { %>
        <div class="tableWrap"><table class="dataTable">
          <thead><tr><th>User</th><th>Subscription</th><th>Jellyfin</th><th>Last activity</th><th>Portal</th><th></th></tr></thead>
          <tbody>
          <% users.forEach(function(u){ const active=['active','trialing','past_due'].includes(u.subscription_status) && u.current_period_end && new Date(u.current_period_end)>new Date(); %>
            <tr>
              <td><div class="mediaTitle"><%= u.display_name || u.login_username || u.email || 'Managed customer' %></div><div class="subText"><%= u.email || u.login_username || 'No portal identity' %></div></td>
              <td><span class="pill <%= active ? 'good' : (u.subscription_status ? 'warn' : '') %>"><%= u.plan_name || 'No plan' %></span><div class="subText"><%= u.subscription_status || 'none' %><%= u.current_period_end ? ' · until '+new Date(u.current_period_end).toLocaleDateString() : '' %></div></td>
              <td><%= u.jellyfin_accounts %> account<%= Number(u.jellyfin_accounts)===1?'':'s' %><div class="subText"><%= u.streams ? u.streams+' stream plan' : '' %></div></td>
              <td><%= u.last_activity_at ? new Date(u.last_activity_at).toLocaleString() : '—' %></td>
              <td><span class="pill <%= u.login_active === false ? 'bad' : 'accent' %>"><%= u.login_username ? (u.login_active === false ? 'Disabled' : 'Enabled') : 'Reseller-managed' %></span></td>
              <td><a class="button secondary" href="/admin/users/<%= u.id %>">Details</a></td>
            </tr>
          <% }) %>
          </tbody>
        </table></div>
        <% } %>
        <div class="securityNote">This page does not expose passwords, payment payloads, network endpoints or raw session identifiers.</div>
      </section>
    </div>
  </main>
</div>
</body>
</html>
