<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Security · <%= siteName %></title><link rel="stylesheet" href="/css/platform-shell.css"></head>
<body><div class="appShell"><aside class="sideNav"><div class="brand"><%= siteName %></div><div class="navSection">Server</div><a class="navItem" href="/admin">Dashboard</a><a class="navItem" href="/admin/activity">Activity</a><span class="navItem disabled">Users</span><span class="navItem disabled">Servers</span><span class="navItem disabled">Libraries</span><div class="navSection">Business</div><span class="navItem disabled">Plans</span><span class="navItem disabled">Payments</span><span class="navItem disabled">Resellers</span><span class="navItem disabled">Requests</span><div class="navSection">System</div><span class="navItem disabled">Notifications</span><a class="navItem active" href="/admin/security">Security</a><span class="navItem disabled">Settings</span></aside><main class="mainPane"><header class="topBar"><div>Administration</div><a class="muted" href="/logout">Sign out</a></header><div class="content"><div class="pageHeader"><h1>Security</h1><div class="muted">Administrator authentication and session controls</div></div><% if (message) { %><div class="notice success"><%= message %></div><% } %><% if (error) { %><div class="notice error"><%= error %></div><% } %><div class="metrics"><div class="metric"><div class="metricLabel">2FA</div><div class="metricValue"><%= user.totp_enabled ? 'On' : 'Off' %></div></div><div class="metric"><div class="metricLabel">Recovery codes</div><div class="metricValue"><%= recoveryCodesRemaining %></div></div><div class="metric"><div class="metricLabel">Active sessions</div><div class="metricValue"><%= sessions.filter(s => !s.revokedAt).length %></div></div><div class="metric"><div class="metricLabel">Failed attempts</div><div class="metricValue"><%= user.failed_login_count || 0 %></div></div></div><div class="statusBanner <%= user.totp_enabled ? '' : 'warn' %>"><strong>Administrator 2FA:</strong> <%= admin2faRequired ? 'required' : 'optional' %>. Account status: <%= user.totp_enabled ? 'enrolled' : 'not enrolled' %>.</div><section class="section"><div class="sectionHead"><h2>Sessions</h2><form method="post" action="/admin/security/sessions/revoke-others"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary" type="submit">Sign out other sessions</button></form></div><div class="tableWrap"><table class="dataTable"><thead><tr><th>Session</th><th>Created</th><th>Last seen</th><th>Expires</th><th>Status</th></tr></thead><tbody><% sessions.forEach(function(s){ %><tr><td><%= s.isCurrent ? 'Current session' : 'Browser ' + s.fingerprint %></td><td><%= new Date(s.createdAt).toLocaleString() %></td><td><%= new Date(s.lastSeenAt).toLocaleString() %></td><td><%= new Date(s.expiresAt).toLocaleString() %></td><td><span class="pill <%= s.revokedAt ? 'bad' : s.isCurrent ? 'accent' : 'good' %>"><%= s.revokedAt ? 'Revoked' : s.isCurrent ? 'Current' : 'Active' %></span></td></tr><% }) %></tbody></table></div><div class="securityNote">Full session identifiers and network endpoints are not displayed.</div></section><section class="section"><div class="sectionHead"><h2>Account controls</h2></div><div class="formPanel"><p><a class="button" href="/admin/security/password">Change password</a></p><p><a class="button secondary" href="/admin/security/recovery">Recovery codes</a></p></div></section><section class="section"><div class="sectionHead"><h2>Recent authentication events</h2></div><div class="tableWrap"><table class="dataTable"><thead><tr><th>Time</th><th>Event</th><th>Result</th></tr></thead><tbody><% events.forEach(function(e){ %><tr><td><%= new Date(e.created_at).toLocaleString() %></td><td><%= e.event_type %></td><td><span class="pill <%= e.success ? 'good' : 'bad' %>"><%= e.success ? 'Success' : 'Denied' %></span></td></tr><% }) %></tbody></table></div></section></div></main></div></body></html>