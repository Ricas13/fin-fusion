<%
  // Compatibility partial for EJS pages. Navigation data comes from the same
  // src/platform/admin-nav.js registry used by admin-html, exposed through
  // application locals so the two renderers cannot drift again.
  const navGroups = Array.isArray(adminNavGroups) ? adminNavGroups : [];
  const currentKey = typeof adminNavActiveKey === 'function' ? adminNavActiveKey(activeNav) : (activeNav || 'dashboard');
  const currentGroup = navGroups.find(group => group.pages.some(page => page[0] === currentKey)) || navGroups[0];
  const iconPaths = {
    dashboard:'<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10.5V20h13v-9.5"/><path d="M9.5 20v-6h5v6"/>',
    people:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    servers:'<rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M7 7h.01M7 17h.01"/>',
    commerce:'<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h2"/>',
    automation:'<path d="M18 8a6 6 0 1 0 1.76 4.24"/><path d="M18 3v5h5"/><path d="m13 9-3 4h4l-3 4"/>',
    settings:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21h-4v-.09A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3v-4h.09A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.09A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06-.06A1.7 1.7 0 0 0 19.4 9c.2.37.52.68.9.87.33.16.7.24 1.06.23H21v4h-.09A1.7 1.7 0 0 0 19.4 15Z"/>'
  };
%>
<header class="adminHeader">
  <div class="headerMain"><a class="brandBlock" href="/admin"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandText"><%= siteName %></div><div class="brandSub">Administration</div></div></a></div>
  <div class="adminTabsWrap"><nav class="adminTabs" aria-label="Administration"><% navGroups.forEach(function(group){ const isActive=currentGroup&&currentGroup.key===group.key; %><div class="navGroup"><a class="adminTab <%= isActive?'active':'' %>" href="<%= group.pages[0][2] %>"><span class="navIcon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- iconPaths[group.key]||iconPaths.dashboard %></svg></span><span><%= group.label %></span></a><% if(isActive && group.pages.length>1){ %><div class="adminSubTabs"><% group.pages.forEach(function(child){ %><a class="adminSubTab <%= currentKey===child[0]?'active':'' %>" href="<%= child[2] %>"><%= child[1] %></a><% }); %></div><% } %></div><% }); %></nav></div>
  <div class="headerActions"><a class="headerButton hideMobile" href="/" target="_blank" rel="noopener noreferrer">Open Store</a><a class="headerButton" href="/admin/security">Security</a><a class="headerButton danger" href="/logout">Sign out</a></div>
</header>