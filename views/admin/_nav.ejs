    ['servers','Servers','/admin/servers','<rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M7 7h.01M7 17h.01"/>', [['servers','Servers','/admin/servers'],['libraries','Libraries','/admin/libraries']]],
    ['commerce','Commerce','/admin/commerce','<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h2"/>', [['commerce-overview','Overview','/admin/commerce'],['plans','Plans','/admin/plans'],['reseller-tiers','Reseller Plans','/admin/reseller-tiers'],['payments','Payments','/admin/payments'],['payment-reconciliation','Reconciliation','/admin/commerce/reconciliation'],['billing','Billing','/admin/billing'],['discounts','Discounts','/admin/discounts'],['referrals','Referrals','/admin/referrals']]],
