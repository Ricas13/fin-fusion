<!doctype html>
<html lang="en">
<head><title>Change password · <%= siteName %></title><%- include('_head') %></head>
<body>
<div class="appShell">
  <%- include('_nav',{siteName,activeNav:'security'}) %>
  <main class="mainPane">
    <header class="topBar"><div class="topBreadcrumb"><span>My account</span><span>Security</span><strong>Change password</strong></div></header>
    <div class="content">
      <div class="pageHeader"><div><h1>Change administrator password</h1><div class="pageSubtitle">Changing the password signs out every other staff session.</div></div></div>
      <section class="section">
        <div class="formPanel">
          <form method="post" action="/admin/security/password">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="formGroup"><label>Current password</label><input class="input" type="password" name="currentPassword" autocomplete="current-password" required></div>
            <div class="formGroup"><label>New password</label><input class="input" type="password" name="newPassword" autocomplete="new-password" minlength="8" maxlength="200" required></div>
            <div class="formGroup"><label>Confirm new password</label><input class="input" type="password" name="confirmPassword" autocomplete="new-password" minlength="8" maxlength="200" required></div>
            <div class="buttonRow"><button class="button" type="submit">Change password</button><a class="button secondary" href="/admin/security">Cancel</a></div>
          </form>
        </div>
      </section>
    </div>
  </main>
</div>
</body>
</html>
