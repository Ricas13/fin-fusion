<meta name="color-scheme" content="dark">
<style>
*{box-sizing:border-box}:root{--bg:#0c1117;--sidebar:#10151c;--border:#222933;--text:#d9e0e8;--muted:#8390a2;--accent:#20a9d6;--sidebar-w:208px}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text)}body{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:13px}.appShell{min-height:100vh;background:var(--bg)}.adminHeader{position:fixed;inset:0 auto 0 0;width:var(--sidebar-w);z-index:110;background:var(--sidebar);border-right:1px solid var(--border);display:flex;flex-direction:column}.headerMain{padding:14px 13px 10px}.brandBlock{display:flex;align-items:center;gap:10px;text-decoration:none}.brandLogo{width:30px;height:30px;border-radius:7px;object-fit:cover}.brandText{font-size:14px;font-weight:800;color:#f1f5f9}.brandSub{font-size:10px;color:#667386}.adminTabsWrap{flex:1;overflow:auto;padding:4px 0 132px}.adminTabs{display:flex;flex-direction:column;gap:2px;padding:0 8px}.adminTab{display:flex;align-items:center;gap:9px;min-height:34px;padding:7px 10px;border-radius:6px;color:#a2adba;text-decoration:none;font-weight:600;font-size:12px}.adminTab:before{content:"";width:7px;height:7px;border:1px solid #687687;border-radius:2px}.adminTab.active{color:#fff;background:rgba(32,169,214,.13);box-shadow:inset 2px 0 0 var(--accent)}.tabGroupBreak{height:1px;background:var(--border);margin:6px 8px}.headerActions{position:absolute;left:9px;right:9px;bottom:10px;display:grid;gap:5px}.headerButton{display:flex;padding:6px 9px;color:#8f9bad;text-decoration:none;font-size:11px}.mainPane{min-height:100vh;margin-left:var(--sidebar-w);background:var(--bg)}.topBar{position:sticky;top:0;z-index:95;height:52px;margin:0;padding:0 22px;display:flex;align-items:center;justify-content:space-between;background:#10151c;border-bottom:1px solid var(--border)}.content{padding:21px 24px 42px}.pageHeader{margin-bottom:16px}.pageHeader h1{margin:0 0 3px;font-size:21px;color:#f1f5f9}.muted{color:var(--muted)}@media(max-width:760px){:root{--sidebar-w:0px}.adminHeader{position:static;width:100%}.adminTabs{flex-direction:row;min-width:max-content}.adminTabsWrap{padding:0;overflow-x:auto}.headerActions{display:none}.mainPane{margin-left:0}}
</style>
