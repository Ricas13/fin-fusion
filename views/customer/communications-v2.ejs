<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Communications · <%= siteName %></title><style>body{margin:0;background:#0b1118;color:#e7edf4;font-family:Inter,system-ui,sans-serif}.wrap{max-width:1050px;margin:auto;padding:38px 20px 70px}.top,.currency{display:flex;justify-content:space-between;gap:16px;align-items:center}.card{background:#121a23;border:1px solid #273441;border-radius:12px;padding:18px;margin:14px 0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.muted{color:#8f9eae;font-size:13px;line-height:1.5}.button{display:inline-flex;padding:10px 14px;border:1px solid #2c3a49;border-radius:8px;color:#dbe7f0;text-decoration:none;background:#121b24;font-weight:700;cursor:pointer}.primary{background:#0f5068}.input{box-sizing:border-box;padding:10px;border-radius:8px;border:1px solid #334353;background:#0d141c;color:#fff}.notice,.error{padding:12px;border-radius:8px;margin:12px 0}.notice{background:#102833}.error{background:#32171d}.status{font-size:12px;font-weight:800}.good{color:#54dda0}.warn{color:#f6bd62}.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.events{width:100%;border-collapse:collapse}.events th,.events td{padding:10px;border-bottom:1px solid #26333f;text-align:left}.events th:not(:first-child),.events td:not(:first-child){text-align:center}.desc{font-size:12px;color:#8998a8;margin-top:3px}.disabled{opacity:.4}@media(max-width:760px){.grid{grid-template-columns:1fr}.top,.currency{align-items:flex-start;flex-direction:column}}</style></head><body><main class="wrap"><div class="top"><div><h1>Communications & notifications</h1><p class="muted">Email remains the required account and payment safety channel. Optional messaging is controlled per event.</p></div><a class="button" href="/account">Back to account</a></div><% if(message){ %><div class="notice"><%= message %></div><% } %><% if(error){ %><div class="error"><%= error %></div><% } %><section class="card currency"><div><h2>Display currency</h2><p class="muted">Used for plan/storefront display only. Existing payment contracts keep their original amount and currency.</p></div><form method="post" action="/account/communications/currency"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="input" name="currency"><% enabledCurrencies.forEach(function(c){ %><option value="<%= c %>" <%= currency===c?'selected':'' %>><%= c %></option><% }) %></select> <button class="button primary">Save</button></form></section><div class="grid"><section class="card"><h2>Telegram</h2><% if(prefs.telegram_chat_id){ %><div class="status good">Connected<%= prefs.telegram_handle?` · @${prefs.telegram_handle}`:'' %></div><p class="muted">Private bot chat verified.</p><form method="post" action="/account/communications/telegram/unlink"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button">Disconnect</button></form><% } else { %><div class="status warn"><%= status.telegramConfigured?'Not connected':'Bot unavailable' %></div><% if(status.telegramConfigured){ %><form method="post" action="/account/communications/telegram/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary">Connect Telegram</button></form><% } %><% } %></section><section class="card"><h2>Discord</h2><% if(prefs.discord_user_id){ %><div class="status good">Connected<%= prefs.discord_handle?` · ${prefs.discord_handle}`:'' %></div><p class="muted">Verified Discord identity linked for bot DMs.</p><form method="post" action="/account/communications/discord/unlink"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button">Disconnect</button></form><% } else { %><div class="status warn"><%= status.discordConfigured?'Not connected':'Bot unavailable' %></div><% if(status.discordConfigured){ %><form method="post" action="/account/communications/discord/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary">Connect Discord</button></form><% } %><% } %></section><section class="card"><h2>WhatsApp</h2><div class="status <%= prefs.whatsapp_opt_in?'good':'warn' %>"><%= prefs.whatsapp_opt_in?'Enabled':'Not enabled' %></div><form method="post" action="/account/communications/whatsapp"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="input" name="phone" value="<%= prefs.phone_e164||'' %>" placeholder="+447700900123"><label><input type="checkbox" name="enabled" value="1" <%= prefs.whatsapp_opt_in?'checked':'' %>> Enable optional WhatsApp messages</label><div class="row"><button class="button primary">Save</button></div></form></section></div><section class="card"><h2>Notification events</h2><p class="muted">This list contains only customer-facing events permitted globally. Server, reseller, provisioning-internal and security events are not exposed.</p><form method="post" action="/account/communications/events"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div style="overflow:auto"><table class="events"><thead><tr><th>Event</th><th>Telegram</th><th>Discord</th><th>WhatsApp</th></tr></thead><tbody><% events.forEach(function(event){const selected=eventPreferences[event.event_type]||{}; %><tr><td><strong><%= event.display_name %></strong><div class="desc"><%= event.description %></div></td><td class="<%= event.telegram_enabled?'':'disabled' %>"><input type="checkbox" name="telegram__<%= event.event_type %>" <%= selected.telegram?'checked':'' %> <%= event.telegram_enabled?'':'disabled' %>></td><td class="<%= event.discord_enabled?'':'disabled' %>"><input type="checkbox" name="discord__<%= event.event_type %>" <%= selected.discord?'checked':'' %> <%= event.discord_enabled?'':'disabled' %>></td><td class="<%= event.whatsapp_enabled?'':'disabled' %>"><input type="checkbox" name="whatsapp__<%= event.event_type %>" <%= selected.whatsapp?'checked':'' %> <%= event.whatsapp_enabled?'':'disabled' %>></td></tr><% }) %></tbody></table></div><div class="row"><button class="button primary">Save notification choices</button></div></form></section><section class="card"><strong>Email cannot be disabled for critical account/payment events.</strong><p class="muted">Customer-specific Telegram and Discord messages never fall back to an administrator destination.</p></section></main></body></html>