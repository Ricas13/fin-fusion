<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title>Ticket #<%= ticket.ticket_number %> · <%= siteName %></title><link rel="icon" href="/branding/favicon"><link rel="stylesheet" href="/css/customer-portal.css"><link rel="stylesheet" href="/css/customer-dashboard.css"><link rel="stylesheet" href="/css/customer-navigation.css"></head>
<body><div class="portalShell"><header class="portalTopbar"><div class="portalTopbarInner"><a class="brandLockup" href="/account"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= siteName %></div><div class="brandMeta">My account</div></div></a><div class="portalActions"><a class="button ghost small" href="/account/support">All tickets</a></div></div></header><div class="customerLayout"><aside class="customerSidebar" aria-label="Customer navigation"><div class="customerNavTitle">My account</div><%- include('_nav',{active:'support'}) %></aside><main class="portalMain">
<% if(message){ %><div class="notice success"><%= message %></div><% } %><% if(error){ %><div class="notice error"><%= error %></div><% } %>
<section class="accountHero simpleHero"><div><div class="eyebrow">Ticket #<%= ticket.ticket_number %> · <%= ticket.category %></div><h1><%= ticket.subject %></h1><p>Status: <strong><%= ticket.status.replaceAll('_',' ') %></strong></p></div></section>
<section class="sectionBlock"><div class="sectionHead"><div><h2>Conversation</h2><p>Messages between you and support.</p></div></div><div style="display:grid;gap:12px"><% messages.forEach(function(m){ %><article class="accessCard simpleAccessCard" style="margin-left:<%= m.author_kind==='customer'?'7%':'0' %>;margin-right:<%= m.author_kind==='admin'?'7%':'0' %>"><div class="accessTop"><strong><%= m.author_kind==='admin'?'Support':'You' %></strong><span class="accessMeta"><%= new Date(m.created_at).toLocaleString('en-GB',{dateStyle:'medium',timeStyle:'short'}) %></span></div><p style="white-space:pre-wrap"><%= m.body %></p></article><% }) %></div></section>
<% if(ticket.status!=='closed'){ %><section class="sectionBlock"><div class="sectionHead"><div><h2>Reply</h2></div></div><form method="post" action="/account/support/<%= ticket.id %>/reply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><textarea class="input" name="message" rows="6" maxlength="10000" required></textarea></div><button class="button primary" type="submit">Send reply</button></form></section><% } else { %><div class="notice">This ticket is closed. Open a new ticket if you need more help.</div><% } %>
</main></div></div></body></html>
