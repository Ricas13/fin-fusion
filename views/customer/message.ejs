<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> · <%= siteName %></title>
  <style>
    :root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,sans-serif;background:radial-gradient(circle at top,#102235 0,#0b1220 42%,#09101b 100%);color:#e5e7eb;min-height:100vh;display:grid;place-items:center;padding:28px}.card{width:min(520px,100%);background:#111827;border:1px solid #263244;border-radius:18px;padding:28px;box-shadow:0 20px 60px #0007;text-align:center}.icon{width:54px;height:54px;margin:0 auto 14px;border-radius:50%;display:grid;place-items:center;background:#13233c;border:1px solid #245680;color:#7dd3fc;font-size:25px}h1{margin:0 0 10px;font-size:28px}.lead{color:#a8b4c5;line-height:1.55;margin:0 auto;max-width:430px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:22px 0;text-align:left}.step{border:1px solid #263244;background:#0d1521;border-radius:10px;padding:9px 10px;color:#7f8da0;font-size:11px}.step strong{display:block;color:#cbd5e1;font-size:12px;margin-bottom:2px}.step.done{border-color:#285943;background:#10251c}.step.done strong{color:#86efac}.step.active{border-color:#256c78;background:#10252d}.step.active strong{color:#67e8f9}a{color:#7dd3fc}.muted{color:#8492a6;font-size:12px;line-height:1.45}@media(max-width:520px){.card{padding:22px}.steps{grid-template-columns:1fr}.step:not(.active){display:none}h1{font-size:25px}}
  </style>
</head>
<body>
  <% const checkingEmail = String(title||'').toLowerCase() === 'check your email'; %>
  <main class="card">
    <div class="icon" aria-hidden="true"><%= checkingEmail ? '✉' : '✓' %></div>
    <h1><%= title %></h1>
    <p class="lead"><%= message %></p>
    <% if (checkingEmail) { %>
      <div class="steps" aria-label="Signup progress"><div class="step done"><strong>1 · Account</strong>Details submitted</div><div class="step active"><strong>2 · Verify</strong>Open the email we sent</div><div class="step"><strong>3 · Access</strong>Continue automatically</div></div>
      <p class="muted">You do not need to register or sign in again. Open the verification email, confirm once, and we will sign you in automatically.</p>
    <% } else { %>
      <p style="margin-top:20px"><a href="/account/login">Customer sign in</a></p>
    <% } %>
  </main>
</body>
</html>
