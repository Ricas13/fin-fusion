<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title>Stremio setup · <%= siteName %></title><link rel="icon" href="/branding/favicon"><link rel="stylesheet" href="/css/customer-portal.css"><link rel="stylesheet" href="/css/customer-navigation.css"></head>
<body><main class="customerPortalPage">
  <%- include('_nav',{active:'streaming'}) %>
  <div class="customerPortalPageHeader"><div><h1>Set up Stremio</h1><p>Create one private link, install CAPTAiNFiN in Stremio, then play on any of your household devices.</p></div><a class="button secondary" href="/account#streaming">Back to streaming</a></div>
  <% if (message) { %><div class="notice success"><%= message %></div><% } %>
  <% if (error) { %><div class="notice error"><%= error %></div><% } %>
  <% if (!eligible) { %><div class="notice warn">Your current plan does not include Stremio.</div><% } else if (!runtimeReady) { %><div class="notice warn">Stremio is temporarily unavailable. You do not need to change anything; try again later or contact support.</div><% } %>
  <section class="panel">
    <div class="sectionHead"><div><h2>Your Stremio link</h2><p>The link is private to your household. It does not contain your CAPTAiNFiN or Jellyfin password.</p></div><span class="pill <%= status==='active'?'good':status==='pending'?'warn':'' %>"><%= status==='active'?'Ready':status==='revoked'?'Revoked':'Not installed' %></span></div>
    <% if (credential && manifestUrl) { %><div class="notice success"><strong>Your private link is ready.</strong> Install it in Stremio now. If you create another link later, this one will stop working.</div><div class="field"><label>Private installation link</label><input class="input" type="text" readonly value="<%= manifestUrl %>" aria-describedby="stremio-link-help"><div class="muted" id="stremio-link-help">Keep this link private. If you lose it, simply create a new one.</div></div><p><a class="button primary" href="<%= stremioUrl %>">Install in Stremio</a></p><% } %>
    <% if (eligible && runtimeReady) { %><div class="overviewGrid"><article class="metricCard"><div class="metricLabel">Your plan</div><div class="metricValue"><%= accessModel %></div><div class="metricSub">Each household connection is one home or internet connection. Devices and simultaneous streams within it are unlimited.</div></article><article class="metricCard"><div class="metricLabel">Stremio</div><div class="metricValue"><%= status==='active'?'Ready':status==='revoked'?'Revoked':'Not installed' %></div><div class="metricSub"><%= status==='active'?'Your private installation is active':'Create your private link to get started' %></div></article></div><div class="heroActions"><form method="post" action="/account/stremio/install"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary"><%= status==='active'?'Create a new installation link':'Create installation link' %></button></form><% if (status==='active') { %><form method="post" action="/account/stremio/reset-household"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary" <%= replacementState && !replacementState.allowed ? 'disabled' : '' %>>Use a different household connection</button></form><% if (replacementState && !replacementState.allowed) { %><span class="muted">You can change household connection again after the replacement cooldown.</span><% } %></div><details class="stremioLinkOptions"><summary>More installation options</summary><div class="stremioLinkOptionsBody"><p class="muted">Revoking the link removes this Stremio installation. You can create a new link at any time.</p><form method="post" action="/account/stremio/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary">Revoke installation link</button></form></div></details><% } else { %></div><% } %><% } %>
  </section>
  <section class="sectionBlock"><div class="sectionHead"><div><h2>Three steps to watch</h2><p>You only need to do this once unless you replace your private link.</p></div></div><div class="plansGrid"><article class="planCard"><div class="planName">1. Create your link</div><div class="planDescription">Create the private Stremio link above. It belongs to your household, so do not share it publicly.</div></article><article class="planCard"><div class="planName">2. Install CAPTAiNFiN</div><div class="planDescription">Open the link in Stremio and install CAPTAiNFiN. You can use the same installation on your household devices.</div></article><article class="planCard"><div class="planName">3. Pick a result</div><div class="planDescription">Open a movie or episode and choose a CAPTAiNFiN result. If your plan's household connections are already in use, Stremio will tell you what to do.</div></article></div></section>
</main><style>.stremioLinkOptions{margin-top:14px;border-top:1px solid var(--border,#2b3440);padding-top:10px}.stremioLinkOptions summary{cursor:pointer;font-weight:700}.stremioLinkOptionsBody{display:grid;gap:9px;padding-top:9px}.stremioLinkOptionsBody p{margin:0}</style></body></html>