<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title>Stremio setup · <%= siteName %></title><link rel="icon" href="/branding/favicon"><link rel="stylesheet" href="/css/customer-portal.css"><link rel="stylesheet" href="/css/customer-navigation.css"></head>
<body><main class="customerPortalPage">
  <%- include('_nav',{active:'streaming'}) %>
  <div class="customerPortalPageHeader"><div><h1>Stremio setup</h1><p>Create or replace the private installation link for your account.</p></div><a class="button secondary" href="/account#streaming">Back to streaming</a></div>
  <% if (message) { %><div class="notice success"><%= message %></div><% } %>
  <% if (error) { %><div class="notice error"><%= error %></div><% } %>
  <% if (!eligible) { %><div class="notice warn">Your current plan does not include Stremio.</div><% } else if (!runtimeReady) { %><div class="notice warn">Stremio is temporarily unavailable. You do not need to change anything; try again later or contact support.</div><% } %>
  <section class="panel">
    <div class="sectionHead"><div><h2>Your installation</h2><p>This link belongs only to your account. Your portal and Jellyfin passwords are never included in it.</p></div><span class="pill <%= status==='active'?'good':status==='pending'?'warn':'' %>"><%= status==='active'?'Ready':status==='revoked'?'Revoked':'Not installed' %></span></div>
    <% if (credential && manifestUrl) { %><div class="notice success"><strong>Installation link created.</strong> Use it now. For security, the full private link is only shown at creation time; if you lose it, create a new one.</div><div class="field"><label>Private installation link</label><input class="input" type="text" readonly value="<%= manifestUrl %>"></div><p><a class="button primary" href="<%= stremioUrl %>">Install in Stremio</a></p><% } %>
    <% if (eligible && runtimeReady) { %><div class="overviewGrid"><article class="metricCard"><div class="metricLabel">Concurrent streams</div><div class="metricValue"><%= streamLimit %></div><div class="metricSub">Your plan allowance</div></article><article class="metricCard"><div class="metricLabel">Installation</div><div class="metricValue"><%= status==='active'?'Ready':status==='revoked'?'Revoked':'Not installed' %></div><div class="metricSub"><%= status==='active'?'Working private link':'Create a link below' %></div></article></div><div class="heroActions"><form method="post" action="/account/stremio/install"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary"><%= status==='active'?'Create a new installation link':'Create installation link' %></button></form><% if (status==='active') { %><form method="post" action="/account/stremio/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary">Revoke current link</button></form><% } %></div><% } %>
  </section>
  <section class="sectionBlock"><div class="sectionHead"><div><h2>How to use it</h2><p>Three steps from your account to playback.</p></div></div><div class="plansGrid"><article class="planCard"><div class="planName">1. Create</div><div class="planDescription">Create your private installation link above.</div></article><article class="planCard"><div class="planName">2. Install</div><div class="planDescription">Open the link in Stremio and add CAPTAiNFiN.</div></article><article class="planCard"><div class="planName">3. Play</div><div class="planDescription">Choose a movie or episode in Stremio and use your available CAPTAiNFiN stream.</div></article></div></section>
</main></body></html>
