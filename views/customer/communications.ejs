<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Communication preferences · <%= siteName %></title><style>
body{margin:0;background:#0b1118;color:#e7edf4;font-family:Inter,system-ui,sans-serif;min-height:100vh}.wrap{max-width:900px;margin:0 auto;padding:38px 20px 70px}.top{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:26px}.top a,.button{display:inline-flex;align-items:center;justify-content:center;padding:10px 14px;border:1px solid #2c3a49;border-radius:8px;color:#dbe7f0;text-decoration:none;background:#121b24;font-weight:700;cursor:pointer}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.card{background:#121a23;border:1px solid #273441;border-radius:12px;padding:18px}.card h2{margin:0 0 8px}.muted{color:#8f9eae;font-size:13px;line-height:1.5}.good{color:#54dda0}.warn{color:#f6bd62}.notice,.error{padding:12px 14px;border-radius:9px;margin:12px 0}.notice{border:1px solid #26566a;background:#102833}.error{border:1px solid #773943;background:#32171d}.input{width:100%;box-sizing:border-box;padding:10px;border-radius:8px;border:1px solid #334353;background:#0d141c;color:#fff;margin:8px 0}.button.primary{background:#0f5068;border-color:#2585a7}.button.danger{color:#ffb4bc}.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px}.row form{margin:0}.check{display:flex;align-items:flex-start;gap:8px;margin:10px 0}.check input{margin-top:3px}.status{font-size:12px;font-weight:800;margin:8px 0}.why{margin-top:28px;padding:16px;border:1px solid #273441;border-radius:10px;color:#9eacba}@media(max-width:760px){.grid{grid-template-columns:1fr}}
</style></head><body><main class="wrap"><div class="top"><div><h1>How should we contact you?</h1><div class="muted">Email remains the required account and payment channel. Choose any optional messaging channels you want for reminders and service updates.</div></div><a href="/account">Back to account</a></div>
<% if (welcome) { %><div class="notice"><strong>Finish your messaging choices.</strong> Connect the channels you selected during registration, or choose “Don't use” to continue without them.</div><% } %>
<% if (message) { %><div class="notice"><%= message %></div><% } %><% if (error) { %><div class="error"><%= error %></div><% } %>
<div class="grid">
<section class="card"><h2>Telegram</h2><% if (prefs.telegram_chat_id) { %><div class="status good">Connected<%= prefs.telegram_handle ? ` · @${prefs.telegram_handle}` : '' %></div><p class="muted">CAPTaINFiN can send messages directly to your private bot chat.</p><form method="post" action="/account/communications/telegram/unlink"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button danger">Disconnect</button></form><% } else { %><div class="status <%= status.telegramConfigured ? 'warn' : '' %>"><%= status.telegramConfigured ? 'Not connected' : 'Bot unavailable' %></div><p class="muted">Connect by opening the CAPTaINFiN Telegram bot and pressing Start. The one-time link expires automatically.</p><div class="row"><% if (status.telegramConfigured) { %><form method="post" action="/account/communications/telegram/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary" type="submit">Connect Telegram</button></form><% } %><% if (prefs.telegram_opt_in) { %><form method="post" action="/account/communications/telegram/unlink"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button" type="submit">Don't use Telegram</button></form><% } %></div><% } %></section>
<section class="card"><h2>Discord</h2><% if (prefs.discord_user_id) { %><div class="status good">Connected<%= prefs.discord_handle ? ` · ${prefs.discord_handle}` : '' %></div><p class="muted">Your verified Discord user ID is linked. The CAPTaINFiN bot can open a DM when Discord permits it.</p><form method="post" action="/account/communications/discord/unlink"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button danger">Disconnect</button></form><% } else { %><div class="status <%= status.discordConfigured ? 'warn' : '' %>"><%= status.discordConfigured ? 'Not connected' : 'Bot unavailable' %></div><p class="muted">Connect with Discord OAuth so we store your real Discord user ID instead of trusting a typed username.</p><div class="row"><% if (status.discordConfigured) { %><form method="post" action="/account/communications/discord/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary" type="submit">Connect Discord</button></form><% } %><% if (prefs.discord_opt_in) { %><form method="post" action="/account/communications/discord/unlink"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button" type="submit">Don't use Discord</button></form><% } %></div><% } %></section>
<section class="card"><h2>WhatsApp</h2><div class="status <%= prefs.whatsapp_opt_in ? 'good' : 'warn' %>"><%= prefs.whatsapp_opt_in ? 'Enabled' : 'Not enabled' %></div><p class="muted">Enter the mobile number attached to WhatsApp in international format.</p><form method="post" action="/account/communications/whatsapp"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="input" name="phone" autocomplete="tel" value="<%= prefs.phone_e164 || '' %>" placeholder="+447700900123"><label class="check"><input type="checkbox" name="enabled" value="1" <%= prefs.whatsapp_opt_in ? 'checked' : '' %>><span>Send optional WhatsApp messages to this number</span></label><button class="button primary">Save WhatsApp</button></form></section>
</div><div class="why"><strong>Email cannot be turned off for critical account messages.</strong> Messaging apps are secondary channels. Disconnecting one here stops CAPTaINFiN using it without deleting your portal account.</div></main></body></html>
