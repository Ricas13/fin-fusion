<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Notifications · <%= siteName %></title>
  <link rel="icon" href="/branding/favicon">
  <link rel="stylesheet" href="/css/customer-portal.css">
  <link rel="stylesheet" href="/css/customer-dashboard.css">
  <link rel="stylesheet" href="/css/customer-navigation.css">
  <style>
    .notifyGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    .notifyRow{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
    .notifyEvents{width:100%;border-collapse:collapse}
    .notifyEvents th,.notifyEvents td{padding:10px;border-bottom:1px solid var(--line);text-align:left}
    .notifyEvents th:not(:first-child),.notifyEvents td:not(:first-child){text-align:center}
    .notifyDisabled{opacity:.4}
    @media(max-width:760px){.notifyGrid{grid-template-columns:1fr}}
  </style>
</head>
<body><div class="portalShell">
<header class="portalTopbar"><div class="portalTopbarInner"><a class="brandLockup" href="/account"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= siteName %></div><div class="brandMeta">My account</div></div></a><div class="portalActions"><a class="button ghost small" href="/account">Home</a></div></div></header>
<main class="customerPortalPage">
  <%- include('_nav',{active:'notifications'}) %>
  <div class="customerPortalPageHeader">
    <div><h1>Notifications</h1><p>Choose where optional updates reach you. Important account and payment email cannot be switched off.</p></div>
    <a class="button secondary" href="/account/security">Account</a>
  </div>
  <% if(message){ %><div class="notice success"><%= message %></div><% } %>
  <% if(error){ %><div class="notice error"><%= error %></div><% } %>
  <section class="panel">
    <div class="sectionHead"><div><h2>Display currency</h2><p>Changes how available plans are shown. Existing payments keep their original amount and currency.</p></div></div>
    <form method="post" action="/account/communications/currency">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="notifyRow"><select class="input" name="currency"><% enabledCurrencies.forEach(function(c){ %><option value="<%= c %>" <%= currency===c?'selected':'' %>><%= c %></option><% }) %></select><button class="button primary">Save currency</button></div>
    </form>
  </section>
  <section class="panel">
    <div class="sectionHead"><div><h2>Offers & discounts</h2><p>Occasional promotional messages about discounts and offers, sent to whichever channels you've connected below.</p></div></div>
    <span class="pill <%= marketingOptedIn?'good':'warn' %>"><%= marketingOptedIn?'Enabled':'Off' %></span>
    <form method="post" action="/account/communications/marketing-email">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="libraryChoice"><input type="checkbox" name="enabled" value="1" <%= marketingOptedIn?'checked':'' %>><span>Send me offers and discounts</span></label>
      <p><button class="button primary">Save preference</button></p>
    </form>
  </section>
  <% if(channels.length){ %>
  <div class="notifyGrid sectionBlock">
    <% if(channels.includes('telegram')){ %>
    <section class="panel"><h2>Telegram</h2>
      <% if(prefs.telegram_chat_id){ %>
        <span class="pill good">Connected<%= prefs.telegram_handle?` · @${prefs.telegram_handle}`:'' %></span>
        <p class="accessMeta">Private bot chat verified.</p>
        <form method="post" action="/account/communications/telegram/unlink"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary">Disconnect</button></form>
      <% } else { %>
        <span class="pill warn">Not connected</span>
        <p><form method="post" action="/account/communications/telegram/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary">Connect Telegram</button></form></p>
      <% } %>
    </section>
    <% } %>
    <% if(channels.includes('discord')){ %>
    <section class="panel"><h2>Discord</h2>
      <% if(prefs.discord_user_id){ %>
        <span class="pill good">Connected<%= prefs.discord_handle?` · ${prefs.discord_handle}`:'' %></span>
        <p class="accessMeta">Verified Discord identity linked for private messages.</p>
        <form method="post" action="/account/communications/discord/unlink"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary">Disconnect</button></form>
      <% } else { %>
        <span class="pill warn">Not connected</span>
        <p><form method="post" action="/account/communications/discord/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary">Connect Discord</button></form></p>
      <% } %>
    </section>
    <% } %>
    <% if(channels.includes('whatsapp')){ %>
    <section class="panel"><h2>WhatsApp</h2>
      <span class="pill <%= prefs.whatsapp_opt_in?'good':'warn' %>"><%= prefs.whatsapp_opt_in?'Enabled':'Off' %></span>
      <form method="post" action="/account/communications/whatsapp">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label>Mobile number</label><input class="input" name="phone" value="<%= prefs.phone_e164||'' %>" placeholder="+447700900123"></div>
        <label class="libraryChoice"><input type="checkbox" name="enabled" value="1" <%= prefs.whatsapp_opt_in?'checked':'' %>><span>Enable optional WhatsApp messages</span></label>
        <p><button class="button primary">Save WhatsApp</button></p>
      </form>
    </section>
    <% } %>
  </div>
  <section class="panel sectionBlock">
    <div class="sectionHead"><div><h2>What should I be notified about?</h2><p>Only customer-facing events enabled by CAPTAiNFiN appear here.</p></div></div>
    <form method="post" action="/account/communications/events">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="tableWrap"><table class="notifyEvents"><thead><tr><th>Event</th><% channels.forEach(function(channel){ %><th><%= channel.charAt(0).toUpperCase()+channel.slice(1) %></th><% }) %></tr></thead><tbody>
      <% events.forEach(function(event){const selected=eventPreferences[event.event_type]||{}; %>
        <tr><td><strong><%= event.display_name %></strong><div class="accessMeta"><%= event.description %></div></td><% channels.forEach(function(channel){const eventEnabled=Boolean(event[channel+'_enabled']); %><td class="<%= eventEnabled?'':'notifyDisabled' %>"><input aria-label="<%= channel.charAt(0).toUpperCase()+channel.slice(1) %> for <%= event.display_name %>" type="checkbox" name="<%= channel %>__<%= event.event_type %>" <%= selected[channel]?'checked':'' %> <%= eventEnabled?'':'disabled' %>></td><% }) %></tr>
      <% }) %>
      </tbody></table></div>
      <p><button class="button primary">Save notification choices</button></p>
    </form>
  </section>
  <% } else { %>
  <section class="panel sectionBlock">
    <div class="sectionHead"><div><h2>Optional notification channels</h2><p>No optional notification channels are currently enabled.</p></div></div>
  </section>
  <% } %>
</main>
</div></body>
</html>