<% const configuredNav=typeof navOptions==='object'&&navOptions?navOptions:{}; const navBenefits=typeof showBenefits!=='undefined'?Boolean(showBenefits):Boolean(configuredNav.showBenefits); const navAccess=typeof showAccess!=='undefined'?Boolean(showAccess):Boolean(configuredNav.showAccess||configuredNav.showJellyfin); const navOverseerrUrl=typeof overseerrUrl!=='undefined'?String(overseerrUrl||''):String(configuredNav.overseerrUrl||''); const navStandalone=typeof standaloneHeader!=='undefined'&&Boolean(standaloneHeader); const navSiteName=typeof siteName!=='undefined'?String(siteName||''):''; %>
<% if(navStandalone){ %>
<header class="customerStandaloneHeader"><a class="brandLockup" href="/account"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= navSiteName %></div><div class="brandMeta">My account</div></div></a><a class="button ghost small" href="/account">Home</a></header>
<% } %>
<nav class="customerPortalNav" aria-label="Customer navigation">
  <a class="customerPortalNavLink <%= active==='overview'?'active':'' %>" href="/account">Home</a>
  <% if (navAccess) { %><a class="customerPortalNavLink <%= active==='access'||active==='jellyfin'?'active':'' %>" href="/account/access">My Access</a><% } %>
  <a class="customerPortalNavLink <%= active==='activity'?'active':'' %>" href="/account/activity">Activity</a>
  <a class="customerPortalNavLink <%= active==='history'?'active':'' %>" href="/account/history">Payments</a>
  <% if (navBenefits) { %>
    <a class="customerPortalNavLink <%= active==='benefits'||active==='affiliate'?'active':'' %>" href="/account/affiliate">Affiliate</a>
  <% } %>
  <a class="customerPortalNavLink <%= active==='support'?'active':'' %>" href="/account/support">Support</a>
  <%# Help is intentionally no longer a top-level customer tab. Legacy Notifications route /account/communications and active==='notifications' are folded into Account. %>
  <a class="customerPortalNavLink <%= active==='account'||active==='security'?'active':'' %>" href="/account/security">Account</a>
  <% if (navOverseerrUrl) { %>
    <a class="customerPortalNavLink" href="<%= navOverseerrUrl %>" target="_blank" rel="noreferrer">Request content ↗</a>
  <% } %>
</nav>
<section class="customerNowPlaying" data-customer-now-playing aria-live="polite" hidden></section>
<script src="/js/customer-now-playing.js" defer></script>
<script src="/js/customer-home-access.js" defer></script>
<script src="/js/customer-account-notifications.js" defer></script>
