<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title>Support · <%= siteName %></title><link rel="icon" href="/branding/favicon"><link rel="stylesheet" href="/css/customer-portal.css"><link rel="stylesheet" href="/css/customer-dashboard.css"><link rel="stylesheet" href="/css/customer-navigation.css"></head>
<body><div class="portalShell"><header class="portalTopbar"><div class="portalTopbarInner"><a class="brandLockup" href="/account"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= siteName %></div><div class="brandMeta">My account</div></div></a><div class="portalActions"><a class="button ghost small" href="/account">Home</a></div></div></header><div class="customerLayout"><aside class="customerSidebar" aria-label="Customer navigation"><div class="customerNavTitle">My account</div><%- include('_nav',{active:'support'}) %></aside><main class="portalMain">
<% if(message){ %><div class="notice success"><%= message %></div><% } %><% if(error){ %><div class="notice error"><%= error %></div><% } %>
<section class="accountHero simpleHero"><div><div class="eyebrow">Support</div><h1>How can we help?</h1><p>Open a ticket and keep the whole conversation here.</p></div></section>
<section class="sectionBlock"><div class="sectionHead"><div><h2>New ticket</h2><p>Billing, access, technical problems or anything else.</p></div></div><form method="post" action="/account/support"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="ticket-subject">Subject</label><input class="input" id="ticket-subject" name="subject" minlength="3" maxlength="180" required></div><div class="field"><label for="ticket-category">Category</label><select class="input" id="ticket-category" name="category"><option value="technical">Technical</option><option value="access">Access</option><option value="billing">Billing</option><option value="account">Account</option><option value="content">Content</option><option value="other">Other</option></select></div><div class="field"><label for="ticket-message">Message</label><textarea class="input" id="ticket-message" name="message" rows="7" maxlength="10000" required></textarea></div><button class="button primary" type="submit">Open ticket</button></form></section>
<section class="sectionBlock"><div class="sectionHead"><div><h2>My tickets</h2><p>Replies and resolved conversations stay available here.</p></div></div><% if(!tickets.length){ %><div class="empty">You have no support tickets yet.</div><% } else { %><div class="accessGrid"><% tickets.forEach(function(ticket){ %><a class="accessCard simpleAccessCard" href="/account/support/<%= ticket.id %>" style="text-decoration:none;color:inherit"><div class="accessTop"><div><div class="accessTitle">#<%= ticket.ticket_number %> · <%= ticket.subject %></div><div class="accessMeta"><%= ticket.category %> · updated <%= new Date(ticket.updated_at).toLocaleString('en-GB',{dateStyle:'medium',timeStyle:'short'}) %></div></div><span class="pill <%= ['open','awaiting_staff'].includes(ticket.status)?'warn':ticket.status==='awaiting_customer'?'accent':'good' %>"><%= ticket.status.replaceAll('_',' ') %></span></div></a><% }) %></div><% } %></section>
</main></div></div></body></html>
