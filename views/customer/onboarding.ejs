<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Choose your access · <%= siteName %></title>
  <link rel="icon" href="/branding/favicon">
  <link rel="stylesheet" href="/css/customer-portal.css">
  <link rel="stylesheet" href="/css/customer-dashboard.css">
  <link rel="stylesheet" href="/css/customer-navigation.css">
  <script src="/js/customer-checkout.js" defer></script>
  <style>
    .choiceIntro{max-width:760px}.stepStrip{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:22px 0}.stepCard{padding:13px;border:1px solid #26303d;border-radius:12px;background:#0e151d}.stepCard strong{display:block;margin-bottom:4px}.accessPlanGroup{margin-top:24px}.accessPlanGroup:first-of-type{margin-top:18px}.accessPlanGroupHead{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:10px}.accessPlanGroupHead h3{margin:0;font-size:16px}.accessPlanGroupHead p{margin:3px 0 0;color:#8e9bad;font-size:12px}.accessPlanGroupMeta{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap}.accessPlanGroupCount{color:#748295;font-size:11px;white-space:nowrap}.scarcityBadge{display:inline-flex;align-items:center;padding:5px 9px;border:1px solid rgba(53,201,135,.28);border-radius:999px;background:rgba(53,201,135,.07);color:#8de4b9;font-size:11px;font-weight:800}.scarcityBadge.limited{border-color:rgba(234,182,90,.3);background:rgba(234,182,90,.08);color:#efc77e}.scarcityBadge.urgent{border-color:rgba(255,122,89,.34);background:rgba(255,122,89,.1);color:#ffad91}.scarcityBadge.sold{border-color:rgba(224,108,117,.34);background:rgba(224,108,117,.09);color:#f3a8ae}@media(max-width:700px){.stepStrip{grid-template-columns:1fr}.accessPlanGroupHead{align-items:flex-start;flex-direction:column}.accessPlanGroupMeta{justify-content:flex-start}}
  </style>
</head>
<%
  const username=portal.customer.login_username||portal.customer.login_email||portal.customer.display_name||'there';
  function price(plan){if(Number(plan&&plan.price_minor||0)===0)return'Free';try{return new Intl.NumberFormat('en-GB',{style:'currency',currency:plan.currency||currency||'USD',currencyDisplay:'narrowSymbol'}).format(Number(plan.price_minor||0)/100)}catch(_){const code=String(plan&&plan.currency||currency||'USD').toUpperCase();return `${({'GBP':'£','USD':'$','EUR':'€'})[code]||'¤'}${(Number(plan&&plan.price_minor||0)/100).toFixed(2)}`;}}
  function duration(plan){const interval=String(plan&&plan.billing_interval||'');const labels={trial:'24-hour trial',month:'Monthly','6_months':'6 months',year:'Yearly',custom:'Custom duration'};if(labels[interval])return labels[interval];const days=Number(plan&&plan.duration_days||0);return days?`${days} days`:'Subscription';}
  function planService(plan){const t=String(plan&&plan.service_type||'jellyfin').toLowerCase();return ['jellyfin','stremio','emby','bundle'].includes(t)?t:'jellyfin';}
  function accessModel(plan){const t=planService(plan),streams=Math.max(1,Number(plan&&plan.streams||1));if(t==='stremio')return'1 Stremio household · unlimited streams & devices';if(t==='emby')return `${streams} Emby stream${streams===1?'':'s'}`;if(t==='bundle')return `${streams} Jellyfin stream${streams===1?'':'s'} + Stremio household access`;return `${streams} Jellyfin stream${streams===1?'':'s'}`;}
  function planFamily(plan){const service=String(plan.service_type||'jellyfin').toLowerCase(),audience=String(plan.audience||'direct').toLowerCase();if(audience==='reseller')return'reseller';if(service==='stremio')return'stremio';if(service==='emby')return'emby';if(service==='jellyfin'&&(plan.is_free_tier||(Number(plan.price_minor||0)===0&&String(plan.billing_interval||'')!=='trial')))return'free';if(service==='jellyfin'||service==='bundle')return'paid';return'other';}
  const accessGroups=[
    {key:'free',title:'Free Server Plans',description:'Free Jellyfin access when a place is available.'},
    {key:'paid',title:'Paid Plans',description:'Premium Jellyfin trials and paid access.'},
    {key:'stremio',title:'Stremio Plans',description:'Standalone Stremio household access.'},
    {key:'emby',title:'Emby Shares',description:'Standalone Emby server access.'},
    {key:'reseller',title:'Reseller Plans',description:'Plans intended for reseller accounts.'},
    {key:'other',title:'Other Plans',description:'Other access products available to this account.'}
  ].map(group=>{const grouped=plans.filter(plan=>planFamily(plan)===group.key),shared=group.key==='paid'?grouped.find(plan=>plan.billing_interval!=='trial'&&plan.capacity&&plan.capacity.pool==='premium'):group.key==='free'?grouped.find(plan=>plan.capacity&&plan.capacity.pool==='free'):null;return{...group,plans:grouped,sharedCapacity:shared?shared.capacity:null};}).filter(group=>group.plans.length);
%>
<body>
<div class="portalShell">
  <header class="portalTopbar"><div class="portalTopbarInner"><div class="brandLockup"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= siteName %></div><div class="brandMeta">My account</div></div></div><div class="portalActions"><span class="signedIn">Signed in as <strong><%= username %></strong></span><form method="post" action="/account/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button ghost small" type="submit">Sign out</button></form></div></div></header>
  <main class="customerPortalPage">
    <%- include('_nav',{active:'overview'}) %>
    <% if(message){ %><div class="notice success"><%= message %></div><% } %>
    <% if(error){ %><div class="notice error"><%= error %></div><% } %>
    <% if(openCheckout){ %><div class="notice"><strong>You have a checkout in progress.</strong> If you closed the payment page without finishing, you can cancel it here and start again.<form class="plainForm" method="post" action="/account/checkout/cancel-open" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary">Cancel in-progress checkout</button></form></div><% } %>

    <section class="accountHero"><div class="choiceIntro"><div class="eyebrow">Your account is ready</div><h1>Welcome, <%= username %>. Choose how you want to watch.</h1><p>You only need to choose access once. After a plan, trial or Free Access is active, this page becomes your normal account dashboard with setup, billing, activity and account controls.</p></div><div class="heroActions"><a class="button secondary" href="/account/security">Account</a></div></section>
    <div class="stepStrip"><div class="stepCard"><strong>1. Choose access</strong><span class="accessMeta">Free Server, paid Jellyfin or standalone Stremio access, depending on what is currently available.</span></div><div class="stepCard"><strong>2. Finish setup</strong><span class="accessMeta">CAPTAiNFiN prepares the service and shows the exact next step.</span></div><div class="stepCard"><strong>3. Start watching</strong><span class="accessMeta">Open Jellyfin or install Stremio directly from your account.</span></div></div>

    <section class="sectionBlock manageHub" id="plans">
      <div class="sectionHead"><div><h2>Available access</h2><p>Choose a plan below. Promo codes are entered on the individual plan card, just like they are in your normal account dashboard. Stripe and PayPal first ask you to choose the provider, then show one-off or subscription options when both are available.</p><p>All paid prices use <strong><%= String(currency||'USD').toUpperCase() %></strong>. The payment provider confirms the final amount before access starts.</p></div></div>
      <% if(!plans.length){ %><div class="empty">No access products are currently available. Your account remains active; check again later or contact support.</div><% } %>

      <% accessGroups.forEach(function(group){ %>
        <section class="accessPlanGroup" data-plan-family="<%= group.key %>">
          <div class="accessPlanGroupHead"><div><h3><%= group.title %></h3><p><%= group.description %></p></div><div class="accessPlanGroupMeta"><% if(group.sharedCapacity){ %><span class="scarcityBadge <%= group.sharedCapacity.kind||'available' %>"><%= group.sharedCapacity.label||'Available' %></span><% } %><span class="accessPlanGroupCount"><%= group.plans.length %> plan<%= group.plans.length===1?'':'s' %></span></div></div>
          <div class="plansGrid">
            <% group.plans.forEach(function(p){
              const opts=Array.isArray(p.payment_options)?p.payment_options:[];
              const stripeOpt=opts.find(o=>o.provider==='stripe');
              const paypalOpt=opts.find(o=>o.provider==='paypal');
              const plisioOpt=opts.find(o=>o.provider==='plisio');
              const isTrial=p.billing_interval==='trial';
              const isFreePlan=Number(p.price_minor||0)===0&&!isTrial;
              const soldOut=Boolean(p.capacity&&p.capacity.soldOut);
              const pType=planService(p);
            %>
              <article class="planCard <%= soldOut?'soldOut':'' %>" data-plan-code="<%= p.code %>" data-plan-currency="<%= p.currency||currency||'USD' %>" data-plan-base-minor="<%= Number(p.price_minor||0) %>">
                <div class="planTop"><div><div class="planName"><%= p.name %></div><div class="planDuration"><%= duration(p) %></div></div></div>
                <div class="planPrice" data-plan-price><%= price(p) %></div>
                <div class="promoPriceNote" data-promo-price-note hidden></div>
                <% if(Number(p.price_minor||0)>0){ %><div class="planPromo" data-plan-promo><label class="planPromoLabel" for="promo-<%= p.code %>">Promo code</label><div class="planPromoLine"><input class="input" id="promo-<%= p.code %>" data-promo-input maxlength="40" autocomplete="off" placeholder="Optional"><button class="button secondary" type="button" data-promo-clear aria-label="Clear promo code">Clear</button></div></div><% } %>
                <div class="planDescription"><%= p.description||'Streaming access managed through your account.' %></div>
                <ul class="featureList"><li><%= accessModel(p) %></li><li><%= pType==='stremio'?'Private Stremio installation':p.allow_downloads?'Downloads included':'Streaming only' %></li></ul>
                <div class="planActions">
                  <% if(soldOut){ %>
                    <% if(isFreePlan&&discordInviteUrl){ %><div class="paymentNote">Free Access is full. Join the Discord — we post when places open.</div><a class="button free full" href="<%= discordInviteUrl %>" target="_blank" rel="noopener noreferrer">Subscribe</a><% } else { %><span class="button secondary full" aria-disabled="true">Currently full</span><% } %>
                  <% } else if(isTrial){ %>
                    <form class="plainForm" method="post" action="/account/trial/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><button class="button primary full" type="submit">Start free trial</button></form>
                  <% } else if(isFreePlan){ %>
                    <form class="plainForm" method="post" action="/account/claim-free/<%= p.code %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button free full" type="submit">Get free access</button></form>
                  <% } else { %>
                    <% if(stripeEnabled&&stripeOpt){ %><div class="paymentNote">Starts after Stripe confirms payment.</div><form class="plainForm checkoutForm" method="post" action="/account/checkout/stripe"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input type="hidden" name="discountCode" data-promo-target><button class="button stripe full" type="submit">Continue with Stripe</button></form><% } %>
                    <% if(paypalEnabled&&paypalOpt){ %><form class="plainForm checkoutForm" method="post" action="/account/checkout/paypal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input type="hidden" name="discountCode" data-promo-target><button class="button paypal full" type="submit">Continue with PayPal</button></form><% } %>
                    <% if(plisioEnabled&&plisioOpt){ %><form class="plainForm checkoutForm" method="post" action="/account/checkout/plisio"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input type="hidden" name="checkoutMode" value="payment"><input type="hidden" name="discountCode" data-promo-target><button class="button primary full" type="submit">Plisio · One-off payment</button></form><% } %>
                    <% if(!(stripeEnabled&&stripeOpt)&&!(paypalEnabled&&paypalOpt)&&!(plisioEnabled&&plisioOpt)){ %><div class="paymentNote">No payment method is currently configured for this plan.</div><% } %>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        </section>
      <% }) %>
    </section>
  </main>
</div>
</body>
</html>
