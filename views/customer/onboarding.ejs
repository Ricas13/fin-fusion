<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Choose your access · <%= siteName %></title>
  <link rel="icon" href="/branding/favicon">
  <link rel="stylesheet" href="/css/customer-portal.css">
  <link rel="stylesheet" href="/css/customer-navigation.css">
  <style>
    .choiceIntro{max-width:760px}.choiceGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}.choiceCard{background:#121922;border:1px solid #26303d;border-radius:14px;padding:20px}.choiceCard.freeChoice{border-color:#2f6b54}.choiceCard.soldOut{opacity:.72}.choiceCard h3{margin:0 0 6px}.choiceMeta{color:#8e9bad;font-size:13px;margin:8px 0 14px}.choicePrice{font-size:26px;font-weight:800;margin:12px 0}.choiceActions{display:grid;gap:8px;margin-top:16px}.soldNote{color:#f3bd67}.stepStrip{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:22px 0}.stepCard{padding:13px;border:1px solid #26303d;border-radius:12px;background:#0e151d}.stepCard strong{display:block;margin-bottom:4px}.accessPlanGroup{margin-top:24px}.accessPlanGroup:first-of-type{margin-top:18px}.accessPlanGroupHead{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:10px}.accessPlanGroupHead h3{margin:0;font-size:16px}.accessPlanGroupHead p{margin:3px 0 0;color:#8e9bad;font-size:12px}.accessPlanGroupMeta{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap}.accessPlanGroupCount{color:#748295;font-size:11px;white-space:nowrap}.scarcityBadge{display:inline-flex;align-items:center;padding:5px 9px;border:1px solid rgba(53,201,135,.28);border-radius:999px;background:rgba(53,201,135,.07);color:#8de4b9;font-size:11px;font-weight:800}.scarcityBadge.limited{border-color:rgba(234,182,90,.3);background:rgba(234,182,90,.08);color:#efc77e}.scarcityBadge.urgent{border-color:rgba(255,122,89,.34);background:rgba(255,122,89,.1);color:#ffad91}.scarcityBadge.sold{border-color:rgba(224,108,117,.34);background:rgba(224,108,117,.09);color:#f3a8ae}.featureList .scarcityFeature{color:#c9d3dd;font-weight:750}.featureList .scarcityFeature:before{content:'•';color:#eab65a}.streamPicker{margin:14px 0;padding:12px;border:1px solid #2a3542;border-radius:11px;background:#0e151d}.streamPicker label{display:block;font-weight:800;font-size:12px;margin-bottom:7px}.streamPicker select{width:100%}.streamPicker .inlineHelp{margin-top:6px}.variantSoldNote{display:none;color:#f3bd67;font-size:12px}@media(max-width:700px){.stepStrip{grid-template-columns:1fr}.accessPlanGroupHead{align-items:flex-start;flex-direction:column}.accessPlanGroupMeta{justify-content:flex-start}}
  </style>
</head>
<%
  const username=portal.customer.login_username||portal.customer.login_email||portal.customer.display_name||'there';
  function price(plan){if(Number(plan.price_minor||0)===0)return'Free';try{return new Intl.NumberFormat('en-GB',{style:'currency',currency:plan.currency||currency}).format(Number(plan.price_minor||0)/100)}catch(_){return `${plan.currency||currency} ${(Number(plan.price_minor||0)/100).toFixed(2)}`;}}
  function kind(plan){const t=String(plan.service_type||'jellyfin');return t==='stremio'?'Stremio':'Jellyfin';}
  function paymentMode(opt){return String(opt&&((opt.checkoutMode)||opt.checkout_mode)||'payment')==='subscription'?'subscription':'payment';}
  function paymentButton(provider,opt){const name=provider==='paypal'?'PayPal':provider==='stripe'?'Stripe':'Payment';return `${name} · ${paymentMode(opt)==='subscription'?'Subscription':'One-off payment'}`;}
  function capacityLabel(plan){return plan&&plan.capacity?(plan.capacity.label||(plan.capacity.soldOut?'Currently full':'Available')):'Available';}
  function gatewayOn(provider){return provider==='stripe'?stripeEnabled:provider==='paypal'?paypalEnabled:provider==='coingate'?coingateEnabled:false;}
  function usableOptions(variant){return (Array.isArray(variant.payment_options)?variant.payment_options:[]).filter(opt=>gatewayOn(opt.provider));}
  function optionKey(opt){return `${opt.provider}:${paymentMode(opt)}`;}
  function planFamily(plan){
    const service=String(plan.service_type||'jellyfin').toLowerCase(),audience=String(plan.audience||'direct').toLowerCase();
    if(audience==='reseller')return'reseller';
    if(service==='stremio')return'stremio';
    if(service==='jellyfin'&&(plan.is_free_tier||(Number(plan.price_minor||0)===0&&String(plan.billing_interval||'')!=='trial')))return'free';
    if(service==='jellyfin')return'paid';
    return'other';
  }
  const accessGroups=[
    {key:'free',title:'Free Server Plans',description:'Free Jellyfin access when a place is available.'},
    {key:'paid',title:'Paid Plans',description:'Jellyfin trials and paid access plans.'},
    {key:'stremio',title:'Stremio Plans',description:'Standalone Stremio household access.'},
    {key:'reseller',title:'Reseller Plans',description:'Plans intended for reseller accounts.'},
    {key:'other',title:'Other Plans',description:'Other access products available to this account.'}
  ].map(group=>{const grouped=plans.filter(plan=>planFamily(plan)===group.key),shared=group.key==='paid'?grouped.find(plan=>plan.billing_interval!=='trial'&&plan.capacity&&plan.capacity.pool==='premium'):group.key==='free'?grouped.find(plan=>plan.capacity&&plan.capacity.pool==='free'):null;return{...group,plans:grouped,sharedCapacity:shared?shared.capacity:null};}).filter(group=>group.plans.length);
%>
<body><div class="portalShell">
<header class="portalTopbar"><div class="portalTopbarInner"><div class="brandLockup"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= siteName %></div><div class="brandMeta">Getting started</div></div></div><div class="portalActions"><span class="signedIn">Signed in as <strong><%= username %></strong></span><form method="post" action="/account/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button ghost small">Sign out</button></form></div></div></header>
<main class="customerPortalPage">
<%- include('_nav',{active:'overview'}) %>
<% if(message){ %><div class="notice success"><%= message %></div><% } %>
<% if(error){ %><div class="notice error"><%= error %></div><% } %>
<% if(openCheckout){ %><div class="notice"><strong>You have a checkout in progress.</strong> If you closed the payment page without finishing, you can cancel it here and start again.<form class="plainForm" method="post" action="/account/checkout/cancel-open" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary">Cancel in-progress checkout</button></form></div><% } %>
<section class="accountHero"><div class="choiceIntro"><div class="eyebrow">Your account is ready</div><h1>Welcome, <%= username %>. Choose how you want to watch.</h1><p>You only need to choose access once. After a plan, trial or Free Access is active, this page becomes your normal account dashboard with setup, billing, activity and account controls.</p></div><div class="heroActions"><a class="button secondary" href="/account/security">Account security</a></div></section>
<div class="stepStrip"><div class="stepCard"><strong>1. Choose access</strong><span class="accessMeta">Free Server, paid Jellyfin or standalone Stremio access, depending on what is currently available.</span></div><div class="stepCard"><strong>2. Finish setup</strong><span class="accessMeta">CAPTAiNFiN prepares the service and shows the exact next step.</span></div><div class="stepCard"><strong>3. Start watching</strong><span class="accessMeta">Open Jellyfin or install Stremio directly from your account.</span></div></div>
<section class="sectionBlock" id="plans"><div class="sectionHead"><div><h2>Available access</h2><p>Only products that can be delivered are shown. Free Access always remains visible, even when all current free places are taken. All paid prices are in <strong><%= currency %></strong>.</p></div></div>
<% if(!plans.length){ %><div class="empty">No access products are currently available. Your account remains active; check again later or contact support.</div><% } %>
<% accessGroups.forEach(function(group){ %>
<section class="accessPlanGroup" data-plan-family="<%= group.key %>">
  <div class="accessPlanGroupHead"><div><h3><%= group.title %></h3><p><%= group.description %></p></div><div class="accessPlanGroupMeta"><% if(group.sharedCapacity){ %><span class="scarcityBadge <%= group.sharedCapacity.kind||'available' %>"><%= group.sharedCapacity.label||'Available' %></span><% } %><span class="accessPlanGroupCount"><%= group.plans.length %> plan<%= group.plans.length===1?'':'s' %></span></div></div>
  <div class="choiceGrid">
  <% group.plans.forEach(function(p){
    const isFree=Boolean(p.is_free_tier)||Number(p.price_minor||0)===0&&p.billing_interval!=='trial',isTrial=p.billing_interval==='trial',sold=Boolean(p.capacity&&p.capacity.soldOut);
    const rawVariants=!isFree&&!isTrial&&Array.isArray(p.stream_variants)&&p.stream_variants.length?p.stream_variants:[{streams:Number(p.streams||1),price_minor:Number(p.price_minor||0),currency:p.currency||currency,payment_options:Array.isArray(p.payment_options)?p.payment_options:[],capacity:p.capacity}];
    const baseStreams=Number(p.streams||1),variants=rawVariants.filter(v=>Number(v.streams)===baseStreams||usableOptions(v).length).sort((a,b)=>Number(a.streams)-Number(b.streams));
    const initial=variants.find(v=>Number(v.streams)===baseStreams)||variants[0]||rawVariants[0];
    const union=new Map();variants.forEach(v=>usableOptions(v).forEach(opt=>union.set(optionKey(opt),opt)));const allOpts=Array.from(union.values());
    const stripeOpts=allOpts.filter(o=>o.provider==='stripe'),paypalOpts=allOpts.filter(o=>o.provider==='paypal'),coingateOpts=allOpts.filter(o=>o.provider==='coingate');
  %>
  <article class="choiceCard <%= isFree?'freeChoice':'' %> <%= sold?'soldOut':'' %>" <%= variants.length>1?'data-stream-card':'' %>><div class="eyebrow"><%= isFree?'Free Access':kind(p) %></div><h3><%= p.name %></h3><div class="choicePrice" data-choice-price><%= price(initial||p) %></div><div class="choiceMeta"><%= p.description||'Streaming access managed through your account.' %></div><ul class="featureList"><li><%= kind(p) %></li><li data-stream-feature><%= (initial&&initial.streams)||p.streams||1 %> concurrent stream<%= Number((initial&&initial.streams)||p.streams||1)===1?'':'s' %></li><li class="scarcityFeature" data-scarcity-feature><%= capacityLabel(initial||p) %></li></ul>
  <% if(variants.length>1){ %><div class="streamPicker"><label for="streams-<%= p.id %>">How many simultaneous streams?</label><select id="streams-<%= p.id %>" class="input" data-stream-selector><% variants.forEach(function(v){const payments=usableOptions(v).map(optionKey).join(','),vSold=Boolean(v.capacity&&v.capacity.soldOut); %><option value="<%= v.streams %>" data-price="<%= price(v) %>" data-scarcity="<%= capacityLabel(v) %>" data-sold="<%= vSold?'1':'0' %>" data-payments="<%= payments %>" <%= Number(v.streams)===Number(initial.streams)?'selected':'' %>><%= v.streams %> streams · <%= price(v) %><%= vSold?' · Full':'' %></option><% }) %></select><div class="inlineHelp">Choose the maximum number of simultaneous Jellyfin streams for this subscription.</div></div><% } %>
  <div class="choiceActions">
  <% if(sold){ %>
    <div class="soldNote"><strong>Currently full.</strong> No new place can be activated until shared capacity becomes available.</div><span class="button secondary full" aria-disabled="true">Currently full</span>
  <% } else if(isFree){ %>
    <form class="plainForm" method="post" action="/account/claim-free/<%= p.code %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button free full">Activate Free Access</button></form>
  <% } else if(isTrial){ %><div class="paymentNote">Starts immediately after you confirm.</div><form class="plainForm" method="post" action="/account/trial/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><button class="button primary full">Start free trial</button></form>
  <% } else { %>
    <div class="variantSoldNote" data-variant-sold><strong>This stream option is currently full.</strong> Choose a lower stream limit or check again later.</div>
    <% stripeOpts.forEach(function(opt){ %><form class="plainForm" data-payment-key="<%= optionKey(opt) %>" method="post" action="/account/checkout/stripe"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input type="hidden" name="streams" value="<%= initial.streams %>"><input type="hidden" name="checkoutMode" value="<%= paymentMode(opt) %>"><button class="button stripe full"><%= paymentButton('stripe',opt) %></button></form><% }) %>
    <% paypalOpts.forEach(function(opt){ %><form class="plainForm" data-payment-key="<%= optionKey(opt) %>" method="post" action="/account/checkout/paypal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input type="hidden" name="streams" value="<%= initial.streams %>"><input type="hidden" name="checkoutMode" value="<%= paymentMode(opt) %>"><button class="button paypal full"><%= paymentButton('paypal',opt) %></button></form><% }) %>
    <% if(coingateOpts.length){ %><div class="paymentNote" data-payment-key="coingate:payment">Crypto is a one-time payment for this plan period and does not auto-renew.</div><form class="plainForm" data-payment-key="coingate:payment" method="post" action="/account/checkout/coingate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input type="hidden" name="streams" value="<%= initial.streams %>"><input type="hidden" name="checkoutMode" value="payment"><button class="button primary full">CoinGate · One-off payment</button></form><% } %>
    <% if(!allOpts.length){ %><div class="paymentNote">No payment method is currently configured for this plan.</div><% } %>
  <% } %>
  </div></article>
  <% }) %>
  </div>
</section>
<% }) %>
</section>
</main></div>
<script>
document.querySelectorAll('[data-stream-card]').forEach(function(card){
  const select=card.querySelector('[data-stream-selector]');if(!select)return;
  const price=card.querySelector('[data-choice-price]'),streamFeature=card.querySelector('[data-stream-feature]'),scarcity=card.querySelector('[data-scarcity-feature]'),soldNote=card.querySelector('[data-variant-sold]');
  function sync(){
    const option=select.options[select.selectedIndex],streams=Number(option.value||1),payments=new Set(String(option.dataset.payments||'').split(',').filter(Boolean)),sold=option.dataset.sold==='1';
    if(price)price.textContent=option.dataset.price||price.textContent;
    if(streamFeature)streamFeature.textContent=streams+' concurrent stream'+(streams===1?'':'s');
    if(scarcity)scarcity.textContent=option.dataset.scarcity||'Available';
    if(soldNote)soldNote.style.display=sold?'block':'none';
    card.querySelectorAll('input[name="streams"]').forEach(function(input){input.value=String(streams);});
    card.querySelectorAll('[data-payment-key]').forEach(function(el){const allowed=!sold&&payments.has(el.dataset.paymentKey);el.style.display=allowed?'':'none';el.querySelectorAll('button').forEach(function(button){button.disabled=!allowed;});});
  }
  select.addEventListener('change',sync);sync();
});
</script>
</body></html>