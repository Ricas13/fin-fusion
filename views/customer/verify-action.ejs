<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> - <%= siteName %></title>
  <style>body{font-family:system-ui,sans-serif;background:#0b1220;color:#e5e7eb;padding:40px}.card{max-width:560px;margin:10vh auto;background:#111827;border:1px solid #334155;border-radius:16px;padding:28px}.button{display:inline-block;border:1px solid #2d6474;border-radius:8px;background:#163844;color:#ecfbff;padding:11px 18px;font-weight:700;cursor:pointer}a{color:#7dd3fc}.muted{color:#94a3b8;font-size:14px}</style>
</head>
<body>
  <main class="card">
    <h1><%= title %></h1>
    <p><%= message %></p>
    <form method="post" action="<%= action %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">
      <button class="button" type="submit"><%= buttonLabel %></button>
    </form>
    <p class="muted">Opening this page did not consume the verification link.</p>
  </main>
</body>
</html>
