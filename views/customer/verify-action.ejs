<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> · <%= siteName %></title>
  <style>
    :root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,sans-serif;background:radial-gradient(circle at top,#102235 0,#0b1220 42%,#09101b 100%);color:#e5e7eb;min-height:100vh;display:grid;place-items:center;padding:28px}.card{width:min(520px,100%);background:#111827;border:1px solid #263244;border-radius:18px;padding:28px;box-shadow:0 20px 60px #0007;text-align:center}.check{width:52px;height:52px;margin:0 auto 14px;border-radius:50%;display:grid;place-items:center;background:#123126;border:1px solid #286847;color:#86efac;font-size:25px;font-weight:800}h1{margin:0 0 9px;font-size:28px}.lead{margin:0 auto 20px;color:#a8b4c5;line-height:1.5;max-width:430px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:0 0 20px;text-align:left}.step{border:1px solid #263244;background:#0d1521;border-radius:10px;padding:9px 10px;color:#7f8da0;font-size:11px}.step strong{display:block;color:#cbd5e1;font-size:12px;margin-bottom:2px}.step.done{border-color:#285943;background:#10251c}.step.done strong{color:#86efac}.step.active{border-color:#256c78;background:#10252d}.step.active strong{color:#67e8f9}.button{width:100%;display:inline-block;border:1px solid #238b9d;border-radius:10px;background:#1aa7b8;color:#03151a;padding:12px 18px;font-weight:800;cursor:pointer}.muted{color:#8492a6;font-size:12px;line-height:1.45;margin:12px 0 0}@media(max-width:520px){.card{padding:22px}.steps{grid-template-columns:1fr}.step:not(.active){display:none}h1{font-size:25px}}
  </style>
</head>
<body>
  <main class="card">
    <div class="check" aria-hidden="true">✓</div>
    <h1><%= title %></h1>
    <p class="lead"><%= message %></p>
    <div class="steps" aria-label="Signup progress"><div class="step done"><strong>1 · Account</strong>Details complete</div><div class="step active"><strong>2 · Verify</strong>Confirm this email</div><div class="step"><strong>3 · Access</strong>Continue automatically</div></div>
    <form method="post" action="<%= action %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">
      <button class="button" type="submit"><%= buttonLabel %></button>
    </form>
    <p class="muted">This extra confirmation protects the account from email security scanners opening the link automatically. After you confirm, registration continues immediately.</p>
  </main>
</body>
</html>
