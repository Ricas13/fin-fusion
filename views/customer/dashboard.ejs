<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>My account · <%= siteName %></title>
  <link rel="icon" href="/branding/favicon">
  <link rel="stylesheet" href="/css/customer-portal.css">
  <link rel="stylesheet" href="/css/customer-dashboard.css">
  <link rel="stylesheet" href="/css/customer-navigation.css">
  <script src="/js/customer-checkout.js" defer></script>
</head>
<%
  function validDate(value){if(!value)return null;const parsed=new Date(value);return Number.isNaN(parsed.getTime())?null:parsed;}
  function formatDate(value){const parsed=validDate(value);return parsed?parsed.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}):'Not available';}
  function esc(value){return String(value==null?'':value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
  function price(plan){if(Number(plan&&plan.price_minor||0)===0)return'Free';try{return new Intl.NumberFormat('en-GB',{style:'currency',currency:plan.currency||currency||'USD',currencyDisplay:'narrowSymbol'}).format(Number(plan.price_minor||0)/100)}catch(_){return `${plan.currency||currency||'USD'} ${(Number(plan.price_minor||0)/100).toFixed(2)}`;}}
  function duration(plan){const interval=String(plan&&(plan.billing_interval_snapshot||plan.billing_interval)||'');const labels={trial:'24-hour trial',month:'Monthly','6_months':'6 months',year:'Yearly',custom:'Custom duration'};if(labels[interval])return labels[interval];const days=Number(plan&&(plan.duration_days_snapshot||plan.duration_days)||0);return days?`${days} days`:'Subscription';}
  function monthlyValue(plan){const amount=Number(plan&&((plan.price_minor_snapshot!=null)?plan.price_minor_snapshot:plan.price_minor)||0),interval=String(plan&&((plan.billing_interval_snapshot)||plan.billing_interval)||''),days=Math.max(1,Number(plan&&((plan.duration_days_snapshot!=null)?plan.duration_days_snapshot:plan.duration_days)||30));if(interval==='month')return amount;if(interval==='6_months')return amount/6;if(interval==='year')return amount/12;return amount*30.4375/days;}
  function planService(plan){const t=String(plan&&(plan.service_type_snapshot||plan.service_type)||'jellyfin').toLowerCase();return ['jellyfin','stremio','bundle'].includes(t)?t:'jellyfin';}
  function accessModel(plan){const t=planService(plan),streams=Math.max(1,Number(plan&&plan.streams||1));if(t==='stremio')return'1 Stremio household · unlimited streams & devices';if(t==='bundle')return `${streams} Jellyfin stream${streams===1?'':'s'} + Stremio household access`;return `${streams} Jellyfin stream${streams===1?'':'s'}`;}
  function planFamily(plan){const service=String(plan.service_type||'jellyfin').toLowerCase(),audience=String(plan.audience||'direct').toLowerCase();if(audience==='reseller')return'reseller';if(service==='stremio')return'stremio';if(service==='jellyfin'&&(plan.is_free_tier||(Number(plan.price_minor||0)===0&&String(plan.billing_interval||'')!=='trial')))return'free';if(service==='jellyfin'||service==='bundle')return'paid';return'other';}
  function isLive(s){const status=String(s&&s.status||'');if(!['active','trialing','past_due','paused'].includes(status))return false;const end=validDate(s.current_period_end);return !end||end.getTime()>Date.now();}
  function isRecurring(s){return Boolean(s&&((s.source==='stripe'&&/^sub_/i.test(String(s.provider_subscription_id||'')))||(s.source==='paypal'&&/^I-/i.test(String(s.provider_subscription_id||'')))));}
  function displayPlan(s){return s&&(s.plan_name||s.contract_plan_name||s.name||s.plan_code||s.code)||'Streaming access';}
  function accessKind(s){if(s&&s.is_free_tier)return'Free Server';const service=planService(s);if(service==='stremio')return'Stremio';if(service==='bundle')return'Jellyfin + Stremio';return String(s&&s.billing_interval_snapshot||s&&s.billing_interval)==='trial'?'Jellyfin trial':'Premium Jellyfin';}
  function statusText(s){if(!s)return'Not active';if(s.status==='past_due')return'Payment needs attention';if(s.status==='paused')return'Paused';if(s.status==='trialing')return'Trial active';return'Active';}
  function planForAccount(a){if(a&&a.access_lane==='free')return freePlan||null;return currentPlan&&!currentPlan.is_free_tier?currentPlan:(currentPlan||null);}
  function renameControl(a){if(!a||!a.can_rename_jellyfin_username)return'';return `<details class="inlineManageDetails"><summary>Change username</summary><form method="post" action="/account/jellyfin/${esc(a.id)}/username"><input type="hidden" name="_csrf" value="${esc(csrfToken)}"><div class="field"><label>New Jellyfin username</label><input class="input" name="username" minlength="3" maxlength="80" pattern="[A-Za-z0-9._@+-]{3,80}" autocomplete="username" required value="${esc(a.jellyfin_username||'')}"></div><button class="button secondary" type="submit">Update username</button></form></details>`;}
  function sameSubscription(a,b){const aId=a&&(a.subscription_id||a.id),bId=b&&(b.subscription_id||b.id);return Boolean(aId&&bId&&String(aId)===String(bId));}
  function planChangeState(change){if(!change)return'';if(change.state==='awaiting_checkout')return'Action needed';if(change.state==='pending')return'Scheduled';return String(change.state||'Open').replaceAll('_',' ');}
  const renewal=typeof renewalSubscription!=='undefined'?renewalSubscription:null;
  const openChange=typeof openPlanChange!=='undefined'?openPlanChange:null;
  const accessGroups=[
    {key:'free',title:'Free Server Plans',description:'Free Jellyfin access when a place is available.'},
    {key:'paid',title:'Paid Plans',description:'Premium Jellyfin trials and paid access.'},
    {key:'stremio',title:'Stremio Plans',description:'Standalone Stremio household access.'},
    {key:'reseller',title:'Reseller Plans',description:'Plans intended for reseller accounts.'},
    {key:'other',title:'Other Plans',description:'Other access products available to this account.'}
  ].map(group=>({...group,plans:plans.filter(plan=>planFamily(plan)===group.key)})).filter(group=>group.plans.length);
  const username=portal.customer.login_username||portal.customer.login_email||portal.customer.display_name||'Customer';
  const liveSubscriptions=Array.isArray(portal.subscriptions)?portal.subscriptions.filter(s=>isLive(s)&&!s.is_addon):[];
  const accessRows=liveSubscriptions.slice().sort((a,b)=>{const rank=s=>s.is_free_tier?0:planService(s)==='jellyfin'||planService(s)==='bundle'?1:2;return rank(a)-rank(b)||new Date(a.created_at||0)-new Date(b.created_at||0);});
  function subscriptionForEntitlement(entitlement){if(!entitlement)return null;const id=entitlement.subscription_id||entitlement.id;return liveSubscriptions.find(s=>id&&String(s.id)===String(id))||null;}
  function laneEntitlement(plan){const service=planService(plan);if(service==='stremio')return stremioPlan||null;if(service==='jellyfin'||service==='bundle')return currentPlan||null;return null;}
  function subscriptionForPlan(plan){return subscriptionForEntitlement(laneEntitlement(plan));}
  const primaryAccount=portal.accounts.find(a=>a.access_lane==='primary'&&!a.disabled)||portal.accounts.find(a=>a.access_lane==='free'&&!a.disabled)||portal.accounts.find(a=>!a.disabled)||portal.accounts[0]||null;
  const readyAccounts=portal.accounts.filter(a=>!a.disabled&&!a.password_setup_required&&a.public_url);
  const passwordAccounts=portal.accounts.filter(a=>!a.disabled&&a.password_setup_required);
  const jellyfinReady=readyAccounts.length>0,jellyfinNeedsPassword=passwordAccounts.length>0,jellyfinPending=Boolean(hasJellyfin&&!portal.accounts.length);
  const referralsEnabled=Boolean(portal.referralsEnabled&&portal.referralCode);
  function stripeChangeCopy(plan){const subscription=subscriptionForPlan(plan);if(!isRecurring(subscription)||subscription.source!=='stripe')return'Starts after Stripe confirms payment.';const upgrade=monthlyValue(plan)>monthlyValue(subscription);return upgrade?'Upgrade: changes immediately. Stripe may charge a prorated amount today.':`Change: scheduled for your next renewal${subscription.current_period_end?' on '+formatDate(subscription.current_period_end):''}.`;}
  function stripeButtonCopy(plan){const subscription=subscriptionForPlan(plan);if(!isRecurring(subscription)||subscription.source!=='stripe')return'Continue with Stripe';return monthlyValue(plan)>monthlyValue(subscription)?'Upgrade with Stripe':'Change at next renewal';}
%>
<body>
<div class="portalShell">
  <header class="portalTopbar"><div class="portalTopbarInner"><div class="brandLockup"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= siteName %></div><div class="brandMeta">My account</div></div></div><div class="portalActions"><span class="signedIn">Signed in as <strong><%= username %></strong></span><form method="post" action="/account/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button ghost small" type="submit">Sign out</button></form></div></div></header>
  <div class="customerLayout">
    <aside class="customerSidebar" aria-label="Customer navigation"><div class="customerNavTitle">My account</div><%- include('_nav',{active:'overview'}) %></aside>
    <main class="portalMain customerSimpleHome">
      <% if(message){ %><div class="notice success"><%= message %></div><% } %>
      <% if(error){ %><div class="notice error"><%= error %></div><% } %>

      <section class="accountHero simpleHero <%= jellyfinReady?'ready':jellyfinNeedsPassword?'attention':jellyfinPending?'pending':'' %>">
        <div><div class="eyebrow">Your streaming access</div><h1><%= accessRows.length>1?'Everything you have, in one place.':jellyfinReady?'You\'re ready to watch.':hasStremio?'Your streaming access is ready.':'Your access' %></h1><p><%= accessRows.length>1?'Free Server, Premium Jellyfin and Stremio can stay active independently.':jellyfinReady&&primaryAccount?`Open Jellyfin and sign in with ${primaryAccount.jellyfin_username}.`:'Use the access options below whenever you need them.' %></p></div>
        <div class="heroActions primaryJourneyActions">
          <% readyAccounts.forEach(function(a){ %><a class="button <%= a.access_lane==='free'?'free':'primary' %> journeyPrimary" href="<%= a.public_url %>" target="_blank" rel="noopener noreferrer">Open <%= a.access_lane==='free'?'Free':'Premium' %> Jellyfin</a><% }) %>
          <% if(stremioInstallUrl){ %><a class="button primary" href="<%= stremioInstallUrl %>">Install in Stremio</a><% } else if(hasStremio){ %><form class="plainForm" method="post" action="/account/stremio/install"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary" type="submit">Create Stremio link</button></form><% } %>
          <% if(jellyfinNeedsPassword){ %><a class="button secondary" href="#jellyfin-access">Choose Jellyfin password</a><% } %>
        </div>
      </section>

      <section class="multiAccessSummary" aria-label="Active access">
        <div class="multiAccessHeading"><div><span class="eyebrow">Plans</span><h2>Your active access</h2></div><a class="button secondary small" href="#plans">View plans</a></div>
        <% if(!accessRows.length){ %><div class="empty">No active access.</div><% } else { %><div class="multiAccessGrid"><% accessRows.forEach(function(s){ %><article class="accessSummaryCard"><div class="accessSummaryTop"><span class="pill <%= s.status==='past_due'||s.status==='paused'?'warn':'good' %>"><%= statusText(s) %></span><span class="accessType"><%= accessKind(s) %></span></div><strong class="accessSummaryPlan"><%= displayPlan(s) %></strong><div class="accessSummaryMeta"><span><%= duration(s) %></span><% if(s.is_free_tier){ %><span>Permanent while active under Free Server rules</span><% } else if(s.current_period_end){ %><span><%= String(s.billing_interval_snapshot||s.billing_interval)==='trial'?'Trial ends':'Current period ends' %> <strong><%= formatDate(s.current_period_end) %></strong></span><% } %><% if(planService(s)==='jellyfin'||planService(s)==='bundle'){ %><span><%= Math.max(1,Number(s.streams||1)) %> Jellyfin stream<%= Number(s.streams||1)===1?'':'s' %></span><% } %></div><% if(sameSubscription(s,renewal)&&isRecurring(s)){ %><div class="accessSummaryMeta"><span><%= s.cancel_at_period_end?'Automatic renewal is stopped.':'Automatic renewal is on.' %></span></div><form id="renewal-control" class="plainForm" method="post" action="/account/subscription/renewal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= s.cancel_at_period_end?'resume':'stop' %>"><button class="button secondary full" type="submit"><%= s.cancel_at_period_end?'Resume automatic renewal':'Stop automatic renewal' %></button></form><% } %></article><% }) %></div><% } %>
      </section>

      <% if(hasJellyfin||portal.accounts.length){ %>
      <section class="sectionBlock simplePrimarySection" id="jellyfin-access">
        <div class="sectionHead"><div><h2>Jellyfin servers</h2><p>Each access lane keeps its own server profile, password and library selection.</p></div><div class="buttonRow"><a class="button secondary small" href="/account/activity" aria-label="Playback activity">View playback activity</a><% if(jellyfinPending){ %><form class="plainForm" method="post" action="/account/provisioning/retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary small" type="submit">Retry setup</button></form><% } %></div></div>
        <% if(provisioningState&&provisioningState.last_error){ %><div class="notice warn"><%= provisioningState.last_error %></div><% } %>
        <div class="accessGrid"><% portal.accounts.forEach(function(a){const ap=planForAccount(a); %><article class="accessCard simpleAccessCard"><div class="accessTop"><div><div class="accessTitle"><%= a.jellyfin_username %></div><div class="accessMeta"><%= a.server_name %></div></div><div class="accessLaneBadges"><span class="pill <%= a.access_lane==='free'?'good':'accent' %>"><%= a.access_lane==='free'?'Free Server':'Premium Jellyfin' %></span><span class="pill <%= a.disabled?'bad':'good' %>"><%= a.disabled?'Unavailable':'Ready' %></span></div></div><% if(ap){ %><div class="accessMeta"><strong><%= ap.contract_plan_name||ap.plan_name||ap.name||ap.code %></strong></div><% } %><% if(a.public_url){ %><div class="credentialCompact"><span>Server</span><strong><%= a.public_url %></strong></div><% } %><% if(a.password_setup_required){ %><div class="notice warn"><strong>Choose a password to finish setup.</strong></div><details class="detailsBox" open><summary>Choose Jellyfin password</summary><form method="post" action="/account/jellyfin/<%= a.id %>/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label>New password</label><input class="input" type="password" name="password" minlength="12" maxlength="200" autocomplete="new-password" required></div><div class="field"><label>Confirm password</label><input class="input" type="password" name="confirmPassword" minlength="12" maxlength="200" autocomplete="new-password" required></div><button class="button primary" type="submit">Save password</button></form></details><% } else { %><div class="buttonRow"><% if(a.public_url&&!a.disabled){ %><a class="button primary" href="<%= a.public_url %>" target="_blank" rel="noopener noreferrer">Open Jellyfin</a><% } %><details class="inlineManageDetails"><summary>Change password</summary><form method="post" action="/account/jellyfin/<%= a.id %>/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label>New password</label><input class="input" type="password" name="password" minlength="12" maxlength="200" autocomplete="new-password" required></div><div class="field"><label>Confirm password</label><input class="input" type="password" name="confirmPassword" minlength="12" maxlength="200" autocomplete="new-password" required></div><button class="button secondary" type="submit">Update password</button></form></details><%- renameControl(a) %></div><% } %></article><% }) %></div>

        <% if(Array.isArray(libraryProfiles)&&libraryProfiles.length){ %><div class="serverLibraries"><div class="sectionHead compact"><div><h3>Enabled libraries</h3><p>Library visibility is saved separately for each Jellyfin server.</p></div></div><div class="libraryServerGrid"><% libraryProfiles.forEach(function(profile){ %><article class="libraryServerCard"><div class="accessTop"><div><strong><%= profile.serverName %></strong><div class="accessMeta"><%= profile.username %></div></div><span class="pill <%= profile.accessLane==='free'?'good':'accent' %>"><%= profile.accessLane==='free'?'Free Server':'Premium Jellyfin' %></span></div><form method="post" action="/account/libraries/<%= profile.accountId %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="libraryGrid"><% profile.available.forEach(function(name){ %><label class="libraryChoice"><input type="checkbox" name="library" value="<%= name %>" <%= profile.selected.includes(name)?'checked':'' %>><span><%= name %></span></label><% }) %></div><div class="libraryActions"><button class="button secondary" type="submit">Save libraries for <%= profile.serverName %></button></div></form></article><% }) %></div></div><% } %>
      </section><% } %>

      <% if(hasStremio){ %><section class="sectionBlock simpleServiceCard" id="stremio-access"><div class="sectionHead"><div><h2>Stremio</h2><p>Install your private Stremio access and manage its household connection directly from here.</p></div><div class="buttonRow"><% if(stremioInstallUrl){ %><a class="button primary" href="<%= stremioInstallUrl %>">Install in Stremio</a><form class="plainForm" method="post" action="/account/stremio/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button danger" type="submit">Revoke link</button></form><% } else { %><form class="plainForm" method="post" action="/account/stremio/install"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary" type="submit">Create installation link</button></form><% } %></div></div><% if(stremioHousehold){ %><div class="panel" style="margin-bottom:12px"><strong>Household access</strong><div class="accessMeta"><%= stremioHousehold.accessModel %></div><% if(stremioHousehold.replacementState){ %><div class="accessMeta" style="margin-top:8px"><%= stremioHousehold.replacementState.message %></div><% if(stremioHousehold.replacementState.allowed){ %><form class="plainForm" method="post" action="/account/stremio/reset-household" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary" type="submit">Use a different household connection</button></form><% } else { %><div style="margin-top:10px"><span class="button secondary" aria-disabled="true">Household change on cooldown</span></div><% } %><% } %></div><% } %><% if(stremioManifestUrl){ %><div class="credentialCompact"><span>Installation manifest</span><strong><%= stremioManifestUrl %></strong></div><div class="accessMeta">Keep this link private. Revoking it invalidates the current installation link; you can create a replacement at any time.</div><% } else { %><div class="notice">Create your private installation link, then use the Install in Stremio button.</div><% } %></section><% } %>

      <% if(overseerrUrl){ %><section class="sectionBlock simpleServiceCard"><div class="sectionHead"><div><h2>Want something that's missing?</h2><p>Search for a movie or TV show and request it in Seerr.</p></div><a class="button secondary" href="<%= overseerrUrl %>" target="_blank" rel="noopener noreferrer">Request content</a></div>
        <% if(requestSyncConfigured&&requestAccess&&requestAccess.external_user_id){ %><div class="panel" style="margin-top:12px"><div class="sectionHead"><div><strong>Seerr sign-in password</strong><div class="accessMeta">Want one password for this portal and Seerr? Re-enter your current portal password and CAPTAiNFiN will send it directly to Seerr. The plaintext password is not stored.</div></div></div><details class="detailsBox"><summary>Sync portal password to Seerr</summary><form method="post" action="/account/requests/password/sync"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label>Current portal password</label><input class="input" type="password" name="currentPortalPassword" minlength="12" maxlength="200" autocomplete="current-password" required></div><button class="button secondary" type="submit">Sync portal password to Seerr</button></form></details></div><% } %>
        <% if(requestSyncConfigured&&requestAccess&&requestAccess.external_user_id&&requestAccess.password_reset_required){ %><div class="notice warn">Your request account needs a password once. <details class="detailsBox"><summary>Set a different Seerr password</summary><form method="post" action="/account/requests/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label>New password</label><input class="input" type="password" name="password" minlength="12" maxlength="200" autocomplete="new-password" required></div><div class="field"><label>Confirm password</label><input class="input" type="password" name="confirmPassword" minlength="12" maxlength="200" autocomplete="new-password" required></div><button class="button secondary" type="submit">Save Seerr password</button></form></details></div><% } %>
      </section><% } %>

      <section class="sectionBlock manageHub" id="plans"><div class="sectionHead"><div><h2>Plans &amp; payments</h2><p>Add or change Premium Jellyfin and Stremio without giving up your Free Server access.</p></div></div>
        <% if(openChange){ %><div class="panel" id="open-plan-change" style="margin-bottom:14px"><div class="sectionHead compact"><div><h3>Open plan change</h3><p><strong><%= openChange.target_plan_name||openChange.target_plan_code||'Selected plan' %></strong></p></div><span class="pill <%= openChange.state==='awaiting_checkout'?'warn':'accent' %>"><%= planChangeState(openChange) %></span></div><div class="accessMeta"><%= openChange.effective_at?`Change date: ${formatDate(openChange.effective_at)}.`:'Change date not available.' %> <%= openChange.state==='awaiting_checkout'?'Fresh checkout is required before this target can start.':'It will apply at the scheduled renewal boundary.' %></div><form class="plainForm" method="post" action="/account/plan-change/cancel" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary" type="submit">Cancel plan change</button></form></div><% } %>
        <div class="sharedPromoPanel"><label for="shared-promo-code"><strong>Promo code</strong><span>Optional · prices update here before checkout.</span></label><div class="sharedPromoLine"><input class="input" id="shared-promo-code" data-shared-promo maxlength="40" autocomplete="off" placeholder="Enter promo code"><button class="button secondary" type="button" data-clear-promo>Clear</button></div><div class="promoStatus" data-promo-status>Stripe subscription promos reduce the first payment. PayPal recurring plans cannot be repriced, so promo checkout uses PayPal one-time payment.</div></div>
        <% if(!plans.length){ %><div class="empty">No plans are currently available.</div><% } %>
        <% accessGroups.forEach(function(group){ %><section class="accessPlanGroup" data-plan-family="<%= group.key %>"><div class="accessPlanGroupHead"><div><h3><%= group.title %></h3><p><%= group.description %></p></div></div><div class="plansGrid"><% group.plans.forEach(function(p){const opts=Array.isArray(p.payment_options)?p.payment_options:[],stripeOpt=opts.find(o=>o.provider==='stripe'),paypalOpt=opts.find(o=>o.provider==='paypal'),plisioOpt=opts.find(o=>o.provider==='plisio'),isFreePlan=Number(p.price_minor)===0&&p.billing_interval!=='trial',lane=laneEntitlement(p),laneSubscription=subscriptionForEntitlement(lane),isCurrent=Boolean(lane&&String(lane.plan_id||lane.id)===String(p.id)),paypalBlocked=Boolean(isRecurring(laneSubscription)&&laneSubscription.source==='paypal'&&!laneSubscription.cancel_at_period_end),pType=planService(p); %><article class="planCard <%= isCurrent?'current':'' %>" data-plan-code="<%= p.code %>" data-plan-currency="<%= p.currency||currency||'USD' %>" data-plan-base-minor="<%= Number(p.price_minor||0) %>"><div class="planTop"><div><div class="planName"><%= p.name %></div><div class="planDuration"><%= duration(p) %></div></div><% if(isCurrent){ %><span class="pill accent">Current</span><% } %></div><div class="planPrice" data-plan-price><%= price(p) %></div><div class="promoPriceNote" data-promo-price-note hidden></div><div class="planDescription"><%= p.description||'Streaming access managed through your account.' %></div><ul class="featureList"><li><%= accessModel(p) %></li><li><%= pType==='stremio'?'Private Stremio installation':p.allow_downloads?'Downloads included':'Streaming only' %></li></ul><div class="planActions"><% if(isCurrent){ %><span class="button secondary full">Current plan</span><% } else { %><% if(p.billing_interval==='trial'){ %><form class="plainForm" method="post" action="/account/trial/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><button class="button primary full" type="submit">Start free trial</button></form><% } %><% if(isFreePlan){ %><form class="plainForm" method="post" action="/account/claim-free/<%= p.code %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button free full" type="submit">Get free access</button></form><% } %><% if(Number(p.price_minor)>0&&stripeEnabled&&stripeOpt){ %><div class="paymentNote"><%= stripeChangeCopy(p) %></div><form class="plainForm checkoutForm" method="post" action="/account/checkout/stripe"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input type="hidden" name="discountCode" data-promo-target><button class="button stripe full" type="submit"><%= stripeButtonCopy(p) %></button></form><% } %><% if(Number(p.price_minor)>0&&paypalEnabled&&paypalOpt){ %><% if(paypalBlocked){ %><div class="paymentNote">Stop the current PayPal renewal before replacing this same service.</div><a class="button secondary full" href="#renewal-control">Stop PayPal renewal first</a><% } else { %><form class="plainForm checkoutForm" method="post" action="/account/checkout/paypal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input type="hidden" name="discountCode" data-promo-target><button class="button paypal full" type="submit">Continue with PayPal</button></form><% } %><% } %><% if(Number(p.price_minor)>0&&plisioEnabled&&plisioOpt){ %><form class="plainForm checkoutForm" method="post" action="/account/checkout/plisio"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input type="hidden" name="checkoutMode" value="payment"><input type="hidden" name="discountCode" data-promo-target><button class="button primary full" type="submit">Plisio · One-off payment</button></form><% } %><% } %></div></article><% }) %></div></section><% }) %>
      </section>

      <section class="sectionBlock manageHub"><div class="sectionHead"><div><h2>Manage my account</h2><p>Billing history, payment methods and account settings.</p></div></div><div class="buttonRow"><a class="button secondary" href="/account/history">Payments</a><% if(portal.providers.some(p=>p.provider==='stripe')&&stripeEnabled){ %><form class="plainForm" method="post" action="/account/stripe/portal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button stripe" type="submit">Manage Stripe billing</button></form><% } %><% if(referralsEnabled){ %><a class="button secondary" href="/account/affiliate">Affiliate · copy referral link</a><% } %><a class="button secondary" href="/account/security">Account</a><a class="button secondary" href="/account/communications">Notifications</a><a class="button secondary" href="/account/docs">Help</a></div></section>
    </main>
  </div>
</div>
</body>
</html>
