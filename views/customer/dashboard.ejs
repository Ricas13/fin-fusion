<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>My account · <%= siteName %></title>
  <link rel="icon" href="/branding/favicon">
  <link rel="stylesheet" href="/css/customer-portal.css">
</head>
<%
  function safeDate(value) {
    if (!value) return 'Not available';
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return 'Not available';
    return parsed.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' });
  }
  function price(plan) {
    if (Number(plan.price_minor || 0) === 0) return 'Free';
    try {
      return new Intl.NumberFormat('en-GB', { style: 'currency', currency: plan.currency || 'USD' }).format(Number(plan.price_minor) / 100);
    } catch (_) {
      return `${plan.currency || 'USD'} ${(Number(plan.price_minor) / 100).toFixed(2)}`;
    }
  }
  function duration(plan) {
    const labels = { trial: '24-hour trial', month: 'Monthly', '6_months': '6 months', year: 'Yearly', custom: 'Custom duration' };
    if (labels[plan.billing_interval]) return labels[plan.billing_interval];
    if (plan.duration_days) return `${plan.duration_days} days`;
    return 'Subscription';
  }
  const username = portal.customer.login_username || portal.customer.display_name || 'customer';
  const activeAccount = portal.accounts.find(a => !a.disabled) || portal.accounts[0] || null;
  const activePlanId = currentPlan ? (currentPlan.plan_id || currentPlan.id) : null;
  const currentName = currentPlan ? (currentPlan.name || currentPlan.plan_name || currentPlan.code) : 'No active plan';
  const currentStreams = currentPlan ? Number(currentPlan.streams || 0) : 0;
  const visibleLibraryCount = Array.isArray(librarySelection) ? librarySelection.length : 0;
  const referralsEnabled = Boolean(portal.referralsEnabled && portal.referralCode);
%>
<body>
<div class="portalShell">
  <header class="portalTopbar">
    <div class="portalTopbarInner">
      <a class="brandLockup" href="/account">
        <img class="brandLogo" src="/branding/logo" alt="">
        <div>
          <div class="brandName"><%= siteName %></div>
          <div class="brandMeta">Customer account</div>
        </div>
      </a>
      <div class="portalActions">
        <span class="userLabel brandMeta">Signed in as <strong><%= username %></strong></span>
        <form class="plainForm" method="post" action="/account/logout"><button class="button danger" type="submit">Sign out</button></form>
      </div>
    </div>
  </header>

  <main class="portalMain">
    <% if (message) { %><div class="flash ok"><%= message %></div><% } %>
    <% if (error) { %><div class="flash err"><%= error %></div><% } %>

    <section class="heroCard">
      <div class="welcomePanel">
        <div class="eyebrow">Your account</div>
        <h1>Welcome back, <%= username %>.</h1>
        <p>Manage your streaming access, Jellyfin account, libraries and subscription from one place.</p>
        <div class="heroButtons">
          <% if (activeAccount && activeAccount.public_url && !activeAccount.disabled) { %><a class="button primary" href="<%= activeAccount.public_url %>" target="_blank" rel="noopener noreferrer">Open Jellyfin</a><% } %>
          <a class="button secondary" href="#plans">View plans</a>
          <% if (overseerrUrl) { %><a class="button secondary" href="<%= overseerrUrl %>" target="_blank" rel="noopener noreferrer">Request content</a><% } %>
        </div>
      </div>
      <aside class="summaryPanel" aria-label="Account summary">
        <div class="summaryItem"><div><div class="summaryLabel">Current plan</div></div><div class="summaryValue"><%= currentName %></div></div>
        <div class="summaryItem"><div><div class="summaryLabel">Jellyfin</div></div><div class="summaryValue"><%= activeAccount ? (activeAccount.disabled ? 'Disabled' : 'Ready') : 'Not provisioned' %></div></div>
        <div class="summaryItem"><div><div class="summaryLabel">Libraries visible</div></div><div class="summaryValue"><%= libraryEntitlement && libraryEntitlement.length ? `${visibleLibraryCount} / ${libraryEntitlement.length}` : 'Plan controlled' %></div></div>
      </aside>
    </section>

    <section class="sectionBlock">
      <div class="sectionHead"><div><h2>Your access</h2><p>Your active subscription and Jellyfin account.</p></div></div>
      <div class="twoCol">
        <% if (currentPlan) { %>
          <article class="panel">
            <div class="accessHeader">
              <div><div class="accessTitle"><%= currentName %></div><div class="accessMeta">Access until <%= safeDate(currentPlan.current_period_end) %></div></div>
              <span class="pill accent"><%= currentPlan.status || 'active' %></span>
            </div>
            <div class="metricGrid">
              <div class="metric"><strong><%= currentStreams || 1 %></strong><span>Concurrent streams</span></div>
              <div class="metric"><strong><%= currentPlan.allow_downloads ? 'Included' : 'Off' %></strong><span>Downloads</span></div>
              <div class="metric"><strong><%= currentPlan.allow_video_transcoding ? 'Allowed' : 'Off' %></strong><span>Video transcode</span></div>
            </div>
            <div class="accessMeta" style="margin-top:11px">Activated via <%= currentPlan.source || 'subscription' %>.</div>
            <% if (portal.subscriptions.length > 1) { %>
              <details class="detailsBox"><summary>Subscription history</summary><div style="margin-top:8px;display:grid;gap:6px"><% portal.subscriptions.forEach(function(s){ %><div class="metric"><strong><%= s.plan_name %> · <%= s.status %></strong><span><%= safeDate(s.current_period_end) %></span></div><% }) %></div></details>
            <% } %>
          </article>
        <% } else { %>
          <div class="empty">You do not currently have an active subscription. Choose a plan below when you're ready.</div>
        <% } %>

        <% if (!portal.accounts.length) { %>
          <div class="empty">Your Jellyfin account will appear here once access is provisioned.</div>
        <% } %>
        <% portal.accounts.forEach(function(a){ %>
          <article class="panel">
            <div class="accessHeader">
              <div><div class="accessTitle"><%= a.jellyfin_username %></div><div class="accessMeta"><%= a.server_name %><%= a.server_class ? ` · ${a.server_class}` : '' %></div></div>
              <span class="pill <%= a.disabled ? 'warn' : 'good' %>"><%= a.disabled ? 'Disabled' : 'Enabled' %></span>
            </div>
            <% if (a.public_url) { %><a class="button primary" href="<%= a.public_url %>" target="_blank" rel="noopener noreferrer">Open Jellyfin</a><% } %>
            <details class="detailsBox">
              <summary>Change Jellyfin password</summary>
              <form method="post" action="/account/jellyfin/<%= a.id %>/password">
                <div class="field"><label>New password</label><input class="input" type="password" name="password" minlength="8" autocomplete="new-password" required></div>
                <button class="button secondary" type="submit">Update password</button>
              </form>
            </details>
          </article>
        <% }) %>
      </div>
    </section>

    <% if (libraryEntitlement && libraryEntitlement.length) { %>
      <section class="sectionBlock">
        <div class="sectionHead"><div><h2>Library visibility</h2><p>Choose which entitled libraries appear in Jellyfin.</p></div><span class="pill"><%= visibleLibraryCount %> of <%= libraryEntitlement.length %> selected</span></div>
        <div class="panel libraryPanel">
          <div class="libraryIntro"><p>Your plan determines what you are allowed to access. These controls only let you hide or show libraries already granted to you.</p></div>
          <form method="post" action="/account/libraries">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="libraryGrid">
              <% libraryEntitlement.forEach(function(name){ %>
                <label class="libraryChoice"><input type="checkbox" name="library" value="<%= name %>" <%= librarySelection.includes(name) ? 'checked' : '' %>><span><%= name %></span></label>
              <% }) %>
            </div>
            <div class="libraryActions"><button class="button primary" type="submit">Save library visibility</button></div>
          </form>
        </div>
      </section>
    <% } %>

    <% if (overseerrUrl) { %>
      <section class="sectionBlock">
        <div class="sectionHead"><div><h2>Request content</h2></div></div>
        <div class="panel requestCard"><p>Looking for something that isn't available yet? Open the request portal.</p><a class="button secondary" href="<%= overseerrUrl %>" target="_blank" rel="noopener noreferrer">Open request site</a></div>
      </section>
    <% } %>

    <section class="sectionBlock" id="plans">
      <div class="sectionHead"><div><h2>Plans</h2><p>Compare access levels and change your subscription when payment options are available.</p></div></div>
      <% if (!plans.length) { %><div class="empty">No plans are currently available.</div><% } %>
      <div class="plansGrid">
      <% plans.forEach(function(p){
           const opts=Array.isArray(p.payment_options)?p.payment_options:[];
           const stripeOpt=opts.find(o=>o.provider==='stripe');
           const paypalOpt=opts.find(o=>o.provider==='paypal');
           const isFreePlan = Number(p.price_minor)===0 && p.billing_interval!=='trial';
           const isCurrent = Boolean(activePlanId && String(activePlanId)===String(p.id));
      %>
        <article class="planCard <%= isCurrent ? 'current' : '' %>">
          <div class="planTop"><div><div class="planName"><%= p.name %></div><div class="planDuration"><%= duration(p) %></div></div><% if (isCurrent) { %><span class="pill accent">Current</span><% } %></div>
          <div class="planPrice"><%= price(p) %></div>
          <div class="planDescription"><%= p.description || 'Streaming access managed through your account.' %></div>
          <ul class="featureList">
            <li><%= p.streams %> concurrent stream<%= Number(p.streams)===1?'':'s' %></li>
            <li><%= p.allow_downloads ? 'Downloads included' : 'Streaming only' %></li>
            <li><%= p.allow_video_transcoding ? 'Video transcoding allowed' : 'Direct playback preferred' %></li>
          </ul>
          <div class="planActions">
            <% if (isCurrent) { %><span class="button secondary full">Current plan</span><% } else { %>
              <% if (p.billing_interval === 'trial') { %><form class="plainForm" method="post" action="/account/trial/start"><button class="button primary full" type="submit">Start free trial</button></form><% } %>
              <% if (isFreePlan) { %><form class="plainForm" method="post" action="/account/claim-free/<%= p.code %>"><button class="button free full" type="submit">Get free access</button></form><% } %>
              <% if (Number(p.price_minor) > 0 && stripeEnabled && stripeOpt) { %><form class="plainForm" method="post" action="/account/checkout/stripe"><input type="hidden" name="planCode" value="<%= p.code %>"><input class="input discountField" name="discountCode" placeholder="Discount code (optional)" maxlength="40"><button class="button stripe full" type="submit">Pay with Stripe</button></form><% } %>
              <% if (Number(p.price_minor) > 0 && paypalEnabled && paypalOpt) { %><form class="plainForm" method="post" action="/account/checkout/paypal"><input type="hidden" name="planCode" value="<%= p.code %>"><% if (paypalOpt.checkoutMode !== 'subscription') { %><input class="input discountField" name="discountCode" placeholder="Discount code (optional)" maxlength="40"><% } %><button class="button paypal full" type="submit">Pay with PayPal</button></form><% } %>
              <% if (Number(p.price_minor) > 0 && !stripeOpt && !paypalOpt) { %><div class="paymentNote">Online payment is not configured for this plan yet.</div><% } %>
            <% } %>
          </div>
        </article>
      <% }) %>
      </div>
    </section>

    <% if (portal.providers.some(p=>p.provider==='stripe') && stripeEnabled) { %>
      <section class="sectionBlock">
        <div class="sectionHead"><div><h2>Billing</h2></div></div>
        <div class="panel billingRow"><div><div class="accessTitle">Stripe billing</div><div class="accessMeta">Manage payment methods, invoices and your billing profile.</div></div><form class="plainForm" method="post" action="/account/stripe/portal"><button class="button stripe" type="submit">Manage billing</button></form></div>
      </section>
    <% } %>

    <% if (referralsEnabled) { %>
      <section class="sectionBlock">
        <div class="sectionHead"><div><h2>Refer a friend</h2><p>Share your referral link and receive the configured reward when a referral qualifies.</p></div></div>
        <div class="panel">
          <div class="referralLayout">
            <div><div class="codeLabel">Referral link</div><div class="copyLine"><input class="input referralCode" id="refLink" readonly data-path="/account/register?ref=<%= portal.referralCode %>" value="/account/register?ref=<%= portal.referralCode %>"><button type="button" class="button primary" id="copyReferral">Copy link</button></div></div>
            <div><div class="codeLabel">Referral code</div><input class="input referralCode" readonly value="<%= portal.referralCode %>"></div>
          </div>
        </div>
      </section>
    <% } %>
  </main>
</div>
<script>
(function(){
  const input=document.getElementById('refLink');
  if(input&&input.dataset.path) input.value=location.origin+input.dataset.path;
  const button=document.getElementById('copyReferral');
  button?.addEventListener('click',async()=>{if(!input)return;try{await navigator.clipboard.writeText(input.value);const old=button.textContent;button.textContent='Copied';setTimeout(()=>button.textContent=old,1200)}catch(_){input.select()}});
})();
</script>
</body>
</html>
