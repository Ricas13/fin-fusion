<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>My account · <%= siteName %></title>
  <link rel="icon" href="/branding/favicon">
  <link rel="stylesheet" href="/css/customer-portal.css">
  <link rel="stylesheet" href="/css/customer-dashboard.css">
  <link rel="stylesheet" href="/css/customer-navigation.css">
</head>
<%
  function validDate(value) { if (!value) return null; const parsed=new Date(value); return Number.isNaN(parsed.getTime())?null:parsed; }
  function formatDate(value) { const parsed=validDate(value); return parsed?parsed.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}):'Not available'; }
  function formatDateTime(value) { const parsed=validDate(value); return parsed?parsed.toLocaleString('en-GB',{dateStyle:'medium',timeStyle:'short'}):'Not available'; }
  function price(plan) { if(Number(plan&&plan.price_minor||0)===0)return'Free';try{return new Intl.NumberFormat('en-GB',{style:'currency',currency:plan.currency||'USD'}).format(Number(plan.price_minor||0)/100)}catch(_){return `${plan.currency||'USD'} ${(Number(plan.price_minor||0)/100).toFixed(2)}`;} }
  function duration(plan) { const labels={trial:'24-hour trial',month:'Monthly','6_months':'6 months',year:'Yearly',custom:'Custom duration'};if(plan&&labels[plan.billing_interval])return labels[plan.billing_interval];if(plan&&plan.duration_days)return `${plan.duration_days} days`;return'Subscription'; }
  function monthlyValue(plan){const amount=Number(plan&&((plan.price_minor_snapshot!=null)?plan.price_minor_snapshot:plan.price_minor)||0),interval=String(plan&&((plan.billing_interval_snapshot)||plan.billing_interval)||''),days=Math.max(1,Number(plan&&((plan.duration_days_snapshot!=null)?plan.duration_days_snapshot:plan.duration_days)||30));if(interval==='month')return amount;if(interval==='6_months')return amount/6;if(interval==='year')return amount/12;return amount*30.4375/days;}
  const username=portal.customer.login_username||portal.customer.login_email||portal.customer.display_name||'Customer';
  const primaryAccount=portal.accounts.find(a=>a.is_primary&&!a.disabled)||portal.accounts.find(a=>!a.disabled)||portal.accounts[0]||null;
  const activePlanId=currentPlan?(currentPlan.plan_id||currentPlan.id):null;
  const activeSubscription=Array.isArray(portal.subscriptions)?(portal.subscriptions.find(s=>['active','trialing','past_due','paused'].includes(String(s.status||''))&&(!s.current_period_end||(validDate(s.current_period_end)&&validDate(s.current_period_end).getTime()>Date.now())))||portal.subscriptions[0]||null):null;
  const recurringSubscription=Boolean(activeSubscription&&((activeSubscription.source==='stripe'&&/^sub_/i.test(String(activeSubscription.provider_subscription_id||'')))||(activeSubscription.source==='paypal'&&/^I-/i.test(String(activeSubscription.provider_subscription_id||'')))));
  const visibleLibraryCount=Array.isArray(librarySelection)?librarySelection.length:0;
  const referralsEnabled=Boolean(portal.referralsEnabled&&portal.referralCode),referralCode=portal.referralCode||'';
  function stripeChangeCopy(plan){if(!recurringSubscription||activeSubscription.source!=='stripe')return'Starts after Stripe confirms payment.';const upgrade=monthlyValue(plan)>monthlyValue(activeSubscription);return upgrade?'Upgrade: changes immediately. Stripe may charge a prorated amount today.':`Change: scheduled for your next renewal${activeSubscription.current_period_end?' on '+formatDate(activeSubscription.current_period_end):''}. No overlapping subscription is created.`;}
  function stripeButtonCopy(plan){if(!recurringSubscription||activeSubscription.source!=='stripe')return'Continue with Stripe';return monthlyValue(plan)>monthlyValue(activeSubscription)?'Upgrade with Stripe':'Change at next renewal';}
%>
<body>
<div class="portalShell">
  <header class="portalTopbar"><div class="portalTopbarInner"><div class="brandLockup"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= siteName %></div><div class="brandMeta">My account</div></div></div><div class="portalActions"><span class="signedIn">Signed in as <strong><%= username %></strong></span><form method="post" action="/account/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button ghost small" type="submit">Sign out</button></form></div></div></header>
  <div class="customerLayout">
    <aside class="customerSidebar" aria-label="Customer navigation">
      <div class="customerNavTitle">My account</div>
      <%- include('_nav',{active:'overview',showBenefits:referralsEnabled}) %>
      <% if(overseerrUrl){ %><a class="customerNavLink" href="<%= overseerrUrl %>" target="_blank" rel="noopener noreferrer"><span>Request content ↗</span></a><% } %>
    </aside>
    <main class="portalMain">
    <% if (message) { %><div class="notice success"><%= message %></div><% } %>
    <% if (error) { %><div class="notice error"><%= error %></div><% } %>
    <% if(welcome&&currentPlan){ %><div class="accessWelcomeBackdrop"><section class="accessWelcomeModal"><div class="welcomeSuccessIcon"><%= primaryAccount?'✓':'…' %></div><div class="eyebrow"><%= primaryAccount?'Access ready':'Access claimed' %></div><h1><%= primaryAccount?'Your streaming access is ready':'We are setting up your streaming access' %></h1><% if(primaryAccount){ %><p>Your Jellyfin account is ready on <strong><%= primaryAccount.server_name %></strong>. Save these details.</p><div class="credentialGrid"><div><span>Server</span><strong><%= primaryAccount.public_url||'Available from your account' %></strong></div><div><span>Username</span><strong><%= primaryAccount.jellyfin_username %></strong></div><div><span>Password</span><strong><%= primaryAccount.password_setup_required?'Choose your password below':'Your existing Jellyfin password' %></strong></div></div><div class="welcomeActions"><a class="button primary" href="#jellyfin-access">Set up / manage password</a><% if(primaryAccount.public_url&&!primaryAccount.password_setup_required){ %><a class="button free" href="<%= primaryAccount.public_url %>" target="_blank" rel="noopener noreferrer">Open Jellyfin</a><% } %><a class="button secondary" href="/account">Continue to account</a></div><% } else { %><p>Your plan is active. We are still creating your Jellyfin account and will keep retrying automatically.</p><% if(provisioningState&&provisioningState.last_error){ %><div class="welcomeError"><%= provisioningState.last_error %></div><% } %><form method="post" action="/account/provisioning/retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary full" type="submit">Try setup again now</button></form><a class="button secondary full" href="/account">Continue to account</a><% } %></section></div><% } %>

    <section class="accountHero"><div><div class="eyebrow">Your access</div><h1>Welcome back, <%= username %>.</h1><p>See what is ready, open your streaming services and manage your plan from one place.</p></div><div class="heroActions"><% if(primaryAccount&&primaryAccount.public_url&&!primaryAccount.disabled&&!primaryAccount.password_setup_required){ %><a class="button primary" href="<%= primaryAccount.public_url %>" target="_blank" rel="noopener noreferrer">Open Jellyfin</a><% } %><% if(hasStremio){ %><a class="button secondary" href="/account/stremio">Open Stremio setup</a><% } %><a class="button secondary" href="#plans">Plan &amp; billing</a><% if(overseerrUrl){ %><a class="button secondary" href="<%= overseerrUrl %>" target="_blank" rel="noopener noreferrer">Request content</a><% } %></div></section>

    <section class="overviewGrid"><article class="metricCard"><div class="metricLabel">Current plan</div><div class="metricValue"><%= currentPlan?(currentPlan.name||currentPlan.plan_name||currentPlan.code):'No active plan' %></div><div class="metricSub"><%= currentPlan?duration(currentPlan):'Choose a plan below' %></div></article><article class="metricCard"><div class="metricLabel">Concurrent streams</div><div class="metricValue"><%= currentPlan?currentPlan.streams:'—' %></div><div class="metricSub"><%= currentPlan?'Your plan allowance':'No active access' %></div></article><article class="metricCard"><div class="metricLabel">Jellyfin</div><div class="metricValue"><%= primaryAccount?(primaryAccount.disabled?'Needs attention':'Ready'):(hasJellyfin?'Setting up':'Not included') %></div><div class="metricSub"><%= primaryAccount?primaryAccount.server_name:(hasJellyfin?'We will keep retrying':'') %></div></article><article class="metricCard"><div class="metricLabel">Content requests</div><div class="metricValue"><%= requestAccess&&requestAccess.external_user_id?'Ready':(overseerrUrl?'Setting up':'Not available') %></div><div class="metricSub"><%= requestAccess&&requestAccess.external_email?requestAccess.external_email:(overseerrUrl?'Use the request section below':'') %></div></article></section>

    <section class="sectionBlock"><div class="sectionHead"><div><h2>Current plan</h2><p>Your access and renewal date.</p></div></div>
      <% if(activeSubscription){ %>
        <div class="panel subscriptionPanel"><div><div class="accessTitle"><%= activeSubscription.plan_name||activeSubscription.name||activeSubscription.code||'Subscription' %></div><div class="accessMeta"><span class="pill <%= activeSubscription.status==='active'?'good':activeSubscription.status==='past_due'?'warn':'' %>"><%= activeSubscription.status==='past_due'?'Payment needs attention':activeSubscription.status %></span><span>Access until <strong><%= formatDate(activeSubscription.current_period_end) %></strong></span><span><%= activeSubscription.cancel_at_period_end?'Renewal will stop':'Renews automatically unless changed' %></span></div></div><div class="heroActions"><a class="button secondary" href="/account/history">Billing history</a><% if(recurringSubscription&&!activeSubscription.cancel_at_period_end){ %><form class="plainForm" method="post" action="/account/subscription/renewal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="stop"><button class="button secondary" type="submit">Stop renewal</button></form><% } else if(recurringSubscription&&activeSubscription.cancel_at_period_end&&activeSubscription.source==='stripe'){ %><form class="plainForm" method="post" action="/account/subscription/renewal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="resume"><button class="button primary" type="submit">Resume renewal</button></form><% } %></div></div>
        <% if(recurringSubscription&&activeSubscription.cancel_at_period_end&&activeSubscription.source==='paypal'){ %><div class="notice">PayPal renewal is stopped. Your paid access remains until <strong><%= formatDate(activeSubscription.current_period_end) %></strong>. A new PayPal authorization is required when you start another recurring plan.</div><% } %>
      <% } else { %><div class="empty">You do not currently have an active plan.</div><% } %>
    </section>

    <section class="sectionBlock" id="streaming"><div class="sectionHead"><div><h2>Streaming</h2><p>Open and manage the services included in your plan.</p></div></div>
      <section id="jellyfin-access"><div class="sectionHead"><div><h2>Jellyfin</h2><p>Your Jellyfin sign-in and server.</p></div><% if(hasStremio){ %><a class="button secondary small" href="/account/stremio">Stremio setup</a><% } %></div><div class="accessGrid"><% if(!portal.accounts.length&&hasJellyfin){ %><div class="provisioningPanel <%= provisioningState&&provisioningState.status==='failed'?'failed':'pending' %>"><div><strong><%= provisioningState&&provisioningState.status==='failed'?'Setup needs your attention':'Setting up your Jellyfin account' %></strong><p><%= provisioningState&&provisioningState.last_error?provisioningState.last_error:'Your plan is active. We are creating your Jellyfin account and will retry automatically if needed.' %></p><% if(provisioningState&&provisioningState.next_attempt_at){ %><small>Next automatic try: <%= formatDateTime(provisioningState.next_attempt_at) %></small><% } %></div><form method="post" action="/account/provisioning/retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary" type="submit">Try again now</button></form></div><% } %><% portal.accounts.forEach(function(a){ %><article class="accessCard"><div class="accessTop"><div><div class="accessTitle"><%= a.jellyfin_username %></div><div class="accessMeta"><%= a.server_name %></div></div><span class="pill <%= a.disabled?'bad':'good' %>"><%= a.disabled?'Needs attention':'Ready' %></span></div><div class="accessMeta"><span>Last used <strong><%= a.last_activity_at?formatDateTime(a.last_activity_at):'Not yet' %></strong></span></div><% if(a.password_setup_required){ %><div class="notice warn"><strong>Choose your Jellyfin password before signing in.</strong></div><% } %><% if(a.public_url&&!a.disabled&&!a.password_setup_required){ %><a class="button primary" href="<%= a.public_url %>" target="_blank" rel="noopener noreferrer">Open Jellyfin</a><% } %><details class="detailsBox" <%= a.password_setup_required?'open':'' %>><summary><%= a.password_setup_required?'Set Jellyfin password':'Change Jellyfin password' %></summary><form method="post" action="/account/jellyfin/<%= a.id %>/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label>New password</label><input class="input" type="password" name="password" minlength="12" maxlength="200" autocomplete="new-password" required></div><div class="field"><label>Confirm password</label><input class="input" type="password" name="confirmPassword" minlength="12" maxlength="200" autocomplete="new-password" required></div><button class="button secondary" type="submit"><%= a.password_setup_required?'Set password':'Update password' %></button></form></details></article><% }) %></div></section>
    </section>

    <% if(libraryEntitlement&&libraryEntitlement.length){ %><section class="sectionBlock"><div class="sectionHead"><div><h2>Your libraries</h2><p>Hide or show libraries already included in your plan.</p></div><span class="pill"><%= visibleLibraryCount %> of <%= libraryEntitlement.length %> shown</span></div><div class="panel libraryPanel"><form method="post" action="/account/libraries"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="libraryGrid"><% libraryEntitlement.forEach(function(name){ %><label class="libraryChoice"><input type="checkbox" name="library" value="<%= name %>" <%= librarySelection.includes(name)?'checked':'' %>><span><%= name %></span></label><% }) %></div><div class="libraryActions"><button class="button primary" type="submit">Save library choices</button></div></form></div></section><% } %>

    <% if(overseerrUrl){ %><section class="sectionBlock"><div class="sectionHead"><div><h2>Request content</h2><p>Use one request account for your CAPTAiNFiN access.</p></div><% if(requestAccess&&requestAccess.external_user_id){ %><span class="pill <%= requestAccess.password_reset_required?'warn':'good' %>"><%= requestAccess.password_reset_required?'Set password':'Ready' %></span><% } %></div><div class="panel requestCard"><% if(!requestSyncConfigured){ %><p>Content requests are available, but automatic account setup is not ready yet. Contact support if you need access.</p><% } else if(!requestAccess||!requestAccess.external_user_id){ %><p>Your request account is still being prepared. If this does not clear, contact support.</p><% } else { %><p>Your request sign-in is <strong><%= requestAccess.external_email||requestAccess.customer_email||'linked' %></strong>.</p><details class="detailsBox" <%= requestAccess.password_reset_required?'open':'' %>><summary><%= requestAccess.password_reset_required?'Set request-site password':'Change request-site password' %></summary><form method="post" action="/account/requests/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label>New password</label><input class="input" type="password" name="password" minlength="12" maxlength="200" autocomplete="new-password" required></div><div class="field"><label>Confirm password</label><input class="input" type="password" name="confirmPassword" minlength="12" maxlength="200" autocomplete="new-password" required></div><button class="button secondary" type="submit">Update request password</button></form></details><% } %><a class="button secondary" href="<%= overseerrUrl %>" target="_blank" rel="noopener noreferrer">Open request site</a></div></section><% } %>

    <section class="sectionBlock" id="plans"><div class="sectionHead"><div><h2>Plan &amp; billing</h2><p>Before you confirm a change, the card tells you whether it happens now or at your next renewal.</p></div><a class="button secondary small" href="/account/history">Billing history</a></div><% if(!plans.length){ %><div class="empty">No plans are currently available.</div><% } %><div class="plansGrid"><% plans.forEach(function(p){const opts=Array.isArray(p.payment_options)?p.payment_options:[],stripeOpt=opts.find(o=>o.provider==='stripe'),paypalOpt=opts.find(o=>o.provider==='paypal'),isFreePlan=Number(p.price_minor)===0&&p.billing_interval!=='trial',isCurrent=Boolean(activePlanId&&String(activePlanId)===String(p.id)),hideFreeOrTrial=Boolean(activeSubscription&&Number(p.price_minor)===0&&!isCurrent),paypalBlocked=Boolean(recurringSubscription&&activeSubscription.source==='paypal'&&!activeSubscription.cancel_at_period_end); %><article class="planCard <%= isCurrent?'current':'' %>"><div class="planTop"><div><div class="planName"><%= p.name %></div><div class="planDuration"><%= duration(p) %></div></div><% if(isCurrent){ %><span class="pill accent">Current</span><% } %></div><div class="planPrice"><%= price(p) %></div><div class="planDescription"><%= p.description||'Streaming access managed through your account.' %></div><ul class="featureList"><li><%= p.streams %> concurrent stream<%= Number(p.streams)===1?'':'s' %></li><li><%= p.allow_downloads?'Downloads included':'Streaming only' %></li><li><%= p.allow_video_transcoding?'Video transcoding allowed':'Direct playback preferred' %></li></ul><div class="planActions"><% if(isCurrent){ %><span class="button secondary full">Current plan</span><% } else if(hideFreeOrTrial){ %><div class="paymentNote">Free and trial access are hidden while your current paid access is active.</div><% } else { %><% if(p.billing_interval==='trial'){ %><div class="paymentNote">Starts immediately after you confirm.</div><form class="plainForm" method="post" action="/account/trial/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><button class="button primary full" type="submit">Start free trial</button></form><% } %><% if(isFreePlan){ %><div class="paymentNote">Starts immediately if a free place is available.</div><form class="plainForm" method="post" action="/account/claim-free/<%= p.code %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button free full" type="submit">Get free access</button></form><% } %><% if(Number(p.price_minor)>0&&stripeEnabled&&stripeOpt){ %><div class="paymentNote"><strong>Stripe:</strong> <%= stripeChangeCopy(p) %></div><form class="plainForm" method="post" action="/account/checkout/stripe"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input class="input discountField" name="discountCode" placeholder="Discount code (optional)" maxlength="40"><button class="button stripe full" type="submit"><%= stripeButtonCopy(p) %></button></form><% } %><% if(Number(p.price_minor)>0&&paypalEnabled&&paypalOpt){ %><% if(paypalBlocked){ %><div class="paymentNote"><strong>PayPal:</strong> PayPal cannot swap an active recurring agreement. Stop renewal first; your current access remains active until <%= formatDate(activeSubscription.current_period_end) %>.</div><span class="button secondary full" aria-disabled="true">Stop PayPal renewal first</span><% } else { %><div class="paymentNote"><strong>PayPal:</strong> <%= recurringSubscription&&activeSubscription.source==='paypal'&&activeSubscription.cancel_at_period_end?`This records your next plan. Current access remains until ${formatDate(activeSubscription.current_period_end)}; a fresh PayPal authorization will be required after that date.`:'Starts after PayPal confirms the payment or subscription.' %></div><form class="plainForm" method="post" action="/account/checkout/paypal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><% if(paypalOpt.checkoutMode!=='subscription'){ %><input class="input discountField" name="discountCode" placeholder="Discount code (optional)" maxlength="40"><% } %><button class="button paypal full" type="submit"><%= recurringSubscription&&activeSubscription.source==='paypal'&&activeSubscription.cancel_at_period_end?'Choose for next renewal':'Continue with PayPal' %></button></form><% } %><% } %><% if(Number(p.price_minor)>0&&!stripeOpt&&!paypalOpt){ %><div class="paymentNote">Online payment is not available for this plan yet.</div><% } %><% } %></div></article><% }) %></div></section>

    <% if(portal.providers.some(p=>p.provider==='stripe')&&stripeEnabled){ %><section class="sectionBlock"><div class="sectionHead"><div><h2>Stripe billing</h2></div></div><div class="panel billingRow"><div><div class="accessTitle">Payment methods &amp; invoices</div><div class="accessMeta">Open Stripe to manage your saved payment method and billing details.</div></div><form class="plainForm" method="post" action="/account/stripe/portal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button stripe" type="submit">Manage Stripe billing</button></form></div></section><% } %>

    <% if(referralsEnabled){ %><section class="sectionBlock"><div class="sectionHead"><div><h2>Benefits</h2><p>Share your referral code. Rewards follow the current affiliate programme rules.</p></div><a class="button secondary small" href="/account/affiliate">Open benefits</a></div><div class="panel referralPanel"><div><div class="accessTitle">Your referral code</div><div class="referralCode"><%= referralCode %></div></div></div></section><% } %>

    <section class="sectionBlock"><div class="sectionHead"><div><h2>Account</h2><p>Manage your profile, sign-in, password, optional 2FA and notification choices.</p></div><div class="heroActions"><a class="button primary" href="/account/security">Account security</a><a class="button secondary" href="/account/communications">Notifications</a></div></div></section>
    </main>
  </div>
</div>
</body>
</html>
