<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>My account · <%= siteName %></title>
  <link rel="icon" href="/branding/favicon">
  <link rel="stylesheet" href="/css/customer-portal.css">
  <link rel="stylesheet" href="/css/customer-dashboard.css">
  <link rel="stylesheet" href="/css/customer-navigation.css">
</head>
<%
  function validDate(value){if(!value)return null;const parsed=new Date(value);return Number.isNaN(parsed.getTime())?null:parsed;}
  function formatDate(value){const parsed=validDate(value);return parsed?parsed.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}):'Not available';}
  function formatDateTime(value){const parsed=validDate(value);return parsed?parsed.toLocaleString('en-GB',{dateStyle:'medium',timeStyle:'short'}):'Not available';}
  function price(plan){if(Number(plan&&plan.price_minor||0)===0)return'Free';try{return new Intl.NumberFormat('en-GB',{style:'currency',currency:plan.currency||'USD'}).format(Number(plan.price_minor||0)/100)}catch(_){return `${plan.currency||'USD'} ${(Number(plan.price_minor||0)/100).toFixed(2)}`;}}
  function duration(plan){const labels={trial:'24-hour trial',month:'Monthly','6_months':'6 months',year:'Yearly',custom:'Custom duration'};if(plan&&labels[plan.billing_interval])return labels[plan.billing_interval];if(plan&&plan.duration_days)return `${plan.duration_days} days`;return'Subscription';}
  function monthlyValue(plan){const amount=Number(plan&&((plan.price_minor_snapshot!=null)?plan.price_minor_snapshot:plan.price_minor)||0),interval=String(plan&&((plan.billing_interval_snapshot)||plan.billing_interval)||''),days=Math.max(1,Number(plan&&((plan.duration_days_snapshot!=null)?plan.duration_days_snapshot:plan.duration_days)||30));if(interval==='month')return amount;if(interval==='6_months')return amount/6;if(interval==='year')return amount/12;return amount*30.4375/days;}
  const username=portal.customer.login_username||portal.customer.login_email||portal.customer.display_name||'Customer';
  const primaryAccount=portal.accounts.find(a=>a.is_primary&&!a.disabled)||portal.accounts.find(a=>!a.disabled)||portal.accounts[0]||null;
  const activePlanId=currentPlan?(currentPlan.plan_id||currentPlan.id):null;
  const activeSubscription=Array.isArray(portal.subscriptions)?(portal.subscriptions.find(s=>['active','trialing','past_due','paused'].includes(String(s.status||''))&&(!s.current_period_end||(validDate(s.current_period_end)&&validDate(s.current_period_end).getTime()>Date.now())))||portal.subscriptions[0]||null):null;
  const recurringSubscription=Boolean(activeSubscription&&((activeSubscription.source==='stripe'&&/^sub_/i.test(String(activeSubscription.provider_subscription_id||'')))||(activeSubscription.source==='paypal'&&/^I-/i.test(String(activeSubscription.provider_subscription_id||''))));
  const visibleLibraryCount=Array.isArray(librarySelection)?librarySelection.length:0;
  const referralsEnabled=Boolean(portal.referralsEnabled&&portal.referralCode),referralCode=portal.referralCode||'';
  const jellyfinReady=Boolean(primaryAccount&&!primaryAccount.disabled&&!primaryAccount.password_setup_required&&primaryAccount.public_url);
  const jellyfinNeedsPassword=Boolean(primaryAccount&&!primaryAccount.disabled&&primaryAccount.password_setup_required);
  const jellyfinPending=Boolean(hasJellyfin&&!primaryAccount);
  const planName=currentPlan?(currentPlan.name||currentPlan.plan_name||currentPlan.code):'No active plan';
  function stripeChangeCopy(plan){if(!recurringSubscription||activeSubscription.source!=='stripe')return'Starts after Stripe confirms payment.';const upgrade=monthlyValue(plan)>monthlyValue(activeSubscription);return upgrade?'Upgrade: changes immediately. Stripe may charge a prorated amount today.':`Change: scheduled for your next renewal${activeSubscription.current_period_end?' on '+formatDate(activeSubscription.current_period_end):''}. No overlapping subscription is created.`;}
  function stripeButtonCopy(plan){if(!recurringSubscription||activeSubscription.source!=='stripe')return'Continue with Stripe';return monthlyValue(plan)>monthlyValue(activeSubscription)?'Upgrade with Stripe':'Change at next renewal';}
%>
<body>
<div class="portalShell">
  <header class="portalTopbar"><div class="portalTopbarInner"><div class="brandLockup"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= siteName %></div><div class="brandMeta">My account</div></div></div><div class="portalActions"><span class="signedIn">Signed in as <strong><%= username %></strong></span><form method="post" action="/account/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button ghost small" type="submit">Sign out</button></form></div></div></header>
  <div class="customerLayout">
    <aside class="customerSidebar" aria-label="Customer navigation">
      <div class="customerNavTitle">My account</div>
      <%- include('_nav',{active:'overview',showBenefits:referralsEnabled}) %>
      <% if(overseerrUrl){ %><a class="customerNavLink" href="<%= overseerrUrl %>" target="_blank" rel="noopener noreferrer"><span>Request content ↗</span></a><% } %>
    </aside>
    <main class="portalMain customerSimpleHome">
      <% if(message){ %><div class="notice success"><%= message %></div><% } %>
      <% if(error){ %><div class="notice error"><%= error %></div><% } %>

      <% if(welcome&&currentPlan){ %>
        <div class="accessWelcomeBackdrop"><section class="accessWelcomeModal">
          <div class="welcomeSuccessIcon"><%= primaryAccount?'✓':'…' %></div>
          <div class="eyebrow"><%= primaryAccount?'Access ready':'Access claimed' %></div>
          <h1><%= primaryAccount?'Your streaming access is ready':'We are setting up your streaming access' %></h1>
          <% if(primaryAccount){ %>
            <p>Your Jellyfin account is ready on <strong><%= primaryAccount.server_name %></strong>. These are the only details you need.</p>
            <div class="credentialGrid"><div><span>Server</span><strong><%= primaryAccount.public_url||'Available from your account' %></strong></div><div><span>Username</span><strong><%= primaryAccount.jellyfin_username %></strong></div><div><span>Password</span><strong><%= primaryAccount.password_setup_required?'Choose a password now':'Already set' %></strong></div></div>
            <div class="welcomeActions"><% if(primaryAccount.password_setup_required){ %><a class="button primary" href="#jellyfin-access">Choose password</a><% } else if(primaryAccount.public_url){ %><a class="button free" href="<%= primaryAccount.public_url %>" target="_blank" rel="noopener noreferrer">Open Jellyfin</a><% } %><a class="button secondary" href="/account">Got it</a></div>
          <% } else { %>
            <p>Your plan is active. CAPTAiNFiN is creating the Jellyfin account now and will keep retrying automatically.</p>
            <% if(provisioningState&&provisioningState.last_error){ %><div class="welcomeError"><%= provisioningState.last_error %></div><% } %>
            <form method="post" action="/account/provisioning/retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary full" type="submit">Try setup again now</button></form><a class="button secondary full" href="/account">Continue to account</a>
          <% } %>
        </section></div>
      <% } %>

      <section class="accountHero simpleHero <%= jellyfinReady?'ready':jellyfinNeedsPassword?'attention':jellyfinPending?'pending':'' %>">
        <div>
          <div class="eyebrow"><%= jellyfinReady?'Ready to watch':jellyfinNeedsPassword?'One step left':jellyfinPending?'Setting things up':currentPlan?'Your access':'Get started' %></div>
          <% if(jellyfinReady){ %><h1>You're ready to watch.</h1><p>Open Jellyfin and sign in with <strong><%= primaryAccount.jellyfin_username %></strong>.</p>
          <% } else if(jellyfinNeedsPassword){ %><h1>Choose your Jellyfin password.</h1><p>Do this once, then you're ready to watch.</p>
          <% } else if(jellyfinPending){ %><h1>We're creating your Jellyfin account.</h1><p>You do not need to do anything. You can retry now if you want.</p>
          <% } else if(hasStremio&&currentPlan){ %><h1>Your Stremio access is available.</h1><p>Follow the short setup and CAPTAiNFiN will tell you exactly what to do.</p>
          <% } else { %><h1>Choose how you want to watch.</h1><p>Pick an access option below. We'll handle the setup.</p><% } %>
        </div>
        <div class="heroActions primaryJourneyActions">
          <% if(jellyfinReady){ %><a class="button primary journeyPrimary" href="<%= primaryAccount.public_url %>" target="_blank" rel="noopener noreferrer">Open Jellyfin</a>
          <% } else if(jellyfinNeedsPassword){ %><a class="button primary journeyPrimary" href="#jellyfin-access">Choose password</a>
          <% } else if(jellyfinPending){ %><form class="plainForm" method="post" action="/account/provisioning/retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary journeyPrimary" type="submit">Try setup again</button></form>
          <% } else if(hasStremio&&currentPlan){ %><a class="button primary journeyPrimary" href="/account/stremio">Set up Stremio</a>
          <% } else { %><a class="button primary journeyPrimary" href="#plans">Choose access</a><% } %>
          <% if(overseerrUrl&&currentPlan){ %><a class="button secondary" href="<%= overseerrUrl %>" target="_blank" rel="noopener noreferrer">Request something to watch</a><% } %>
        </div>
      </section>

      <section class="simpleAccessSummary" aria-label="Access summary">
        <div><span>Plan</span><strong><%= planName %></strong></div>
        <div><span>Status</span><strong class="<%= activeSubscription&&activeSubscription.status==='past_due'?'statusBad':'statusGood' %>"><%= activeSubscription?(activeSubscription.status==='past_due'?'Payment needs attention':'Active'):(currentPlan?'Active':'Not active') %></strong></div>
        <div><span>Streams</span><strong><%= currentPlan?currentPlan.streams:'—' %></strong></div>
        <div><span>Access until</span><strong><%= activeSubscription?formatDate(activeSubscription.current_period_end):(currentPlan?'Included with plan':'—') %></strong></div>
      </section>

      <% if(hasJellyfin){ %>
      <section class="sectionBlock simplePrimarySection" id="jellyfin-access">
        <div class="sectionHead"><div><h2>Jellyfin</h2><p>Your server and sign-in.</p></div><span class="pill <%= jellyfinReady?'good':jellyfinNeedsPassword?'warn':'accent' %>"><%= jellyfinReady?'Ready':jellyfinNeedsPassword?'Password needed':'Setting up' %></span></div>
        <% if(jellyfinPending){ %><div class="provisioningPanel <%= provisioningState&&provisioningState.status==='failed'?'failed':'pending' %>"><div><strong><%= provisioningState&&provisioningState.status==='failed'?'Setup needs attention':'Creating your account' %></strong><p><%= provisioningState&&provisioningState.last_error?provisioningState.last_error:'We are creating your Jellyfin account. Automatic retries are already enabled.' %></p><% if(provisioningState&&provisioningState.next_attempt_at){ %><small>Next automatic try: <%= formatDateTime(provisioningState.next_attempt_at) %></small><% } %></div><form method="post" action="/account/provisioning/retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary" type="submit">Try again now</button></form></div><% } %>
        <div class="accessGrid"><% portal.accounts.forEach(function(a){ %><article class="accessCard simpleAccessCard"><div class="accessTop"><div><div class="accessTitle"><%= a.jellyfin_username %></div><div class="accessMeta"><%= a.server_name %></div></div><span class="pill <%= a.disabled?'bad':'good' %>"><%= a.disabled?'Needs attention':'Ready' %></span></div><% if(a.public_url){ %><div class="credentialCompact"><span>Server</span><strong><%= a.public_url %></strong></div><% } %><% if(a.password_setup_required){ %><div class="notice warn"><strong>Choose a password to finish setup.</strong></div><details class="detailsBox" open><summary>Choose Jellyfin password</summary><form method="post" action="/account/jellyfin/<%= a.id %>/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label>New password</label><input class="input" type="password" name="password" minlength="12" maxlength="200" autocomplete="new-password" required></div><div class="field"><label>Confirm password</label><input class="input" type="password" name="confirmPassword" minlength="12" maxlength="200" autocomplete="new-password" required></div><button class="button primary" type="submit">Save password</button></form></details><% } else { %><div class="buttonRow"><% if(a.public_url&&!a.disabled){ %><a class="button primary" href="<%= a.public_url %>" target="_blank" rel="noopener noreferrer">Open Jellyfin</a><% } %><details class="inlineManageDetails"><summary>Change password</summary><form method="post" action="/account/jellyfin/<%= a.id %>/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label>New password</label><input class="input" type="password" name="password" minlength="12" maxlength="200" autocomplete="new-password" required></div><div class="field"><label>Confirm password</label><input class="input" type="password" name="confirmPassword" minlength="12" maxlength="200" autocomplete="new-password" required></div><button class="button secondary" type="submit">Update password</button></form></details></div><% } %></article><% }) %></div>
      </section>
      <% } %>

      <% if(hasStremio){ %><section class="sectionBlock simpleServiceCard"><div class="sectionHead"><div><h2>Stremio</h2><p>Use the guided setup. You do not need to understand server details.</p></div><a class="button primary" href="/account/stremio">Set up / open Stremio</a></div></section><% } %>

      <% if(overseerrUrl){ %><section class="sectionBlock simpleServiceCard"><div class="sectionHead"><div><h2>Want something that's missing?</h2><p>Search for a movie or TV show and request it.</p></div><a class="button secondary" href="<%= overseerrUrl %>" target="_blank" rel="noopener noreferrer">Request content</a></div><% if(requestSyncConfigured&&requestAccess&&requestAccess.external_user_id&&requestAccess.password_reset_required){ %><div class="notice warn">Your request account needs a password once. <details class="detailsBox"><summary>Set request password</summary><form method="post" action="/account/requests/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label>New password</label><input class="input" type="password" name="password" minlength="12" maxlength="200" autocomplete="new-password" required></div><div class="field"><label>Confirm password</label><input class="input" type="password" name="confirmPassword" minlength="12" maxlength="200" autocomplete="new-password" required></div><button class="button secondary" type="submit">Save request password</button></form></details></div><% } %></section><% } %>

      <section class="sectionBlock manageHub">
        <div class="sectionHead"><div><h2>Manage my account</h2><p>You normally do not need these options.</p></div></div>

        <details class="manageDisclosure" id="plans" <%= !currentPlan?'open':'' %>><summary><span><strong>Plan &amp; billing</strong><small><%= currentPlan?planName:'Choose your access' %></small></span><span>›</span></summary><div class="manageDisclosureBody">
          <% if(activeSubscription){ %><div class="panel subscriptionPanel"><div><div class="accessTitle"><%= activeSubscription.plan_name||activeSubscription.name||activeSubscription.code||'Subscription' %></div><div class="accessMeta"><span class="pill <%= activeSubscription.status==='active'?'good':activeSubscription.status==='past_due'?'warn':'' %>"><%= activeSubscription.status==='past_due'?'Payment needs attention':activeSubscription.status %></span><span>Access until <strong><%= formatDate(activeSubscription.current_period_end) %></strong></span></div></div><div class="heroActions"><a class="button secondary" href="/account/history">Billing history</a><% if(recurringSubscription&&!activeSubscription.cancel_at_period_end){ %><form class="plainForm" method="post" action="/account/subscription/renewal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="stop"><button class="button secondary" type="submit">Stop renewal</button></form><% } else if(recurringSubscription&&activeSubscription.cancel_at_period_end&&activeSubscription.source==='stripe'){ %><form class="plainForm" method="post" action="/account/subscription/renewal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="resume"><button class="button primary" type="submit">Resume renewal</button></form><% } %></div></div><% } %>
          <% if(!plans.length){ %><div class="empty">No plans are currently available.</div><% } %>
          <div class="plansGrid"><% plans.forEach(function(p){const opts=Array.isArray(p.payment_options)?p.payment_options:[],stripeOpt=opts.find(o=>o.provider==='stripe'),paypalOpt=opts.find(o=>o.provider==='paypal'),isFreePlan=Number(p.price_minor)===0&&p.billing_interval!=='trial',isCurrent=Boolean(activePlanId&&String(activePlanId)===String(p.id)),hideFreeOrTrial=Boolean(activeSubscription&&Number(p.price_minor)===0&&!isCurrent),paypalBlocked=Boolean(recurringSubscription&&activeSubscription.source==='paypal'&&!activeSubscription.cancel_at_period_end); %><article class="planCard <%= isCurrent?'current':'' %>"><div class="planTop"><div><div class="planName"><%= p.name %></div><div class="planDuration"><%= duration(p) %></div></div><% if(isCurrent){ %><span class="pill accent">Current</span><% } %></div><div class="planPrice"><%= price(p) %></div><div class="planDescription"><%= p.description||'Streaming access managed through your account.' %></div><ul class="featureList"><li><%= p.streams %> concurrent stream<%= Number(p.streams)===1?'':'s' %></li><li><%= p.allow_downloads?'Downloads included':'Streaming only' %></li><li><%= p.allow_video_transcoding?'Video transcoding allowed':'Direct playback preferred' %></li></ul><div class="planActions"><% if(isCurrent){ %><span class="button secondary full">Current plan</span><% } else if(hideFreeOrTrial){ %><div class="paymentNote">Free and trial access are hidden while your paid access is active.</div><% } else { %><% if(p.billing_interval==='trial'){ %><form class="plainForm" method="post" action="/account/trial/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><button class="button primary full" type="submit">Start free trial</button></form><% } %><% if(isFreePlan){ %><form class="plainForm" method="post" action="/account/claim-free/<%= p.code %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button free full" type="submit">Get free access</button></form><% } %><% if(Number(p.price_minor)>0&&stripeEnabled&&stripeOpt){ %><div class="paymentNote"><%= stripeChangeCopy(p) %></div><form class="plainForm" method="post" action="/account/checkout/stripe"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input class="input discountField" name="discountCode" placeholder="Discount code (optional)" maxlength="40"><button class="button stripe full" type="submit"><%= stripeButtonCopy(p) %></button></form><% } %><% if(Number(p.price_minor)>0&&paypalEnabled&&paypalOpt){ %><% if(paypalBlocked){ %><div class="paymentNote">Stop PayPal renewal first. Your current access stays active until <%= formatDate(activeSubscription.current_period_end) %>.</div><span class="button secondary full" aria-disabled="true">Stop PayPal renewal first</span><% } else { %><form class="plainForm" method="post" action="/account/checkout/paypal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><% if(paypalOpt.checkoutMode!=='subscription'){ %><input class="input discountField" name="discountCode" placeholder="Discount code (optional)" maxlength="40"><% } %><button class="button paypal full" type="submit">Continue with PayPal</button></form><% } %><% } %><% } %></div></article><% }) %></div>
        </div></details>

        <% if(libraryEntitlement&&libraryEntitlement.length){ %><details class="manageDisclosure"><summary><span><strong>Libraries</strong><small><%= visibleLibraryCount %> of <%= libraryEntitlement.length %> shown</small></span><span>›</span></summary><div class="manageDisclosureBody"><p class="muted">These choices only hide or show libraries already included in your plan.</p><form method="post" action="/account/libraries"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="libraryGrid"><% libraryEntitlement.forEach(function(name){ %><label class="libraryChoice"><input type="checkbox" name="library" value="<%= name %>" <%= librarySelection.includes(name)?'checked':'' %>><span><%= name %></span></label><% }) %></div><div class="libraryActions"><button class="button primary" type="submit">Save choices</button></div></form></div></details><% } %>

        <% if(portal.providers.some(p=>p.provider==='stripe')&&stripeEnabled){ %><details class="manageDisclosure"><summary><span><strong>Payment method & invoices</strong><small>Stripe billing portal</small></span><span>›</span></summary><div class="manageDisclosureBody"><form class="plainForm" method="post" action="/account/stripe/portal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button stripe" type="submit">Manage Stripe billing</button></form></div></details><% } %>

        <% if(referralsEnabled){ %><details class="manageDisclosure"><summary><span><strong>Benefits</strong><small>Referral code <%= referralCode %></small></span><span>›</span></summary><div class="manageDisclosureBody"><a class="button secondary" href="/account/affiliate">Open benefits</a></div></details><% } %>

        <details class="manageDisclosure"><summary><span><strong>Account settings</strong><small>Password, security and notifications</small></span><span>›</span></summary><div class="manageDisclosureBody"><div class="buttonRow"><a class="button primary" href="/account/security">Security</a><a class="button secondary" href="/account/communications">Notifications</a><a class="button secondary" href="/account/history">Billing history</a></div></div></details>
      </section>
    </main>
  </div>
</div>
</body>
</html>
