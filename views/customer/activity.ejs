<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Your activity · <%= siteName %></title>
  <link rel="icon" href="/branding/favicon">
  <link rel="stylesheet" href="/css/customer-portal.css">
  <link rel="stylesheet" href="/css/customer-navigation.css">
  <link rel="stylesheet" href="/css/customer-activity.css">
</head>
<%
  function when(v){if(!v)return'Not recorded yet';const d=new Date(v);return Number.isNaN(d.getTime())?'Not recorded yet':d.toLocaleString();}
  function shortDate(v){if(!v)return'';const d=new Date(v);return Number.isNaN(d.getTime())?'':d.toLocaleDateString(undefined,{month:'short',day:'numeric'});}
  function timeAgo(v){if(!v)return'';const ms=Date.now()-new Date(v).getTime();if(!Number.isFinite(ms))return'';const m=Math.max(0,Math.round(ms/60000));if(m<1)return'just now';if(m<60)return`${m} minute${m===1?'':'s'} ago`;const h=Math.round(m/60);if(h<24)return`${h} hour${h===1?'':'s'} ago`;const d=Math.round(h/24);return`${d} day${d===1?'':'s'} ago`;}
  function watchTimeLabel(v){const total=Math.max(0,Math.round(Number(v||0)*60)),hours=Math.floor(total/60),minutes=total%60;return hours?`${hours}h ${String(minutes).padStart(2,'0')}m`:`${minutes}m`;}
  function ruleText(policy){const parts=[];if(policy&&policy.noPlaybackDays!=null)parts.push(`play something at least once every ${policy.noPlaybackDays} day(s)`);if(policy&&policy.minimumPlaybackMinutes!=null)parts.push(`watch at least ${policy.minimumPlaybackMinutes} minutes in each ${policy.playbackWindowDays||7}-day window`);return parts.join(' and ')||'No automatic usage threshold';}
  function playbackLabel(v){switch(String(v||'').toLowerCase()){case'directplay':return'Direct play';case'directstream':return'Direct stream';case'transcode':return'Server transcoding';default:return'Unknown';}}
  function trendClass(v){return Number(v)>0?'up':Number(v)<0?'down':'flat';}
  function trendArrow(v){return Number(v)>0?'↑':Number(v)<0?'↓':'→';}
  function trendValue(v){return`${Math.abs(Number(v||0))}%`;}
  function genreGradient(rows){const palette=['#3198f6','#ff9e2f','#45d4a3','#f6cd45','#b483ff','#755bdc','#7f92f6','#52708a'];let cursor=0;const stops=[];(rows||[]).forEach((row,index)=>{const next=Math.min(100,cursor+Number(row.percent||0));stops.push(`${palette[index%palette.length]} ${cursor}% ${next}%`);cursor=next;});if(cursor<100)stops.push(`#223246 ${cursor}% 100%`);return`conic-gradient(${stops.join(',')})`;}
  const insight=insights||{},summary=insight.summary||{},comparison=insight.comparison||{},range=insight.range||{key:'30d',label:'30 days'};
  const rangeOptions=Array.isArray(insight.rangeOptions)?insight.rangeOptions:[],timeline=Array.isArray(insight.timeline)?insight.timeline:[],genres=Array.isArray(insight.genres)?insight.genres:[],recent=Array.isArray(insight.recent)?insight.recent:[],platforms=Array.isArray(insight.platforms)?insight.platforms:[],heatRows=Array.isArray(insight.heatmap)?insight.heatmap:[],cards=insight.insightCards||{};
  const maxTimeline=Math.max(0,...timeline.map(row=>Number(row.hours||0))),genrePalette=['#3198f6','#ff9e2f','#45d4a3','#f6cd45','#b483ff','#755bdc','#7f92f6','#52708a'];
  const axisIndexes=timeline.length?[0,Math.floor((timeline.length-1)*.25),Math.floor((timeline.length-1)*.5),Math.floor((timeline.length-1)*.75),timeline.length-1]:[];
  const accountInitial=String(displayName||'A').trim().charAt(0).toUpperCase()||'A';
%>
<body><div class="portalShell activityShell">
<header class="portalTopbar"><div class="portalTopbarInner"><a class="brandLockup" href="/account"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= siteName %></div><div class="brandMeta">My account</div></div></a><div class="portalActions"><a class="activityAccountBubble" href="/account/security" aria-label="Account"><%= accountInitial %></a></div></div></header>
<main class="customerPortalPage activityPage">
  <%- include('_nav',{active:'activity'}) %>

  <header class="activityPageHeader">
    <div><h1>Your activity</h1><p>A personalised overview of your watching habits and account activity.</p></div>
    <form class="activityPeriodSelect" method="get" action="/account/activity">
      <span aria-hidden="true">▣</span>
      <select name="range" aria-label="Activity period" onchange="this.form.submit()">
        <% rangeOptions.forEach(function(option){ %><option value="<%= option.key %>" <%= option.key===range.key?'selected':'' %>><%= option.key==='30d'?'Last 30 days':option.label %></option><% }) %>
      </select>
    </form>
  </header>

  <section class="activityKpis" aria-label="Watching summary">
    <article class="activityKpi">
      <div class="activityKpiIcon blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
      <div><span>Total watch time</span><strong><%= watchTimeLabel(summary.watchHours) %></strong><small class="activityTrend <%= trendClass(comparison.watchTime) %>"><b><%= trendArrow(comparison.watchTime) %> <%= trendValue(comparison.watchTime) %></b> <%= comparison.available?comparison.label:'selected period' %></small></div>
    </article>
    <article class="activityKpi">
      <div class="activityKpiIcon purple" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 4v16M16 4v16M4 9h4M16 9h4M4 15h4M16 15h4"/></svg></div>
      <div><span>Titles watched</span><strong><%= summary.titlesWatched||0 %></strong><small class="activityTrend <%= trendClass(comparison.titles) %>"><b><%= trendArrow(comparison.titles) %> <%= trendValue(comparison.titles) %></b> <%= comparison.available?comparison.label:'selected period' %></small></div>
    </article>
    <article class="activityKpi">
      <div class="activityKpiIcon green" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4"/></svg></div>
      <div><span>Episodes watched</span><strong><%= summary.episodesWatched||0 %></strong><small class="activityTrend <%= trendClass(comparison.episodes) %>"><b><%= trendArrow(comparison.episodes) %> <%= trendValue(comparison.episodes) %></b> <%= comparison.available?comparison.label:'selected period' %></small></div>
    </article>
    <article class="activityKpi">
      <div class="activityKpiIcon gold" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.8 1-6.1-4.4-4.3 6.1-.9z"/></svg></div>
      <div><span>Average rating</span><strong><%= summary.averageRating!=null?`${Number(summary.averageRating).toFixed(1)}/10`:'—/10' %></strong><small class="activityKpiNote"><%= summary.averageRating!=null?'Based on your watched content':'Rating metadata unavailable' %></small></div>
    </article>
  </section>

  <section class="activityTopGrid">
    <article class="activityCard activityWatchCard">
      <div class="activityCardHeading"><h2>Watch time</h2><nav class="activityRangeTabs" aria-label="Watch-time period"><% rangeOptions.forEach(function(option){ %><a href="/account/activity?range=<%= encodeURIComponent(option.key) %>" class="<%= option.key===range.key?'active':'' %>"><%= option.label %></a><% }) %></nav></div>
      <div class="activityChart" role="img" aria-label="Watch time over <%= range.label %>">
        <div class="activityYAxis"><span>8h</span><span>6h</span><span>4h</span><span>2h</span><span>0h</span></div>
        <div class="activityBars">
          <% if(timeline.length){timeline.forEach(function(point){const height=maxTimeline>0?Math.max(2,Math.round((Number(point.hours||0)/Math.max(maxTimeline,8))*100)):2; %><div class="activityBarSlot" title="<%= shortDate(point.bucket) %> · <%= watchTimeLabel(point.hours) %>"><span style="height:<%= Math.min(100,height) %>%"></span></div><% })} %>
        </div>
      </div>
      <div class="activityXAxis"><% axisIndexes.forEach(function(index){ %><span><%= shortDate(timeline[index]&&timeline[index].bucket) %></span><% }) %></div>
    </article>

    <article class="activityCard activityGenresCard">
      <h2>Top genres</h2>
      <div class="activityGenresBody">
        <div class="activityDonut" style="background:<%= genreGradient(genres) %>"><div><strong><%= summary.episodesWatched||summary.titlesWatched||0 %></strong><span><%= summary.episodesWatched?'Episodes':'Titles' %></span></div></div>
        <div class="activityGenreLegend">
          <% if(genres.length){genres.forEach(function(genre,index){ %><div><span class="activityGenreDot" style="background:<%= genrePalette[index%genrePalette.length] %>"></span><span><%= genre.name %></span><strong><%= genre.percent %>%</strong></div><% })} else { %><div class="activityGenreEmpty">Genre metadata will appear as your watched items are available from Jellyfin.</div><% } %>
        </div>
      </div>
    </article>
  </section>

  <section class="activityMiddleGrid">
    <article class="activityCard activityRecentCard">
      <div class="activityCardHeading"><h2>Recently watched</h2><a href="#recent-playback">View all →</a></div>
      <div class="activityRecentList">
        <% if(recent.length){recent.forEach(function(item,index){ %>
        <div class="activityRecentRow">
          <div class="activityPoster poster<%= index%5 %>"><span aria-hidden="true">▶</span><% if(item.imageUrl){ %><img src="<%= item.imageUrl %>" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()"><% } %></div>
          <div class="activityRecentInfo"><strong><%= item.title %></strong><span><%= item.subtitle||'Recorded playback' %></span></div>
          <time><%= timeAgo(item.lastSeenAt) %></time>
          <div class="activityProgress"><i><b style="width:<%= item.progress==null?0:item.progress %>%"></b></i><span><%= item.progress==null?'—':`${item.progress}%` %></span></div>
        </div>
        <% })} else { %><div class="activityMiniEmpty">No recent playback yet.</div><% } %>
      </div>
    </article>

    <article class="activityCard activityDevicesCard">
      <div class="activityCardHeading"><h2>Devices &amp; platforms</h2><span class="activityMutedLink">View all →</span></div>
      <div class="activityDeviceList">
        <% if(platforms.length){platforms.slice(0,5).forEach(function(device){ %><div class="activityDeviceRow"><span class="activityDeviceIcon <%= device.icon %>" aria-hidden="true"><%= device.icon==='mobile'?'▯':device.icon==='web'?'◎':'▣' %></span><strong><%= device.label %></strong><i><b style="width:<%= device.percent %>%"></b></i><span><%= device.percent %>%</span></div><% })} else { %><div class="activityMiniEmpty">No device activity yet.</div><% } %>
      </div>
    </article>

    <article class="activityCard activityHeatCard">
      <h2>When you watch</h2>
      <div class="activityHeatmap"><% heatRows.forEach(function(day){ %><div class="activityHeatRow"><span><%= day.label %></span><div><% day.cells.forEach(function(cell){ %><i class="level<%= cell.level %>" title="<%= day.label %> <%= String(cell.hour).padStart(2,'0') %>:00"></i><% }) %></div></div><% }) %></div>
      <div class="activityHeatAxis"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span></div>
      <small>Based on your recorded playback time.</small>
    </article>
  </section>

  <section class="activityInsightsCard">
    <h2><span aria-hidden="true">💡</span> Your viewing insights</h2>
    <div class="activityInsightGrid">
      <article><span class="activityInsightIcon green">↗</span><div><strong><%= Number(cards.watchTrend)>=0?"You're watching more":"You're watching less" %></strong><p>Your watch time is <%= Math.abs(Number(cards.watchTrend||0)) %>% <%= Number(cards.watchTrend)>=0?'higher':'lower' %> than the previous period.</p></div></article>
      <article><span class="activityInsightIcon purple">★</span><div><strong><%= cards.favoriteGenre?`${cards.favoriteGenre} is your favourite`:'Your favourite genre' %></strong><p><%= cards.favoriteGenre?`${cards.favoriteGenre} accounts for the largest share of your recent viewing.`:'Keep watching and your favourite genre will appear here.' %></p></div></article>
      <article><span class="activityInsightIcon orange">◷</span><div><strong>Peak time</strong><p>You watch the most around <%= cards.peakTime||'your busiest viewing window' %>.</p></div></article>
      <article><span class="activityInsightIcon blue">▣</span><div><strong>Multi-device user</strong><p>You've watched on <%= Number(cards.deviceCount||0) %> different device<%= Number(cards.deviceCount||0)===1?'':'s' %> in this period.</p></div></article>
    </div>
  </section>

  <% if(freeUsage&&freeUsage.applies){ %>
  <section class="panel activityDetailsPanel"><div class="sectionHead"><div><h2>Free Server usage</h2><p>Your Free Server plan can use playback activity to decide whether an inactive place should be released.</p></div><span class="pill <%= freeUsage.telemetry&&freeUsage.telemetry.ready?'good':'warn' %>"><%= freeUsage.telemetry&&freeUsage.telemetry.ready?'Playback tracking healthy':'Removal paused' %></span></div>
    <div class="notice"><strong>Based on what the server reported.</strong> Short clips under ~30s may not appear.</div>
    <div class="usageGrid"><div class="usageStat"><span>Last recognised playback</span><strong><%= when(freeUsage.lastPlaybackAt) %></strong></div><div class="usageStat"><span>Playback in current window</span><strong><%= freeUsage.playbackMinutes %> min</strong></div><div class="usageStat"><span>Usage rule</span><strong><%= ruleText(freeUsage.policy) %></strong></div><div class="usageStat"><span>Right now</span><strong><%= freeUsage.currentlyPlaying?'Playing now':freeUsage.alreadyHeld?'Access currently held':freeUsage.eligible?'Below current usage rule':'Usage requirement satisfied' %></strong></div></div>
    <div class="usageStatus">
      <% if(!freeUsage.telemetry||!freeUsage.telemetry.ready){ %><div class="notice warn"><strong>Automatic inactivity removal is paused.</strong> <%= siteName %> will not act on inactivity unless the activity worker is current and this Free Server has a trustworthy recent playback sample.</div>
      <% } else if(freeUsage.currentlyPlaying){ %><div class="notice success"><strong>Playback is active now.</strong> An active stream cannot trigger the inactivity action.</div>
      <% } else if(freeUsage.automationProtected){ %><div class="notice success"><strong>Your account is protected from automatic inactivity action.</strong></div>
      <% } else if(freeUsage.eligible&&freeUsage.policy&&freeUsage.policy.dryRun){ %><div class="notice warn"><strong>Your current usage is below the configured rule, but enforcement is in dry-run.</strong> No automatic access action will be taken while dry-run remains enabled.</div>
      <% } else if(freeUsage.eligible){ %><div class="notice warn"><strong>Your current usage is below the Free Server rule.</strong> Play something to create fresh playback activity before the automated inactivity check runs.</div>
      <% } else { %><div class="notice success"><strong>Your current playback usage satisfies the Free Server rule.</strong></div><% } %>
    </div>
  </section>
  <% } %>

  <section class="panel activityDetailsPanel" id="recent-playback"><div class="sectionHead"><div><h2>Recent playback</h2><p>Up to your latest 100 recorded Jellyfin playbacks.</p></div></div>
    <% if (!activity.length) { %><div class="empty">No playback activity has been recorded yet.</div><% } else { %>
    <div class="tableWrap"><table class="activityTable"><thead><tr><th>Started</th><th>Media</th><th>Playback</th><th>Device</th><th>Server</th><th>Ended</th></tr></thead><tbody>
      <% activity.forEach(function(a){ %><tr><td><%= when(a.started_at) %></td><td><strong><%= a.item_name || 'Unknown item' %></strong><% if(a.item_type){ %><span class="activityRecentType"><%= a.item_type %></span><% } %></td><td><%= playbackLabel(a.playback_method) %></td><td><%= a.device_name || a.client_name || 'Unknown device' %><% if(a.device_name&&a.client_name){ %><div class="accessMeta"><%= a.client_name %></div><% } %></td><td><%= a.server_name %></td><td><%= a.ended_at ? when(a.ended_at) : 'Active / recently active' %></td></tr><% }) %>
    </tbody></table></div><% } %>
  </section>

  <section class="panel activityDetailsPanel"><div class="sectionHead"><div><h2>Stream-limit actions</h2><p>Warnings, safety decisions and stopped excess streams appear here. Normal playback does not create an action.</p></div></div>
    <% if (!events.length) { %><div class="empty">No stream-limit actions.</div><% } else { %><% events.forEach(function(e){const stopped=['stopped','stop_failed'].includes(String(e.decision||'')); %><div class="activityDecision <%= stopped?'stop':'' %>"><strong><%= e.decision==='stopped'?'Playback stopped':e.decision==='stop_failed'?'Stop attempt failed':'Stream policy decision' %></strong> · <%= when(e.created_at) %><p><%= e.observed_streams == null ? '?' : e.observed_streams %> active stream(s) / limit <%= e.stream_limit == null ? '?' : e.stream_limit %></p><div class="accessMeta"><%= e.reason || 'No additional detail' %></div></div><% }) %><% } %>
  </section>
</main></div></body></html>
