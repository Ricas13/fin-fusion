<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Playback activity · <%= siteName %></title>
  <link rel="icon" href="/branding/favicon">
  <link rel="stylesheet" href="/css/customer-portal.css">
  <link rel="stylesheet" href="/css/customer-navigation.css">
  <style>.activityTable{min-width:640px}.playbackMobile{display:none}.playbackCard{padding:13px 0;border-bottom:1px solid var(--line)}.playbackCard:first-child{padding-top:0}.playbackCard:last-child{padding-bottom:0;border-bottom:0}.playbackCardTitle{font-weight:700}.playbackCardWhen,.playbackCardDevice{margin-top:5px;color:var(--muted);font-size:13px}.activityDecision{margin:9px 0;padding:13px;border:1px solid var(--line);border-left:4px solid var(--warn);border-radius:8px;background:var(--panel-2)}.activityDecision.stop{border-left-color:var(--danger)}.usageGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:12px}.usageStat{padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--panel-2)}.usageStat span{display:block;color:var(--muted);font-size:12px;margin-bottom:5px}.usageStatus{margin-top:12px}@media(max-width:760px){.usageGrid{grid-template-columns:1fr 1fr}.playbackDesktop{display:none}.playbackMobile{display:block}}</style>
</head>
<%
  function when(v){if(!v)return'Not recorded yet';const d=new Date(v);return Number.isNaN(d.getTime())?'Not recorded yet':d.toLocaleString();}
  function playbackDate(d){return d.toLocaleDateString('en-GB',{day:'2-digit',month:'short'});}
  function playbackTime(d){return d.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});}
  function samePlaybackDay(a,b){return a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()&&a.getDate()===b.getDate();}
  function playbackDuration(start,end){const minutes=Math.max(0,Math.round((end-start)/60000));if(minutes<1)return'<1m';const hours=Math.floor(minutes/60),remainder=minutes%60;return hours?(remainder?`${hours}h ${remainder}m`:`${hours}h`):`${minutes}m`;}
  function playbackWhen(a){const start=new Date(a.started_at);if(Number.isNaN(start.getTime()))return'Not recorded yet';const startText=`${playbackDate(start)} ${playbackTime(start)}`;if(a.ended_at){const end=new Date(a.ended_at);if(!Number.isNaN(end.getTime()))return samePlaybackDay(start,end)?`${startText}–${playbackTime(end)}`:`${startText}–${playbackDate(end)} ${playbackTime(end)}`;}if(a.last_seen_at){const seen=new Date(a.last_seen_at);if(!Number.isNaN(seen.getTime())&&seen>=start)return`${startText} · ${playbackDuration(start,seen)}`;}return startText;}
  function playbackDevice(a){const values=[a.device_name,a.client_name].map(v=>String(v||'').trim()).filter(Boolean);const unique=values.filter((v,i)=>values.findIndex(x=>x.toLowerCase()===v.toLowerCase())===i);return unique.join(' · ')||'Unknown device';}
  function ruleText(policy){const parts=[];if(policy&&policy.noPlaybackDays!=null)parts.push(`play something at least once every ${policy.noPlaybackDays} day(s)`);if(policy&&policy.minimumPlaybackMinutes!=null)parts.push(`watch at least ${policy.minimumPlaybackMinutes} minutes in each ${policy.playbackWindowDays||7}-day window`);return parts.join(' and ')||'No automatic usage threshold';}
  const playbackServers=[...new Set(activity.map(a=>a.server_name).filter(Boolean))];
  const showPlaybackServer=playbackServers.length>1;
%>
<body><div class="portalShell">
<header class="portalTopbar"><div class="portalTopbarInner"><a class="brandLockup" href="/account"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= siteName %></div><div class="brandMeta">My account</div></div></a><div class="portalActions"><a class="button ghost small" href="/account">Home</a></div></div></header>
<main class="customerPortalPage">
  <%- include('_nav',{active:'activity'}) %>
  <div class="customerPortalPageHeader"><div><h1>Playback activity</h1><p>This is the playback CAPTAiNFiN has actually recorded for your account. Network addresses are never shown.</p></div></div>

  <% if(freeUsage&&freeUsage.applies){ %>
  <section class="panel"><div class="sectionHead"><div><h2>Free Server usage</h2><p>Your Free Server plan can use playback activity to decide whether an inactive place should be released.</p></div><span class="pill <%= freeUsage.telemetry&&freeUsage.telemetry.ready?'good':'warn' %>"><%= freeUsage.telemetry&&freeUsage.telemetry.ready?'Playback tracking healthy':'Removal paused' %></span></div>
    <div class="usageGrid"><div class="usageStat"><span>Last recognised playback</span><strong><%= when(freeUsage.lastPlaybackAt) %></strong></div><div class="usageStat"><span>Playback in current window</span><strong><%= freeUsage.playbackMinutes %> min</strong></div><div class="usageStat"><span>Usage rule</span><strong><%= ruleText(freeUsage.policy) %></strong></div><div class="usageStat"><span>Right now</span><strong><%= freeUsage.currentlyPlaying?'Playing now':freeUsage.alreadyHeld?'Access currently held':freeUsage.eligible?'Below current usage rule':'Usage requirement satisfied' %></strong></div></div>
    <div class="usageStatus">
      <% if(!freeUsage.telemetry||!freeUsage.telemetry.ready){ %><div class="notice warn"><strong>Automatic inactivity removal is paused.</strong> CAPTAiNFiN will not act on inactivity while the activity worker or any enabled Jellyfin server has stale/unhealthy telemetry.</div>
      <% } else if(freeUsage.currentlyPlaying){ %><div class="notice success"><strong>Playback is active now.</strong> An active stream cannot trigger the inactivity action.</div>
      <% } else if(freeUsage.automationProtected){ %><div class="notice success"><strong>Your account is protected from automatic inactivity action.</strong></div>
      <% } else if(freeUsage.eligible&&freeUsage.policy&&freeUsage.policy.dryRun){ %><div class="notice warn"><strong>Your current usage is below the configured rule, but enforcement is in dry-run.</strong> No automatic access action will be taken while dry-run remains enabled.</div>
      <% } else if(freeUsage.eligible){ %><div class="notice warn"><strong>Your current usage is below the Free Server rule.</strong> Play something to create fresh playback activity before the automated inactivity check runs.</div>
      <% } else { %><div class="notice success"><strong>Your current playback usage satisfies the Free Server rule.</strong></div><% } %>
    </div>
  </section>
  <% } %>

  <section class="panel"><div class="sectionHead"><div><h2>Recent playback</h2><p>Up to your latest 100 recorded Jellyfin playbacks.</p></div></div>
    <% if (!activity.length) { %><div class="empty">No playback activity has been recorded yet.</div><% } else { %>
    <div class="playbackDesktop tableWrap"><table class="activityTable"><thead><tr><th>Title</th><th>When</th><th>Device</th><% if(showPlaybackServer){ %><th>Server</th><% } %></tr></thead><tbody>
      <% activity.forEach(function(a){ %><tr><td><strong><%= a.item_name || 'Unknown item' %></strong></td><td><%= playbackWhen(a) %></td><td><%= playbackDevice(a) %></td><% if(showPlaybackServer){ %><td><%= a.server_name || 'Unknown server' %></td><% } %></tr><% }) %>
    </tbody></table></div>
    <div class="playbackMobile">
      <% activity.forEach(function(a){ %><article class="playbackCard"><div class="playbackCardTitle"><%= a.item_name || 'Unknown item' %></div><div class="playbackCardWhen"><%= playbackWhen(a) %></div><div class="playbackCardDevice"><%= playbackDevice(a) %></div></article><% }) %>
    </div><% } %>
  </section>
  <section class="sectionBlock"><div class="sectionHead"><div><h2>Stream-limit actions</h2><p>Warnings, safety decisions and stopped excess streams appear here. Normal playback does not create an action.</p></div></div><div class="panel">
    <% if (!events.length) { %><div class="empty">No stream-limit actions.</div><% } else { %><% events.forEach(function(e){const stopped=['stopped','stop_failed'].includes(String(e.decision||'')); %><div class="activityDecision <%= stopped?'stop':'' %>"><strong><%= e.decision==='stopped'?'Playback stopped':e.decision==='stop_failed'?'Stop attempt failed':'Stream policy decision' %></strong> · <%= when(e.created_at) %><p><%= e.observed_streams == null ? '?' : e.observed_streams %> active stream(s) / limit <%= e.stream_limit == null ? '?' : e.stream_limit %></p><div class="accessMeta"><%= e.reason || 'No additional detail' %></div></div><% }) %><% } %>
  </div></section>
</main></div></body></html>