<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Activity · <%= siteName %></title>
  <link rel="icon" href="/branding/favicon">
  <link rel="stylesheet" href="/css/customer-portal.css">
  <link rel="stylesheet" href="/css/customer-navigation.css">
  <style>.activityTable{min-width:820px}.activityDecision{margin:9px 0;padding:13px;border:1px solid var(--line);border-left:4px solid var(--warn);border-radius:8px;background:var(--panel-2)}.activityDecision.stop{border-left-color:var(--danger)}</style>
</head>
<body><main class="customerPortalPage">
  <%- include('_nav',{active:'activity'}) %>
  <div class="customerPortalPageHeader"><div><h1>Activity</h1><p>Your recent playback and any stream-limit actions. Network addresses are not shown.</p></div></div>
  <section class="panel"><div class="sectionHead"><div><h2>Recent playback</h2><p>What your account has recently played.</p></div></div>
    <% if (!activity.length) { %><div class="empty">No playback activity has been recorded yet.</div><% } else { %>
    <div class="tableWrap"><table class="activityTable"><thead><tr><th>Started</th><th>Media</th><th>Playback</th><th>Device</th><th>Server</th><th>Ended</th></tr></thead><tbody>
      <% activity.forEach(function(a){ %><tr><td><%= new Date(a.started_at).toLocaleString() %></td><td><strong><%= a.item_name || 'Unknown item' %></strong><div class="accessMeta"><%= a.item_type || '' %></div></td><td><span class="pill"><%= a.playback_method %></span></td><td><%= a.device_name || a.client_name || 'Unknown device' %><div class="accessMeta"><%= a.client_name || '' %></div></td><td><%= a.server_name %></td><td><%= a.ended_at ? new Date(a.ended_at).toLocaleString() : 'Active / recently active' %><% if (a.ended_reason) { %><div class="accessMeta"><%= a.ended_reason %></div><% } %></td></tr><% }) %>
    </tbody></table></div><% } %>
  </section>
  <section class="sectionBlock"><div class="sectionHead"><div><h2>Stream-limit actions</h2><p>Only warnings or stopped streams appear here. Normal playback does not create an entry.</p></div></div><div class="panel">
    <% if (!events.length) { %><div class="empty">No stream-limit actions.</div><% } else { %><% events.forEach(function(e){ %><div class="activityDecision <%= e.decision === 'stopped' ? 'stop' : '' %>"><strong><%= e.decision === 'stopped' ? 'Playback stopped' : 'Stream warning' %></strong> · <%= new Date(e.created_at).toLocaleString() %><p><%= e.stream_count == null ? '?' : e.stream_count %> active stream(s) / limit <%= e.stream_limit == null ? '?' : e.stream_limit %></p><div class="accessMeta"><%= e.reason %></div></div><% }) %><% } %>
  </div></section>
</main></body></html>
