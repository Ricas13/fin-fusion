<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title>My account · <%= siteName %></title><link rel="icon" href="/branding/favicon"><link rel="stylesheet" href="/css/customer-portal.css"><link rel="stylesheet" href="/css/customer-navigation.css"></head>
<%
  function validDate(value){if(!value)return null;const d=new Date(value);return Number.isNaN(d.getTime())?null:d;}
  function formatDate(value){const d=validDate(value);return d?d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}):'Not available';}
  function price(plan){if(Number(plan&&plan.price_minor||0)===0)return'Free';try{return new Intl.NumberFormat('en-GB',{style:'currency',currency:plan.currency||'USD'}).format(Number(plan.price_minor||0)/100)}catch(_){return `${plan.currency||'USD'} ${(Number(plan.price_minor||0)/100).toFixed(2)}`;}}
  function delivery(plan){const t=String(plan&&plan.service_type||'stremio');return t==='bundle'?'Jellyfin + Stremio':t==='jellyfin'?'Jellyfin':'Stremio';}
  function accessModel(plan){const t=String(plan&&plan.service_type||'stremio'),streams=Math.max(1,Number(plan&&plan.streams||1));if(t==='bundle')return `${streams} Jellyfin stream${streams===1?'':'s'} + 1 Stremio household`;if(t==='jellyfin')return `${streams} Jellyfin stream${streams===1?'':'s'}`;return'1 Stremio household';}
  function monthlyValue(plan){const amount=Number(plan&&((plan.price_minor_snapshot!=null)?plan.price_minor_snapshot:plan.price_minor)||0),interval=String(plan&&((plan.billing_interval_snapshot)||plan.billing_interval)||''),days=Math.max(1,Number(plan&&((plan.duration_days_snapshot!=null)?plan.duration_days_snapshot:plan.duration_days)||30));if(interval==='month')return amount;if(interval==='6_months')return amount/6;if(interval==='year')return amount/12;return amount*30.4375/days;}
  const username=portal.customer.login_username||portal.customer.login_email||portal.customer.display_name||'Customer';
  const activeSubscription=Array.isArray(portal.subscriptions)?(portal.subscriptions.find(s=>['active','trialing','past_due','paused'].includes(String(s.status||'')))||portal.subscriptions[0]||null):null;
  const recurringSubscription=Boolean(activeSubscription&&((activeSubscription.source==='stripe'&&/^sub_/i.test(String(activeSubscription.provider_subscription_id||'')))||(activeSubscription.source==='paypal'&&/^I-/i.test(String(activeSubscription.provider_subscription_id||'')))));
  const activePlanId=currentPlan?(currentPlan.plan_id||currentPlan.id):null;
  function stripeCopy(p){if(!recurringSubscription||activeSubscription.source!=='stripe')return'Starts after Stripe confirms payment.';return monthlyValue(p)>monthlyValue(activeSubscription)?'Upgrade: changes immediately and Stripe may charge a prorated amount today.':`Change: scheduled for your next renewal${activeSubscription.current_period_end?' on '+formatDate(activeSubscription.current_period_end):''}.`;}
%>
<body><div class="portalShell"><header class="portalTopbar"><div class="portalTopbarInner"><div class="brandLockup"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= siteName %></div><div class="brandMeta">My account</div></div></div><div class="portalActions"><span class="signedIn">Signed in as <strong><%= username %></strong></span><form method="post" action="/account/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button ghost small">Sign out</button></form></div></div></header><main class="customerPortalPage">
<%- include('_nav',{active:'overview',showBenefits:Boolean(portal.referralsEnabled&&portal.referralCode)}) %>
<% if(message){ %><div class="notice success"><%= message %></div><% } %><% if(error){ %><div class="notice error"><%= error %></div><% } %>
<section class="accountHero"><div><div class="eyebrow">Your streaming access</div><h1>Welcome back, <%= username %>.</h1><p>Your current plan uses Stremio. Create your private installation link, see your renewal date and manage plans here.</p></div><div class="heroActions"><a class="button primary" href="/account/stremio">Stremio setup</a><a class="button secondary" href="#plans">Plan &amp; billing</a></div></section>
<section class="overviewGrid"><article class="metricCard"><div class="metricLabel">Current plan</div><div class="metricValue"><%= currentPlan?(currentPlan.name||currentPlan.plan_name||currentPlan.code):'No active plan' %></div><div class="metricSub">Stremio access</div></article><article class="metricCard"><div class="metricLabel">Stremio household</div><div class="metricValue">1</div><div class="metricSub">Private household access · no concurrent-stream limit</div></article><article class="metricCard"><div class="metricLabel">Streaming</div><div class="metricValue">Stremio</div><div class="metricSub">Private installation</div></article><article class="metricCard"><div class="metricLabel">Access until</div><div class="metricValue compact"><%= activeSubscription?formatDate(activeSubscription.current_period_end):'—' %></div><div class="metricSub"><%= activeSubscription?(activeSubscription.status==='past_due'?'Payment needs attention':activeSubscription.status):'No active access' %></div></article></section>
<section class="sectionBlock" id="streaming"><div class="sectionHead"><div><h2>Stremio</h2><p>Your private installation is managed from one setup page.</p></div><a class="button primary" href="/account/stremio">Open Stremio setup</a></div><div class="panel"><p class="accessMeta">Your installation does not contain your portal password or Jellyfin administrator credentials. Stremio playback is household-based rather than limited by a concurrent stream counter.</p></div></section>
<section class="sectionBlock" id="plans"><div class="sectionHead"><div><h2>Plan &amp; billing</h2><p>Check when a change will happen before you continue.</p></div><a class="button secondary small" href="/account/history">Billing history</a></div><% if(!plans.length){ %><div class="empty">No plans are currently available.</div><% } %><div class="plansGrid"><% plans.forEach(function(p){const opts=Array.isArray(p.payment_options)?p.payment_options:[],stripeOpt=opts.find(o=>o.provider==='stripe'),paypalOpt=opts.find(o=>o.provider==='paypal'),isFree=Number(p.price_minor)===0&&p.billing_interval!=='trial',isCurrent=Boolean(activePlanId&&String(activePlanId)===String(p.id)),hideFreeOrTrial=Boolean(activeSubscription&&Number(p.price_minor)===0&&!isCurrent),paypalBlocked=Boolean(recurringSubscription&&activeSubscription.source==='paypal'&&!activeSubscription.cancel_at_period_end); %><article class="planCard <%= isCurrent?'current':'' %>"><div class="planTop"><div><div class="planName"><%= p.name %></div><div class="planDuration"><%= delivery(p) %></div></div><% if(isCurrent){ %><span class="pill accent">Current</span><% } %></div><div class="planPrice"><%= price(p) %></div><div class="planDescription"><%= p.description||'Streaming access managed through your CAPTAiNFiN account.' %></div><ul class="featureList"><li><%= accessModel(p) %></li><li><%= delivery(p) %></li></ul><div class="planActions"><% if(isCurrent){ %><span class="button secondary full">Current plan</span><% } else if(hideFreeOrTrial){ %><div class="paymentNote">Free and trial access are hidden while your current paid access is active.</div><% } else { %><% if(p.billing_interval==='trial'){ %><div class="paymentNote">Starts immediately after you confirm.</div><form class="plainForm" method="post" action="/account/trial/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><button class="button primary full">Start free trial</button></form><% } %><% if(isFree){ %><div class="paymentNote">Starts immediately if a free place is available.</div><form class="plainForm" method="post" action="/account/claim-free/<%= p.code %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button free full">Get free access</button></form><% } %><% if(Number(p.price_minor)>0&&stripeEnabled&&stripeOpt){ %><div class="paymentNote"><strong>Stripe:</strong> <%= stripeCopy(p) %></div><form class="plainForm" method="post" action="/account/checkout/stripe"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><button class="button stripe full"><%= recurringSubscription&&activeSubscription.source==='stripe'?(monthlyValue(p)>monthlyValue(activeSubscription)?'Upgrade with Stripe':'Change at next renewal'):'Continue with Stripe' %></button></form><% } %><% if(Number(p.price_minor)>0&&paypalEnabled&&paypalOpt){ %><% if(paypalBlocked){ %><div class="paymentNote"><strong>PayPal:</strong> Stop renewal first. Your current access remains until <%= formatDate(activeSubscription.current_period_end) %>.</div><span class="button secondary full" aria-disabled="true">Stop PayPal renewal first</span><% } else { %><div class="paymentNote"><strong>PayPal:</strong> Starts after PayPal confirms the payment or subscription.</div><form class="plainForm" method="post" action="/account/checkout/paypal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><button class="button paypal full">Continue with PayPal</button></form><% } %><% } %><% } %></div></article><% }) %></div></section>
</main></div></body></html>
