<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title>My Stremio access · <%= siteName %></title><link rel="icon" href="/branding/favicon"><link rel="stylesheet" href="/css/customer-portal.css"></head>
<%
  function validDate(value){if(!value)return null;const d=new Date(value);return Number.isNaN(d.getTime())?null:d;}
  function formatDate(value){const d=validDate(value);return d?d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}):'Not available';}
  function price(plan){if(Number(plan&&plan.price_minor||0)===0)return'Free';try{return new Intl.NumberFormat('en-GB',{style:'currency',currency:plan.currency||'USD'}).format(Number(plan.price_minor||0)/100)}catch(_){return `${plan.currency||'USD'} ${(Number(plan.price_minor||0)/100).toFixed(2)}`;}}
  function delivery(plan){const t=String(plan&&plan.service_type||'jellyfin');return t==='stremio'?'Stremio':t==='bundle'?'Jellyfin + Stremio':'Jellyfin';}
  const username=portal.customer.login_username||portal.customer.login_email||portal.customer.display_name||'Customer';
  const activeSubscription=Array.isArray(portal.subscriptions)?(portal.subscriptions.find(s=>['active','trialing','past_due','paused'].includes(String(s.status||'')))||portal.subscriptions[0]||null):null;
  const activePlanId=currentPlan?(currentPlan.plan_id||currentPlan.id):null;
%>
<body><div class="portalShell">
<header class="portalTopbar"><div class="brandLockup"><img class="brandLogo" src="/branding/logo" alt=""><div><div class="brandName"><%= siteName %></div><div class="brandMeta">Customer portal</div></div></div><div class="portalActions"><span class="signedIn">Signed in as <strong><%= username %></strong></span><a class="button secondary small" href="/account/security">Security</a><a class="button secondary small" href="/account/history">Billing history</a><form method="post" action="/account/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button ghost small">Sign out</button></form></div></header>
<main class="portalMain">
<% if(message){ %><div class="notice success"><%= message %></div><% } %><% if(error){ %><div class="notice error"><%= error %></div><% } %>
<section class="accountHero"><div><div class="eyebrow">Your streaming access</div><h1>Stremio is your delivery app.</h1><p>Your subscription is delivered through a private CAPTaINFiN Stremio installation. You do not need a normal Jellyfin login for this plan.</p></div><div class="heroActions"><a class="button primary" href="/account/stremio">Manage Stremio installation</a><a class="button secondary" href="#plans">View plans</a><a class="button secondary" href="/account/history">Subscription history</a></div></section>
<section class="overviewGrid"><article class="metricCard"><div class="metricLabel">Current plan</div><div class="metricValue"><%= currentPlan?(currentPlan.name||currentPlan.plan_name||currentPlan.code):'No active plan' %></div><div class="metricSub">Stremio delivery</div></article><article class="metricCard"><div class="metricLabel">Concurrent streams</div><div class="metricValue"><%= currentPlan?currentPlan.streams:'—' %></div><div class="metricSub">Your plan allowance</div></article><article class="metricCard"><div class="metricLabel">Delivery</div><div class="metricValue">Stremio</div><div class="metricSub">Private addon installation</div></article><article class="metricCard"><div class="metricLabel">Access until</div><div class="metricValue" style="font-size:20px"><%= activeSubscription?formatDate(activeSubscription.current_period_end):'—' %></div><div class="metricSub"><%= activeSubscription?(activeSubscription.status||'active'):'No entitlement' %></div></article></section>
<section class="sectionBlock"><div class="sectionHead"><div><h2>Stremio installation</h2><p>Create, rotate or revoke the private installation tied to this subscription.</p></div></div><div class="panel"><p>CAPTaINFiN uses a dedicated restricted playback identity behind the scenes. Your normal portal password and Jellyfin administrator credentials are never placed in the addon.</p><a class="button primary" href="/account/stremio">Open Stremio setup</a></div></section>
<section class="sectionBlock" id="plans"><div class="sectionHead"><div><h2>Available plans</h2><p>Only products that CAPTaINFiN can deliver right now are shown.</p></div></div><% if(!plans.length){ %><div class="empty">No plans are currently available.</div><% } %><div class="plansGrid"><% plans.forEach(function(p){const opts=Array.isArray(p.payment_options)?p.payment_options:[],stripeOpt=opts.find(o=>o.provider==='stripe'),paypalOpt=opts.find(o=>o.provider==='paypal'),isFree=Number(p.price_minor)===0&&p.billing_interval!=='trial',isCurrent=Boolean(activePlanId&&String(activePlanId)===String(p.id)); %><article class="planCard <%= isCurrent?'current':'' %>"><div class="planTop"><div><div class="planName"><%= p.name %></div><div class="planDuration"><%= delivery(p) %></div></div><% if(isCurrent){ %><span class="pill accent">Current</span><% } %></div><div class="planPrice"><%= price(p) %></div><div class="planDescription"><%= p.description||'Streaming access managed through your CAPTaINFiN account.' %></div><ul class="featureList"><li><%= p.streams %> concurrent stream<%= Number(p.streams)===1?'':'s' %></li><li><%= delivery(p) %> delivery</li></ul><div class="planActions"><% if(isCurrent){ %><span class="button secondary full">Current plan</span><% } else { %><% if(p.billing_interval==='trial'){ %><form class="plainForm" method="post" action="/account/trial/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><button class="button primary full">Start free trial</button></form><% } %><% if(isFree){ %><form class="plainForm" method="post" action="/account/claim-free/<%= p.code %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button free full">Get free access</button></form><% } %><% if(Number(p.price_minor)>0&&stripeEnabled&&stripeOpt){ %><form class="plainForm" method="post" action="/account/checkout/stripe"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><button class="button stripe full">Pay / change with Stripe</button></form><% } %><% if(Number(p.price_minor)>0&&paypalEnabled&&paypalOpt){ %><form class="plainForm" method="post" action="/account/checkout/paypal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><button class="button paypal full">Pay / change with PayPal</button></form><% } %><% } %></div></article><% }) %></div></section>
</main></div></body></html>
