<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Benefits · <%= siteName %></title>
  <link rel="icon" href="/branding/favicon">
  <link rel="stylesheet" href="/css/customer-portal.css">
  <link rel="stylesheet" href="/css/customer-navigation.css">
  <script src="/js/customer-referral-copy.js" defer></script>
</head>
<%
function money(minor,c){try{return new Intl.NumberFormat('en-GB',{style:'currency',currency:c,currencyDisplay:'narrowSymbol'}).format(Number(minor||0)/100)}catch(_){return `${c} ${(Number(minor||0)/100).toFixed(2)}`}}
const balances=new Map((state.balances||[]).map(x=>[x.currency,x]));
const selected=balances.get(currency)||{available_minor:0,pending_minor:0};
const available=Number(selected.available_minor||0);
const usdBalance=balances.get('USD')||{available_minor:0,pending_minor:0};
%>
<body><main class="customerPortalPage">
<%- include('_nav',{active:'benefits'}) %>
<div class="customerPortalPageHeader"><div><h1>Benefits</h1><p>Share your referral link and use earned service credit towards CAPTAiNFiN plans.</p></div></div>
<% if(message){ %><div class="notice success"><%= message %></div><% } %>
<% if(error){ %><div class="notice error"><%= error %></div><% } %>
<section class="sectionBlock"><div class="sectionHead"><div><h2>Your referral link</h2><p>Copy this link and send it directly to anyone you want to refer.</p></div></div><div class="panel referralPanel"><div><div class="field"><label for="referral-signup-link">Signup link</label><div class="copyLine"><input class="input" id="referral-signup-link" type="text" readonly value="<%= referralLink %>"><button class="button primary" type="button" data-copy-referral-link>Copy link</button></div></div><div class="accessMeta">Referral code: <strong><%= code %></strong></div></div><div class="accessMeta">Credit becomes available after at least <%= Math.max(settings.qualificationDelayDays,settings.refundWindowDays) %> day(s). A refunded or disputed qualifying purchase can reverse unused credit.</div></div></section>
<section class="overviewGrid">
<article class="metricCard"><div class="metricLabel">Available <%= currency %> credit</div><div class="metricValue"><%= money(available,currency) %></div><div class="metricSub">Ready to use</div></article>
<article class="metricCard"><div class="metricLabel">Pending <%= currency %> credit</div><div class="metricValue"><%= money(selected.pending_minor,currency) %></div><div class="metricSub">Waiting to qualify</div></article>
<article class="metricCard"><div class="metricLabel">Reward rate</div><div class="metricValue"><%= settings.rewardPercent %>%</div><div class="metricSub">Of qualifying referred spend</div></article>
</section>
<section class="sectionBlock"><div class="sectionHead"><div><h2>Your balances</h2><p>Your referral service-credit balance is shown in USD.</p></div></div><div class="overviewGrid"><article class="metricCard"><div class="metricLabel">USD balance</div><div class="metricValue"><%= money(usdBalance.available_minor,'USD') %></div><div class="metricSub"><%= money(usdBalance.pending_minor,'USD') %> pending</div></article></div></section>
<section class="sectionBlock"><div class="sectionHead"><div><h2>Use <%= currency %> service credit</h2><p>Pay fully with credit when your balance covers a plan, or use available credit towards an eligible new checkout.</p></div></div><div class="plansGrid">
<% plans.filter(p=>Number(p.price_minor)>0).forEach(function(p){const cost=Number(p.price_minor||0),canFull=available>=cost,remainder=Math.max(0,cost-available),opts=Array.isArray(p.payment_options)?p.payment_options:[],stripeOpts=opts.filter(o=>o.provider==='stripe'),paypalPayment=opts.find(o=>o.provider==='paypal'&&o.checkoutMode==='payment'); %>
<article class="planCard"><div class="planName"><%= p.name %></div><div class="planPrice"><%= money(cost,p.currency) %></div><div class="planDescription"><%= p.description||'CAPTAiNFiN service plan' %></div>
<% if(canFull){ %>
<form class="plainForm" method="post" action="/account/affiliate/redeem"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input type="hidden" name="currency" value="<%= currency %>"><button class="button primary full" type="submit">Use <%= money(cost,currency) %> service credit</button></form>
<% } else if(available>0){ %>
<div class="accessMeta">Use <strong><%= money(available,currency) %></strong> credit and pay the remaining <strong><%= money(remainder,currency) %></strong>.</div>
<% stripeOpts.forEach(function(opt){ %><form class="plainForm" method="post" action="/account/checkout/stripe"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input type="hidden" name="currency" value="<%= currency %>"><input type="hidden" name="checkoutMode" value="<%= opt.checkoutMode %>"><input type="hidden" name="applyServiceCredit" value="on"><button class="button stripe full" type="submit">Use credit + Stripe</button></form><% }) %>
<% if(paypalPayment){ %><form class="plainForm" method="post" action="/account/checkout/paypal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planCode" value="<%= p.code %>"><input type="hidden" name="currency" value="<%= currency %>"><input type="hidden" name="checkoutMode" value="payment"><input type="hidden" name="applyServiceCredit" value="on"><button class="button paypal full" type="submit">Use credit + PayPal</button></form><% } %>
<% if(!stripeOpts.length&&!paypalPayment){ %><div class="paymentNote">Part-payment is not available for this plan in <%= currency %>.</div><% } %>
<% } else { %><div class="paymentNote">Earn service credit first, or choose this plan from your account home.</div><% } %>
</article><% }) %>
</div><div class="notice">Recurring PayPal subscriptions cannot be part-paid with service credit. Stripe and one-time PayPal payments can use an eligible credit balance safely.</div></section>
</main></body></html>
