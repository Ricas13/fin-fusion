<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Choose a new password · <%= siteName %></title>
  <style>body{margin:0;font-family:system-ui,-apple-system,sans-serif;background:#0b1220;color:#e5e7eb;min-height:100vh;display:grid;place-items:center}.card{width:min(430px,calc(100% - 32px));background:#111827;border:1px solid #263244;border-radius:18px;padding:28px;box-sizing:border-box;box-shadow:0 20px 60px #0006}h1{margin:0 0 8px}.muted{color:#94a3b8;line-height:1.5}.error{background:#451a1a;border:1px solid #7f1d1d;padding:10px 12px;border-radius:10px;margin:16px 0}label{display:block;margin:16px 0 6px}input{width:100%;box-sizing:border-box;padding:12px;border-radius:10px;border:1px solid #334155;background:#0f172a;color:white}button{width:100%;margin-top:20px;padding:12px;border:0;border-radius:10px;font-weight:700;cursor:pointer}a{color:#7dd3fc}</style>
</head>
<body><main class="card"><h1>Choose a new password</h1><p class="muted">Set a new <%= siteName %> portal password. This does not change your Jellyfin password.</p><% if (error) { %><div class="error"><%= error %></div><% } %><form method="post" action="/account/reset-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="<%= token %>"><label>New password</label><input type="password" name="password" minlength="8" maxlength="200" autocomplete="new-password" required><label>Confirm password</label><input type="password" name="confirmPassword" minlength="8" maxlength="200" autocomplete="new-password" required><button type="submit">Update portal password</button></form><p class="muted"><a href="/account/login">Back to sign in</a></p></main></body></html>
