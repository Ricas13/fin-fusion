<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Sign in · <%= siteName %></title>
  <% if (typeof turnstileEnabled !== 'undefined' && turnstileEnabled) { %><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% } %>
  <style>
    body{margin:0;font-family:system-ui,-apple-system,sans-serif;background:#0b1220;color:#e5e7eb;min-height:100vh;display:grid;place-items:center} .card{width:min(420px,calc(100% - 32px));background:#111827;border:1px solid #263244;border-radius:18px;padding:28px;box-sizing:border-box;box-shadow:0 20px 60px #0006} h1{margin:0 0 8px}.muted{color:#94a3b8}.error{background:#451a1a;border:1px solid #7f1d1d;padding:10px 12px;border-radius:10px;margin:16px 0} label{display:block;margin:16px 0 6px}input{width:100%;box-sizing:border-box;padding:12px;border-radius:10px;border:1px solid #334155;background:#0f172a;color:white}button{width:100%;margin-top:20px;padding:12px;border:0;border-radius:10px;font-weight:700;cursor:pointer}a{color:#7dd3fc}.underForm{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:14px;font-size:13px}.captcha{margin-top:18px;display:flex;justify-content:center}
  </style>
</head>
<body><main class="card">
  <h1><%= siteName %></h1><div class="muted">Customer account</div>
  <% if (typeof message !== 'undefined' && message) { %><div class="muted"><%= message %></div><% } %>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="/account/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Email or username</label><input name="identity" autocomplete="username" required>
    <label>Password</label><input type="password" name="password" autocomplete="current-password" required>
    <% if (typeof turnstileEnabled !== 'undefined' && turnstileEnabled) { %><div class="captcha"><div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-action="<%= turnstileAction %>" data-theme="dark"></div></div><% } %>
    <button type="submit">Sign in</button>
  </form>
  <div class="underForm"><a href="/account/forgot-password">Forgot password?</a><span class="muted">New here? <a href="/account/register">Create an account</a></span></div>
  <p class="muted">If you were emailed a claim link for an existing Jellyfin account, use that link instead of registering again.</p>
  <p class="muted"><a href="/login">Admin sign in</a></p>
</main></body></html>
