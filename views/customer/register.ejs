<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Create account · <%= siteName %></title>
  <% if (typeof turnstileEnabled !== 'undefined' && turnstileEnabled) { %><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% } %>
  <style>
    body{margin:0;font-family:system-ui,-apple-system,sans-serif;background:#0b1220;color:#e5e7eb;min-height:100vh;display:grid;place-items:center}.card{width:min(460px,calc(100% - 32px));background:#111827;border:1px solid #263244;border-radius:18px;padding:28px;box-sizing:border-box;box-shadow:0 20px 60px #0006}.muted{color:#94a3b8}.error{background:#451a1a;border:1px solid #7f1d1d;padding:10px 12px;border-radius:10px;margin:16px 0}.notice{background:#172554;border:1px solid #1d4ed8;padding:12px;border-radius:10px}label{display:block;margin:16px 0 6px}input{width:100%;box-sizing:border-box;padding:12px;border-radius:10px;border:1px solid #334155;background:#0f172a;color:white}button{width:100%;margin-top:20px;padding:12px;border:0;border-radius:10px;font-weight:700;cursor:pointer}a{color:#7dd3fc}.captcha{margin-top:18px;display:flex;justify-content:center}
  </style>
</head>
<body><main class="card">
  <h1>Create <%= siteName %> account</h1>
  <% if (!registrationOpen) { %><div class="notice">Public registration is currently closed. Use an invitation link if one was provided to you.</div><% } %>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (registrationOpen) { %>
  <form method="post" action="/account/register">
    <label>Email</label><input type="email" name="email" autocomplete="email" required>
    <label>Username</label><input name="username" minlength="3" maxlength="40" autocomplete="username" required>
    <label>Site password</label><input type="password" name="password" minlength="12" autocomplete="new-password" required>
    <p class="muted">This is your portal password. Your Jellyfin password is managed separately and is never stored here.</p>
    <% if (referralsEnabled) { %><label>Referral code <span class="muted">(optional)</span></label><input name="referralCode" maxlength="20" value="<%= referralCode %>" placeholder="e.g. AB3D9F2K"><% } %>
    <% if (typeof turnstileEnabled !== 'undefined' && turnstileEnabled) { %><div class="captcha"><div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="dark"></div></div><% } %>
    <button type="submit">Create account</button>
  </form>
  <% } %>
  <p class="muted">Already registered? <a href="/account/login">Sign in</a></p>
</main></body></html>
