<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Create account · <%= siteName %></title>
  <% if (typeof turnstileEnabled !== 'undefined' && turnstileEnabled) { %><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% } %>
  <style>
    body{margin:0;font-family:system-ui,-apple-system,sans-serif;background:#0b1220;color:#e5e7eb;min-height:100vh;display:grid;place-items:center;padding:30px 0}.card{width:min(560px,calc(100% - 32px));background:#111827;border:1px solid #263244;border-radius:18px;padding:28px;box-sizing:border-box;box-shadow:0 20px 60px #0006}.muted{color:#94a3b8}.error{background:#451a1a;border:1px solid #7f1d1d;padding:10px 12px;border-radius:10px;margin:16px 0}.notice{background:#172554;border:1px solid #1d4ed8;padding:12px;border-radius:10px;margin:14px 0}.freeHold{background:#123126;border-color:#286847}label{display:block;margin:16px 0 6px}input{width:100%;box-sizing:border-box;padding:12px;border-radius:10px;border:1px solid #334155;background:#0f172a;color:white}button{width:100%;margin-top:20px;padding:12px;border:0;border-radius:10px;font-weight:700;cursor:pointer}a{color:#7dd3fc}.captcha{margin-top:18px;display:flex;justify-content:center}.optional{margin-top:20px;border:1px solid #263244;border-radius:12px;padding:14px;background:#0d1524}.optional summary{cursor:pointer;font-weight:750;color:#cbd5e1}.check{display:flex;align-items:flex-start;gap:9px;margin-top:12px;color:#cbd5e1;font-size:13px}.check input{width:auto;margin-top:2px}.channel{padding:10px 0;border-top:1px solid #243042}.channel:first-of-type{border-top:0}.channel label{margin-top:12px}.mandatory{font-size:12px;color:#86efac;margin-top:8px}.hint{font-size:12px;color:#93a4b7;line-height:1.45;margin:6px 0}
  </style>
</head>
<body><main class="card">
  <% const hasFreeReservation = Boolean(freeIntent && freeReservation && freeReservation.id); %>
  <h1><%= freeIntent ? 'Claim Free Access' : 'Create '+siteName+' account' %></h1>
  <p class="muted"><%= freeIntent ? 'Reserve a Free Access place first, then create your portal account and verify your email before the hold expires.' : 'Your portal account stays yours even when a trial or service access ends. You can return later to renew or choose another plan.' %></p>
  <p class="muted">If you were emailed a claim link for an existing Jellyfin account, use that link instead — do not register again.</p>
  <% if (!registrationOpen) { %><div class="notice">Public registration is currently closed. Sign in if you already have an account, or contact support.</div><% } %>
  <% if (registrationOpen && verificationRequired && (!freeIntent || hasFreeReservation)) { %><div class="notice"><strong>Email verification first.</strong> Your details are held temporarily; the customer account is created only after you confirm the verification link. After verification you are signed in automatically.</div><% } %>
  <% if (registrationOpen && freeIntent && !hasFreeReservation) { %><div class="notice"><strong>Reserve before entering your details.</strong> Opening this page does not consume a place. Press the button below to atomically reserve one available Free Access place for <%= freeHoldMinutes %> minutes. If somebody else gets the last place first, registration will not start.</div><% } %>
  <% if (registrationOpen && freeIntent && hasFreeReservation) { %><div class="notice freeHold"><strong>Your Free Access place is reserved.</strong> This exclusive hold lasts <%= freeHoldMinutes %> minutes and expires at <%= new Date(freeReservation.expires_at).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'}) %>. Complete registration and email verification before then.</div><% } %>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (registrationOpen && freeIntent && !hasFreeReservation) { %>
  <form method="post" action="/account/register">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="freeIntent" value="1">
    <input type="hidden" name="reserveFree" value="1">
    <button type="submit">Reserve / Create Free Account</button>
  </form>
  <% } %>
  <% if (registrationOpen && (!freeIntent || hasFreeReservation)) { %>
  <form method="post" action="/account/register">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="freeIntent" value="<%= freeIntent ? '1' : '0' %>">
    <label>Email</label><input type="email" name="email" autocomplete="email" required>
    <div class="mandatory">Email is always used for account, invoice, registration and important payment messages.</div>
    <label>Username</label><input name="username" minlength="3" maxlength="40" autocomplete="username" required>
    <label>Portal password</label><input type="password" name="password" minlength="8" maxlength="200" autocomplete="new-password" required>
    <p class="muted">This signs you into CAPTAiNFiN. If your plan uses Jellyfin, you set the separate Jellyfin playback password after access is ready.</p>
    <% if (referralsEnabled) { %><label>Referral code <span class="muted">(optional)</span></label><input name="referralCode" maxlength="20" value="<%= referralCode %>" placeholder="e.g. AB3D9F2K"><% } %>
    <details class="optional">
      <summary>Optional messaging preferences</summary>
      <p class="muted">Choose how you would like to receive optional reminders and service updates. These channels never replace email.</p>
      <div class="channel"><strong>WhatsApp</strong><label>WhatsApp mobile number</label><input name="phone" maxlength="32" autocomplete="tel" placeholder="+447700900123"><div class="hint">Use international format including the country code.</div><label class="check"><input type="checkbox" name="whatsappOptIn" value="1"><span>Yes, CAPTAiNFiN may send optional WhatsApp messages to this number.</span></label></div>
      <div class="channel"><strong>Telegram</strong><label class="check"><input type="checkbox" name="telegramOptIn" value="1"><span>I want Telegram bot notifications.</span></label><div class="hint">After your account is created, CAPTAiNFiN will give you a one-click bot link. Press Start in Telegram to securely bind your private chat.</div></div>
      <div class="channel"><strong>Discord</strong><label class="check"><input type="checkbox" name="discordOptIn" value="1"><span>I want Discord bot DMs.</span></label><div class="hint">After account creation, use Connect Discord to authorize your Discord identity.</div></div>
    </details>
    <% if (typeof turnstileEnabled !== 'undefined' && turnstileEnabled) { %><div class="captcha"><div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-action="<%= turnstileAction %>" data-theme="dark"></div></div><% } %>
    <button type="submit"><%= freeIntent ? 'Continue & verify email' : (verificationRequired ? 'Verify email & continue' : 'Create account & continue') %></button>
  </form>
  <% } %>
  <p class="muted">Already registered? <a href="/account/login">Sign in</a></p>
</main></body></html>
