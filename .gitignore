# Environment secrets - NEVER COMMIT
.env
*.env.local
.env.pre-runtime-roles-*.bak
.env.before-*

# Database files - contains user data
db/*
!db/migrations/
!db/migrations/*.sql
*.json
!package*.json

# Encrypted database backups - still sensitive production data
backups/
*.pgdump.enc

# Logs
*.log
npm-debug.log*

# Deployment runtime state
.deploy-production.lock

# Dependencies
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
expired-check-result.txt

# Local Playwright test artifacts (screenshots, traces)
test-results/
